<!-- subpackages/detail/content-detail/content-detail.wxml -->
<view class="page-bg" wx:if="{{detail}}">

  <!-- 封面 -->
  <view class="hero hero--{{domain}}">
    <view class="hero__tag">
      <domain-tag domain="{{domain}}" />
    </view>
    <view class="hero__title">{{detail.title}}</view>
    <view class="hero__meta">
      <!-- 通用字段 -->
      <text wx:if="{{detail.duration}}">{{detail.duration}}</text>
      <text wx:if="{{detail.difficulty}}" class="hero__dot">·</text>
      <text wx:if="{{detail.difficulty}}">难度 {{detail.difficulty}}/5</text>
      <!-- 香道特殊字段 -->
      <text wx:if="{{domain === 'incense' && detail.origin}}" class="hero__dot">·</text>
      <text wx:if="{{domain === 'incense' && detail.origin}}">产地 {{detail.origin}}</text>
      <text wx:if="{{domain === 'incense' && detail.price}}" class="hero__dot">·</text>
      <text wx:if="{{domain === 'incense' && detail.price}}">{{detail.price}}</text>
      <!-- 音乐特殊字段 -->
      <text wx:if="{{domain === 'music' && detail.instrument}}" class="hero__dot">·</text>
      <text wx:if="{{domain === 'music' && detail.instrument}}">{{detail.instrument}}</text>
      <text wx:if="{{domain === 'music' && detail.dynasty}}" class="hero__dot">·</text>
      <text wx:if="{{domain === 'music' && detail.dynasty}}">{{detail.dynasty}}</text>
      <!-- 电影特殊字段 -->
      <text wx:if="{{domain === 'film' && detail.director}}" class="hero__dot">·</text>
      <text wx:if="{{domain === 'film' && detail.director}}">{{detail.director}}</text>
      <text wx:if="{{domain === 'film' && detail.year}}" class="hero__dot">·</text>
      <text wx:if="{{domain === 'film' && detail.year}}">{{detail.year}}</text>
    </view>
  </view>

  <view
    wx:if="{{domain === 'wellness' || domain === 'incense'}}"
    class="content-safety-note"
  >
    <text wx:if="{{domain === 'wellness'}}">
      本页为一般生活方式信息，不构成医疗建议，也不能替代诊断、药物或治疗；持续或明显不适请及时就医。
    </text>
    <text wx:if="{{domain === 'incense'}}">
      本页介绍香材文化与嗅觉体验，不宣称医疗功效。燃烧香品请保持通风、远离可燃物，并全程看护火源。
    </text>
  </view>

  <!-- 音乐播放器（仅音乐板块显示） -->
  <view wx:if="{{domain === 'music'}}" class="section-title">聆听</view>
  <audio-player 
    wx:if="{{domain === 'music'}}"
    src="{{detail.audioSrc}}" 
    title="{{detail.title}}"
    playlist="{{musicPlaylist}}"
    currentIndex="{{musicPlaylistIndex}}"
    trackId="{{detail.id}}"
    bind:trackchange="onTrackChange"
  />
  <view
    wx:if="{{domain === 'music' && detail.audioLicense}}"
    class="audio-license"
  >
    <view class="audio-license__header">
      <text class="audio-license__title">音频来源与许可</text>
      <text class="audio-license__copy" bindtap="onCopyAudioLicense">复制信息</text>
    </view>
    <text class="audio-license__line">演奏：{{detail.audioLicense.performer}}</text>
    <text wx:if="{{detail.audioLicense.recorder}}" class="audio-license__line">录制：{{detail.audioLicense.recorder}}</text>
    <text class="audio-license__line">来源：{{detail.audioLicense.sourceName}}</text>
    <text class="audio-license__line">许可：{{detail.audioLicense.licenseName}}</text>
    <text class="audio-license__note">{{detail.audioLicense.changeNote}}</text>
  </view>

  <!-- 正文 -->
  <view class="section-title">正文</view>
  <view class="card">
    <!-- 优先显示bodyHtml，如果没有则显示body -->
    <block wx:if="{{detail.bodyHtml}}">
      <block wx:for="{{detail.bodyHtml}}" wx:key="index">
        <text wx:if="{{item.type === 'paragraph'}}" class="paragraph">{{item.text}}</text>
        <view wx:elif="{{item.type === 'image'}}" class="body-image">
          <image src="{{item.url}}" mode="widthFix" lazy-load="{{true}}" />
          <text wx:if="{{item.caption}}" class="body-image__caption">{{item.caption}}</text>
        </view>
        <view wx:elif="{{item.type === 'quote'}}" class="quote">
          <text>{{item.text}}</text>
        </view>
      </block>
    </block>
    <text wx:else class="paragraph">{{detail.body}}</text>
  </view>

  <!-- 执行小贴士 -->
  <view class="section-title" wx:if="{{detail.tips && detail.tips.length}}">小贴士</view>
  <view class="card" wx:if="{{detail.tips && detail.tips.length}}">
    <view
      wx:for="{{detail.tips}}"
      wx:key="index"
      class="tip"
    >
      <view class="tip__dot"></view>
      <text class="tip__text">{{item}}</text>
    </view>
  </view>

  <!-- 香道计时器入口（仅香道板块显示） -->
  <view class="incense-timer-entry" wx:if="{{domain === 'incense'}}">
    <view class="incense-timer-entry__btn" bindtap="onOpenIncenseTimer">
      <text class="incense-timer-entry__icon">🕯</text>
      <text class="incense-timer-entry__text">开始焚香计时</text>
    </view>
  </view>

  <!-- 禁忌提醒 -->
  <view class="section-title" wx:if="{{detail.contraindication}}">提醒</view>
  <view class="card warn" wx:if="{{detail.contraindication}}">
    <text class="warn__text">{{detail.contraindication}}</text>
  </view>

  <!-- 关联茶品 -->
  <view class="section-title" wx:if="{{linkedTeas.length}}">关联茶品</view>
  <view class="linked" wx:if="{{linkedTeas.length}}">
    <view
      wx:for="{{linkedTeas}}"
      wx:key="refId"
      class="linked__item"
      data-id="{{item.refId}}"
      bindtap="onTeaTap"
    >
      <view class="linked__cover" style="background-color:#3B6D11;">
        <text class="linked__cover-text">茶</text>
      </view>
      <view class="linked__body">
        <text class="linked__name ellipsis">{{item.name}}</text>
        <text class="linked__context">{{item.context}}</text>
      </view>
      <text class="linked__arrow">›</text>
    </view>
  </view>

  <!-- 关联行旅 -->
  <view class="section-title" wx:if="{{relatedTravel.length}}">去实践一下</view>
  <view class="linked" wx:if="{{relatedTravel.length}}">
    <view
      wx:for="{{relatedTravel}}"
      wx:key="id"
      class="linked__item"
      data-id="{{item.id || item.contentNo}}"
      bindtap="onTravelTap"
    >
      <view class="linked__cover" style="background-color:#5B8C85;">
        <text class="linked__cover-text">游</text>
      </view>
      <view class="linked__body">
        <text class="linked__name ellipsis-2">{{item.title}}</text>
        <text class="linked__context">{{item.linkContext}}</text>
      </view>
      <text class="linked__arrow">›</text>
    </view>
  </view>

  <view class="bottom-placeholder"></view>

  <!-- 我的笔记 -->
  <view class="section-title">我的笔记</view>
  <view class="note-section">
    <block wx:if="{{note}}">
      <view class="note-card">
        <text class="note-card__content">{{note.content}}</text>
        <view class="note-card__footer">
          <text class="note-card__time">最后编辑：{{noteEditTime}}</text>
          <view class="note-card__actions">
            <text class="note-card__btn" bindtap="onOpenNoteInput">编辑</text>
            <text class="note-card__btn note-card__btn--delete" bindtap="onDeleteNote">删除</text>
          </view>
        </view>
      </view>
    </block>
    <block wx:else>
      <view class="note-empty" bindtap="onOpenNoteInput">
        <text class="note-empty__icon">✎</text>
        <text class="note-empty__text">写一条笔记，记录你的品读心得</text>
      </view>
    </block>
  </view>

  <view style="height:120rpx;"></view>

  <!-- 底部操作栏 -->
  <view class="action-bar safe-bottom">
    <view class="action-bar__collect {{isCollected ? 'action-bar__collect--active' : ''}}" bindtap="onToggleCollect">
      <text>{{isCollected ? '已收藏' : '收藏'}}</text>
    </view>
    <view class="action-bar__poster" bindtap="onGeneratePoster">
      <text>{{generatingPoster ? '生成中...' : '海报'}}</text>
    </view>
    <button class="action-bar__share" open-type="share">分享</button>
  </view>

  <!-- 隐藏的海报 canvas -->
  <canvas type="2d" id="posterCanvas" style="position:fixed;left:-9999px;width:600px;height:900px;" />

  <!-- 香道计时器浮层 -->
  <view class="incense-timer {{showIncenseTimer && !incenseTimerMinimized ? 'incense-timer--show' : ''}}">
    <view class="incense-timer__mask" bindtap="onMinimizeIncenseTimer"></view>
    <view class="incense-timer__panel">
      <view class="incense-timer__header">
        <text class="incense-timer__title">焚香计时</text>
        <view class="incense-timer__header-btns">
          <view class="incense-timer__minimize" bindtap="onMinimizeIncenseTimer">
            <text>—</text>
          </view>
          <view class="incense-timer__close" bindtap="onCloseIncenseTimer">
            <text>✕</text>
          </view>
        </view>
      </view>

      <!-- 时长选择 -->
      <view class="incense-timer__options" wx:if="{{!incenseRunning && !incenseFinished}}">
        <view
          wx:for="{{incenseTimeOptions}}"
          wx:key="*this"
          class="incense-timer__option {{item === incenseSelectedMin ? 'incense-timer__option--active' : ''}}"
          data-min="{{item}}"
          bindtap="onSelectIncenseMin"
        >
          <text>{{item}} 分钟</text>
        </view>
      </view>

      <!-- 计时器主体 -->
      <view class="incense-timer__body">
        <view class="incense-timer__smoke">{{incenseFinished ? '✓' : '🕯'}}</view>
        <text class="incense-timer__time">{{incenseDisplayTime}}</text>
        <text class="incense-timer__status">{{incenseFinished ? '香已燃尽' : incenseRunning ? '焚香中...' : '准备点香'}}</text>
        <view class="incense-timer__progress-bar">
          <view class="incense-timer__progress-fill" style="width: {{incenseProgress}}%;"></view>
        </view>
      </view>

      <!-- 操作按钮 -->
      <view class="incense-timer__actions">
        <block wx:if="{{incenseFinished}}">
          <view class="incense-timer__btn incense-timer__btn--reset" bindtap="onResetIncenseTimer">
            <text>重新计时</text>
          </view>
        </block>
        <block wx:else>
          <view class="incense-timer__btn incense-timer__btn--reset" bindtap="onResetIncenseTimer">
            <text>重置</text>
          </view>
          <view class="incense-timer__btn {{incenseRunning ? 'incense-timer__btn--pause' : 'incense-timer__btn--start'}}" bindtap="onToggleIncenseTimer">
            <text>{{incenseRunning ? '暂停' : '开始'}}</text>
          </view>
        </block>
      </view>
    </view>
  </view>

  <!-- 最小化后的浮动计时器 -->
  <view class="incense-float {{showIncenseTimer && incenseTimerMinimized ? 'incense-float--show' : ''}}" bindtap="onRestoreIncenseTimer">
    <text class="incense-float__icon">🕯</text>
    <view class="incense-float__info">
      <text class="incense-float__time">{{incenseDisplayTime}}</text>
      <text class="incense-float__status">{{incenseFinished ? '已燃尽' : incenseRunning ? '焚香中' : '已暂停'}}</text>
    </view>
    <view class="incense-float__progress">
      <view class="incense-float__progress-fill" style="width: {{incenseProgress}}%;"></view>
    </view>
  </view>

  <!-- 笔记编辑弹层 -->
  <view class="note-input {{showNoteInput ? 'note-input--show' : ''}}">
    <view class="note-input__mask" bindtap="onCloseNoteInput"></view>
    <view class="note-input__panel">
      <view class="note-input__header">
        <text class="note-input__title">{{note ? '编辑笔记' : '写笔记'}}</text>
        <view class="note-input__close" bindtap="onCloseNoteInput">
          <text>✕</text>
        </view>
      </view>
      <textarea
        class="note-input__textarea"
        placeholder="记录你此刻的品读心得、灵感或感悟..."
        value="{{noteText}}"
        bindinput="onNoteInput"
        maxlength="500"
        auto-height
        focus="{{showNoteInput}}"
      />
      <view class="note-input__footer">
        <text class="note-input__count">{{noteText.length}}/500</text>
        <view class="note-input__save" bindtap="onSaveNote">
          <text>保存</text>
        </view>
      </view>
    </view>
  </view>
</view>

<view wx:else class="page-bg">
  <view class="skeleton-detail__hero skeleton-pulse"></view>
  <view class="skeleton-detail__card skeleton-pulse"></view>
  <view class="skeleton-detail__card skeleton-pulse"></view>
</view>
