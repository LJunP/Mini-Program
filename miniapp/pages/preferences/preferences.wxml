<!-- pages/preferences/preferences.wxml -->
<view class="page-bg">
  <view class="intro-section">
    <text class="intro-title">风雅偏好设置</text>
    <text class="intro-desc">调整您对六雅的偏好程度，系统将为您推荐更符合品味的内容</text>
  </view>
  
  <view class="preferences-list">
    <view class="preference-item" wx:for="{{preferences}}" wx:key="key">
      <view class="preference-header">
        <view class="preference-info">
          <text class="preference-name">{{item.name}}</text>
          <text class="preference-desc">{{item.description}}</text>
        </view>
        <text class="preference-value">{{item.value}}%</text>
      </view>
      
      <slider 
        min="0" 
        max="100" 
        step="5" 
        value="{{item.value}}" 
        activeColor="{{item.color}}"
        backgroundColor="#EAE5DC"
        block-size="24"
        block-color="{{item.color}}"
        data-key="{{item.key}}"
        bindchanging="onSliderChanging"
        bindchange="onSliderChange"
      />
      
      <view class="preference-tags">
        <view 
          wx:for="{{item.tags}}" 
          wx:for-item="tag" 
          wx:key="index" 
          class="preference-tag"
          style="background-color: {{item.color}}20; color: {{item.color}}"
        >
          {{tag}}
        </view>
      </view>
    </view>
  </view>
  
  <view class="reset-section">
    <button class="reset-btn" bindtap="onResetPreferences">重置为默认值</button>
    <button class="save-btn" bindtap="onSavePreferences">保存偏好</button>
  </view>
  
  <view class="tip-section">
    <text class="tip-title">小贴士</text>
    <text class="tip-content">• 偏好设置会影响首页推荐和个性化内容\n• 您可以随时调整偏好，系统会实时更新推荐\n• 偏好数据仅存储在本地，不会上传至服务器</text>
  </view>
</view>