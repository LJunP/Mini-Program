/* subpackages/detail/question-detail/question-detail.wxss */
.hero {
  padding: 64rpx 32rpx 56rpx;
  background: linear-gradient(135deg, #854F0B 0%, #2C2C2A 100%);
  color: #FFFFFF;
  border-radius: 0 0 20rpx 20rpx;
}
.hero__tag {
  display: inline-block;
  padding: 6rpx 18rpx;
  background-color: rgba(255, 255, 255, 0.18);
  border-radius: 999rpx;
  font-size: 22rpx;
}
.hero__title {
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.5;
  margin-top: 24rpx;
}
.hero__meta {
  margin-top: 20rpx;
  font-size: 24rpx;
  opacity: 0.86;
}
.hero__dot {
  margin: 0 12rpx;
}
.hero__progress {
  display: inline-block;
  margin-top: 24rpx;
  padding: 8rpx 18rpx;
  background-color: rgba(255, 255, 255, 0.14);
  border-radius: 999rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
}
.progress-card {
  padding: 24rpx;
}
.status-actions {
  display: flex;
  gap: 12rpx;
}
.status-action {
  flex: 1;
  height: 68rpx;
  border-radius: 999rpx;
  background-color: #F4F0E8;
  color: #8B8578;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}
.status-action--active {
  background-color: rgba(133, 79, 11, 0.12);
  color: #854F0B;
  font-weight: 500;
}
.wrong-action {
  margin-top: 16rpx;
  height: 72rpx;
  border-radius: 999rpx;
  background-color: rgba(160, 82, 45, 0.1);
  color: #A0522D;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}
.question-card {
  background-color: #FFFDFC;
}
.question-text {
  display: block;
  color: #2C2C2A;
  font-size: 32rpx;
  line-height: 1.8;
  font-weight: 500;
}
.answer-toggle {
  margin: 28rpx 0 8rpx;
  height: 84rpx;
  border-radius: 999rpx;
  background-color: #854F0B;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  letter-spacing: 4rpx;
}
.short-answer,
.deep-dive {
  display: block;
  color: #2C2C2A;
  font-size: 28rpx;
  line-height: 1.9;
}
.thinking-process-card {
  border-left: 3px solid #854F0B;
  background-color: #FAF6EEFC;
}
.thinking-process {
  display: block;
  color: #5C5245;
  font-size: 27rpx;
  line-height: 1.8;
  white-space: pre-wrap;
}
.answer-step {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}
.answer-step:last-child {
  margin-bottom: 0;
}
.answer-step__index {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background-color: rgba(133, 79, 11, 0.1);
  color: #854F0B;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}
.answer-step__text {
  flex: 1;
  color: #5A554C;
  font-size: 26rpx;
  line-height: 1.8;
}
.key-point {
  display: inline-block;
  padding: 6rpx 16rpx;
  background-color: rgba(133, 79, 11, 0.08);
  color: #854F0B;
  border-radius: 4px;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
  font-size: 22rpx;
}
.traps {
  background-color: rgba(160, 82, 45, 0.06);
  border-color: rgba(160, 82, 45, 0.18);
}
.trap {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}
.trap:last-child {
  margin-bottom: 0;
}
.trap__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #A0522D;
  margin: 16rpx 18rpx 0 0;
  flex-shrink: 0;
}
.trap__text {
  flex: 1;
  color: #8B5A2B;
  font-size: 26rpx;
  line-height: 1.8;
}
.action-bar__read {
  background-color: #F3EFE6;
  color: #4A6B7C;
}
.action-bar__read--active {
  background-color: #4A6B7C;
  color: #FFFFFF;
}

/* TTS 朗读状态条 */
.reading-bar {
  position: fixed;
  left: 16rpx;
  right: 16rpx;
  bottom: 120rpx;
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  background-color: #4A6B7C;
  border-radius: 12px;
  z-index: 10;
  box-shadow: 0 4rpx 16rpx rgba(74, 107, 124, 0.3);
}
.reading-bar__pulse {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #FFFFFF;
  margin-right: 16rpx;
  animation: pulse 1s infinite;
}
.reading-bar__pulse--loading {
  animation: pulse 0.5s infinite;
  background-color: #FFD700;
}
@keyframes pulse {
  0% { opacity: 1; }
  50% { opacity: 0.3; }
  100% { opacity: 1; }
}
.reading-bar__text {
  flex: 1;
  font-size: 24rpx;
  color: #FFFFFF;
}
.reading-bar__stop {
  padding: 6rpx 20rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 12px;
  font-size: 22rpx;
  color: #FFFFFF;
}

.bottom-placeholder {
  height: 120rpx;
}
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  padding: 16rpx 24rpx;
  background-color: #FFFFFFFC;
  border-top: 0.5px solid #EAE5DC;
  z-index: 10;
}
.action-bar__collect,
.action-bar__copy,
.action-bar__read,
.action-bar__poster,
.action-bar__share {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  border-radius: 40px;
  margin: 0 4rpx;
  letter-spacing: 2rpx;
}
.action-bar__collect {
  background-color: #F3EFE6;
  color: #5A554C;
}
.action-bar__collect--active {
  background-color: #854F0B;
  color: #FFFFFF;
}
.action-bar__share {
  background-color: #2C2C2A;
  color: #FFFFFF;
  padding: 0;
  border: none;
  line-height: 80rpx;
}
.action-bar__share::after {
  border: none;
}

/* 复制按钮 */
.action-bar__copy {
  background-color: #F4F0E8;
  color: #854F0B;
}
.copy-btn {
  margin: 16rpx 0 24rpx;
  height: 72rpx;
  border-radius: 999rpx;
  background-color: rgba(133, 79, 11, 0.08);
  color: #854F0B;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  letter-spacing: 2rpx;
}
.loading {
  padding: 200rpx 0;
  color: #8B8578;
  text-align: center;
}

/* 海报按钮 */
.action-bar__poster {
  background-color: #F4F0E8;
  color: #3B6D11;
}

/* 隐藏 Canvas */
.poster-canvas {
  position: fixed;
  left: -9999rpx;
  top: 0;
  width: 600px;
  height: 1000px;
}