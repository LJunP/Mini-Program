/* pages/bookmark/bookmark.wxss */
.page-header {
  padding: 32rpx 16rpx 24rpx;
}
.page-header__title {
  font-size: 44rpx;
  font-weight: 500;
  color: #2C2C2A;
  letter-spacing: 8rpx;
}
.page-header__sub {
  display: block;
  font-size: 24rpx;
  color: #8B8578;
  margin-top: 8rpx;
  letter-spacing: 4rpx;
}

/* tabs */
.tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 16rpx 0 24rpx;
  border-bottom: 0.5px solid #EAE5DC;
}
.tabs__item {
  min-width: 84rpx;
  text-align: center;
  padding: 12rpx 0;
  font-size: 24rpx;
  color: #8B8578;
  letter-spacing: 2rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tabs__item--active {
  color: #3B6D11;
  font-weight: 500;
}
.tabs__item--active::after {
  content: "";
  position: absolute;
  bottom: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 32rpx;
  height: 4rpx;
  background-color: #3B6D11;
  border-radius: 2px;
}

/* 分组 */
.group {
  margin-top: 32rpx;
}
.group__header {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}
.group__tag {
  min-width: 44rpx;
  height: 44rpx;
  border-radius: 999rpx;
  color: #FFFFFF;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 12rpx;
  line-height: 1;
}
.group__tag text {
  line-height: 1;
}
.group__name {
  font-size: 30rpx;
  font-weight: 500;
  color: #2C2C2A;
  margin-left: 16rpx;
  letter-spacing: 4rpx;
}
.group__count {
  margin-left: auto;
  font-size: 24rpx;
  color: #8B8578;
}

/* 收藏项 */
.bm-item {
  display: flex;
  align-items: center;
  background-color: #FFFFFFFC;
  border: 0.5px solid #EAE5DC;
  border-radius: 12px;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}
.bm-item__cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8px;
  margin-right: 24rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background-color: #3B6D11;
}
.bm-item__cover-text {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 500;
  letter-spacing: 2rpx;
  padding: 8rpx;
  text-align: center;
  max-width: 104rpx;
  word-break: break-all;
  overflow: hidden;
  line-height: 1.3;
}
.bm-item__body {
  flex: 1;
  min-width: 0;
}
.bm-item__name {
  font-size: 28rpx;
  color: #2C2C2A;
  line-height: 1.5;
  display: block;
}
.bm-item__note {
  font-size: 24rpx;
  color: #8B8578;
  margin-top: 8rpx;
  display: block;
}
.bm-item__time {
  font-size: 20rpx;
  color: #B5B0A6;
  margin-top: 8rpx;
  display: block;
}
.bm-item__del {
  padding: 16rpx;
  font-size: 24rpx;
  color: #B5B0A6;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 搜索栏 */
.bm-search {
  padding: 0 32rpx 16rpx;
}
.bm-search__box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background-color: #FFFFFF;
  border-radius: 32rpx;
  border: 0.5px solid #EAE5DC;
}
.bm-search__icon {
  font-size: 32rpx;
  color: #B5B0A6;
}
.bm-search__input {
  flex: 1;
  font-size: 26rpx;
  color: #2C2C2A;
}
.bm-search__clear {
  font-size: 36rpx;
  color: #B5B0A6;
  padding: 0 8rpx;
}

/* 搜索结果 */
.search-results {
  padding: 0 32rpx;
}
.search-results__count {
  padding: 16rpx 0;
  font-size: 24rpx;
  color: #8B8578;
}

/* 内容预览 */
.bm-item__preview {
  font-size: 22rpx;
  color: #8B8578;
  margin-top: 8rpx;
  display: block;
  line-height: 1.5;
}
.bm-item__tag-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.bm-item__domain {
  font-size: 18rpx;
  color: #FFFFFF;
  background-color: #8B8578;
  padding: 4rpx 8rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

/* 排序按钮 */
.tabs__sort {
  margin-left: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #8B8578;
  padding-right: 32rpx;
  flex-shrink: 0;
}
.tabs__sort-icon {
  font-size: 20rpx;
  transition: transform 0.3s ease;
}
.tabs__sort-icon--active {
  transform: rotate(180deg);
}

/* 排序面板 */
.sort-panel {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
  background: #FFFFFF;
  margin: 0 32rpx;
  border-radius: 12rpx;
  border: 0.5px solid #EAE5DC;
}
.sort-panel--show {
  max-height: 200rpx;
  margin-bottom: 16rpx;
}
.sort-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 24rpx;
}
.sort-option {
  background: #F1EFE8;
  border-radius: 8rpx;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  color: #5F5E5A;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sort-option--active {
  background: #3B6D11;
  color: #FFFFFF;
}
