<!-- subpackages/detail/travel-detail/travel-detail.wxml -->
<view class="page-bg" wx:if="{{travel}}">

  <!-- 封面 -->
  <view class="hero" style="background-color:#5B8C85;">
    <view class="hero__dest">{{travel.destination.name}}</view>
    <view class="hero__title">{{travel.title}}</view>
    <view class="hero__meta">
      <text>{{travel.destination.region}}</text>
      <text class="hero__dot">·</text>
      <text>{{travel.duration}}</text>
      <text class="hero__dot">·</text>
      <text>慢行</text>
    </view>
  </view>

  <!-- 目的地档案 -->
  <view class="section-title">目的地档案</view>
  <view class="card">
    <view class="archive">
      <view class="archive__item">
        <text class="archive__label">历史</text>
        <text class="archive__text">{{travel.destination.history}}</text>
      </view>
      <view class="archive__divider"></view>
      <view class="archive__item">
        <text class="archive__label">人文</text>
        <text class="archive__text">{{travel.destination.culture}}</text>
      </view>
    </view>
  </view>

  <!-- 行旅随笔 -->
  <view class="section-title">行旅随笔</view>
  <view class="card">
    <text class="essay">{{travel.essay}}</text>
  </view>

  <!-- 游玩路线 -->
  <view class="section-title">风雅路线</view>
  <view class="route">
    <view
      wx:for="{{travel.route}}"
      wx:key="day"
      class="route__day"
    >
      <view class="route__header">
        <view class="route__badge">Day {{item.day}}</view>
        <text class="route__title">{{item.title}}</text>
      </view>
      <view class="route__spots">
        <view
          wx:for="{{item.spots}}"
          wx:key="name"
          wx:for-item="spot"
          class="spot"
        >
          <view class="spot__dot"></view>
          <view class="spot__body">
            <text class="spot__name">{{spot.name}}</text>
            <text class="spot__desc">{{spot.desc}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 本行程涉及的风雅 -->
  <view class="section-title" wx:if="{{linkedItems.length}}">本行程涉及的风雅</view>
  <view class="linked" wx:if="{{linkedItems.length}}">
    <view
      wx:for="{{linkedItems}}"
      wx:key="refId"
      class="linked__item"
      data-domain="{{item.domain}}"
      data-ref-id="{{item.refId}}"
      bindtap="onLinkedTap"
    >
      <view class="linked__cover" style="background-color:{{item.coverColor}};">
        <text class="linked__cover-text">{{item.coverText}}</text>
      </view>
      <view class="linked__body">
        <view class="linked__header">
          <domain-tag domain="{{item.domain}}" size="small" />
          <text class="linked__name ellipsis">{{item.name}}</text>
        </view>
        <text class="linked__context">{{item.context}}</text>
      </view>
      <text class="linked__arrow">›</text>
    </view>
  </view>

  <view class="bottom-placeholder"></view>

  <!-- 底部操作栏 -->
  <view class="action-bar safe-bottom">
    <view class="action-bar__collect {{isCollected ? 'action-bar__collect--active' : ''}}" bindtap="onToggleCollect">
      <text>{{isCollected ? '已收藏' : '收藏'}}</text>
    </view>
    <button class="action-bar__share" open-type="share">分享</button>
  </view>
</view>

<view wx:else class="loading">载入中...</view>
