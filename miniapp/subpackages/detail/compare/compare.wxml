<!-- subpackages/detail/compare/compare.wxml -->
<view class="page-bg">

  <!-- 对比头部：两款茶品并排 -->
  <view class="compare-header">
    <view class="compare-header__tea" bindtap="onTeaATap">
      <view class="compare-header__cover" style="background-color:#3B6D11;">
        <text class="compare-header__cover-text">{{teaA.categoryName}}</text>
      </view>
      <text class="compare-header__name">{{teaA.name || '待选择'}}</text>
      <text class="compare-header__origin">{{teaA.origin || ''}}</text>
      <view class="compare-header__score">
        <text class="compare-header__score-num">{{teaA.ratingSource === 'verified' && teaA.ratingCount > 0 ? teaA.ratingAvg : '—'}}</text>
        <text class="compare-header__score-label">评分</text>
      </view>
    </view>

    <view class="compare-header__vs">
      <text class="compare-header__vs-text">VS</text>
    </view>

    <view class="compare-header__tea" bindtap="onTeaBTap">
      <view class="compare-header__cover" style="background-color:#5B8C85;">
        <text class="compare-header__cover-text">{{teaB.categoryName}}</text>
      </view>
      <text class="compare-header__name">{{teaB.name || '待选择'}}</text>
      <text class="compare-header__origin">{{teaB.origin || ''}}</text>
      <view class="compare-header__score">
        <text class="compare-header__score-num">{{teaB.ratingSource === 'verified' && teaB.ratingCount > 0 ? teaB.ratingAvg : '—'}}</text>
        <text class="compare-header__score-label">评分</text>
      </view>
    </view>
  </view>

  <!-- 口感雷达图对比 -->
  <view class="section-title">口感对比</view>
  <view class="card radar-compare">
    <view class="radar-compare__item">
      <radar-chart data="{{teaA.tasteProfile}}" size="{{220}}" />
      <text class="radar-compare__label">{{teaA.name}}</text>
    </view>
    <view class="radar-compare__divider"></view>
    <view class="radar-compare__item">
      <radar-chart data="{{teaB.tasteProfile}}" size="{{220}}" />
      <text class="radar-compare__label">{{teaB.name}}</text>
    </view>
  </view>

  <!-- 五维分数对比条 -->
  <view class="section-title">五维详情</view>
  <view class="card">
    <view wx:for="{{dimensions}}" wx:key="key" class="dim-row">
      <view class="dim-row__header">
        <text class="dim-row__label">{{item.label}}</text>
      </view>
      <view class="dim-row__bars">
        <view class="dim-row__bar-wrap dim-row__bar-wrap--a">
          <view class="dim-row__bar dim-row__bar--a" style="width:{{(teaA.tasteProfile[item.key] || 0) * 10}}%;"></view>
          <text class="dim-row__val dim-row__val--a">{{teaA.tasteProfile[item.key] || '—'}}</text>
        </view>
        <view class="dim-row__bar-wrap dim-row__bar-wrap--b">
          <view class="dim-row__bar dim-row__bar--b" style="width:{{(teaB.tasteProfile[item.key] || 0) * 10}}%;"></view>
          <text class="dim-row__val dim-row__val--b">{{teaB.tasteProfile[item.key] || '—'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 核心参数对比 -->
  <view class="section-title">冲泡对比</view>
  <view class="card params-compare">
    <view class="params-compare__row">
      <text class="params-compare__label">水温</text>
      <text class="params-compare__val">{{teaA.brewing.temperature || '—'}}℃</text>
      <text class="params-compare__val">{{teaB.brewing.temperature || '—'}}℃</text>
    </view>
    <view class="params-compare__row">
      <text class="params-compare__label">投茶</text>
      <text class="params-compare__val">{{teaA.brewing.dosage || '—'}}g</text>
      <text class="params-compare__val">{{teaB.brewing.dosage || '—'}}g</text>
    </view>
    <view class="params-compare__row">
      <text class="params-compare__label">首泡</text>
      <text class="params-compare__val">{{teaA.brewing.firstSteep || '—'}}s</text>
      <text class="params-compare__val">{{teaB.brewing.firstSteep || '—'}}s</text>
    </view>
    <view class="params-compare__row">
      <text class="params-compare__label">器具</text>
      <text class="params-compare__val">{{teaA.brewing.vessel || '—'}}</text>
      <text class="params-compare__val">{{teaB.brewing.vessel || '—'}}</text>
    </view>
    <view class="params-compare__row">
      <text class="params-compare__label">耐泡</text>
      <text class="params-compare__val">{{teaA.brewing.maxSteeps || '—'}} 泡</text>
      <text class="params-compare__val">{{teaB.brewing.maxSteeps || '—'}} 泡</text>
    </view>
  </view>

  <!-- 综合评分 -->
  <view class="section-title">综合口感分</view>
  <view class="card total-score">
    <view class="total-score__item">
      <text class="total-score__tea">{{teaA.name || '—'}}</text>
      <text class="total-score__num" style="color:#3B6D11;">{{teaA.totalScore || '—'}}</text>
    </view>
    <view class="total-score__divider"></view>
    <view class="total-score__item">
      <text class="total-score__tea">{{teaB.name || '—'}}</text>
      <text class="total-score__num" style="color:#5B8C85;">{{teaB.totalScore || '—'}}</text>
    </view>
  </view>

</view>
