/* pages/contribute/list.wxss */

.list-page {
  padding: 0 0 120rpx;
}

/* 统计概览 */
.stats-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background-color: #FFFFFFFC;
  border: 0.5px solid #EAE5DC;
  border-radius: 12px;
  margin: 24rpx;
  padding: 28rpx 0;
}
.stats-bar__item {
  text-align: center;
}
.stats-bar__num {
  display: block;
  font-size: 40rpx;
  font-weight: 500;
  color: #3B6D11;
}
.stats-bar__label {
  display: block;
  font-size: 22rpx;
  color: #8B8578;
  margin-top: 4rpx;
}
.stats-bar__divider {
  width: 0.5px;
  height: 48rpx;
  background-color: #EAE5DC;
}

/* 筛选条 */
.filter-bar {
  white-space: nowrap;
  padding: 0 24rpx 16rpx;
}
.filter-chip {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 24rpx;
  background-color: #FFFFFFFC;
  border: 1rpx solid #EAE5DC;
  border-radius: 32rpx;
  margin-right: 12rpx;
  font-size: 24rpx;
  color: #8B8578;
}
.filter-chip--active {
  background-color: #3B6D11;
  border-color: #3B6D11;
  color: #FFFFFF;
}
.filter-chip__count {
  font-size: 20rpx;
  opacity: 0.7;
}

/* 投稿卡片 */
.post-list {
  padding: 0 24rpx;
}
.post-card {
  background-color: #FFFFFFFC;
  border: 0.5px solid #EAE5DC;
  border-radius: 12px;
  margin-bottom: 20rpx;
  overflow: hidden;
}
.post-card__images {
  position: relative;
  width: 100%;
  height: 320rpx;
}
.post-card__cover {
  width: 100%;
  height: 100%;
}
.post-card__image-count {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  background-color: rgba(0, 0, 0, 0.5);
  color: #FFFFFF;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}
.post-card__body {
  padding: 24rpx;
}
.post-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.post-card__date {
  font-size: 22rpx;
  color: #B5B0A6;
}
.post-card__title {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: #2C2C2A;
  margin-bottom: 8rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.post-card__content {
  display: block;
  font-size: 26rpx;
  color: #5A554C;
  line-height: 1.6;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.post-card__rating {
  margin-bottom: 12rpx;
}
.post-card__stars {
  font-size: 28rpx;
  color: #D4A943;
  letter-spacing: 2rpx;
}
.post-card__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 12rpx;
}
.post-card__tag {
  font-size: 22rpx;
  color: #8B8578;
  background-color: rgba(139, 133, 120, 0.08);
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}
.post-card__location {
  display: flex;
  align-items: center;
  gap: 4rpx;
}
.post-card__location-icon {
  font-size: 22rpx;
}
.post-card__location-text {
  font-size: 22rpx;
  color: #8B8578;
}

/* 操作区 */
.post-card__actions {
  display: flex;
  border-top: 0.5px solid #EAE5DC;
}
.post-card__action {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 26rpx;
  color: #3B6D11;
}
.post-card__action--delete {
  color: #A0522D;
}
.post-card__action-divider {
  width: 0.5px;
  background-color: #EAE5DC;
}

/* 关联内容 */
.post-card__linked {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
  padding: 8rpx 16rpx;
  background-color: rgba(59, 109, 17, 0.04);
  border-radius: 8rpx;
}
.post-card__linked-icon {
  font-size: 24rpx;
}
.post-card__linked-text {
  font-size: 24rpx;
  color: #3B6D11;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 空状态 */
.empty-wrap {
  padding: 80rpx 24rpx;
}

/* FAB 新建按钮 */
.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  width: 100rpx;
  height: 100rpx;
  background-color: #3B6D11;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(59, 109, 17, 0.3);
}
.fab-btn__icon {
  font-size: 56rpx;
  color: #FFFFFF;
  line-height: 1;
}

/* === 顶部 Tab === */
.top-tabs {
  display: flex;
  padding: 16rpx 24rpx;
  gap: 16rpx;
}
.top-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #8B8578;
  border-radius: 12px;
  background-color: #FFFFFFFC;
  border: 0.5px solid #EAE5DC;
  transition: all 0.2s ease;
}
.top-tab--active {
  background: linear-gradient(135deg, #3B6D11, #5A8F2E);
  color: #FFFFFF;
  border-color: transparent;
  font-weight: 500;
}

/* === 搜索栏 === */
.search-bar {
  padding: 16rpx 24rpx;
}
.search-bar__input-wrap {
  display: flex;
  align-items: center;
  background-color: #FFFFFFFC;
  border: 0.5px solid #EAE5DC;
  border-radius: 24px;
  padding: 12rpx 24rpx;
}
.search-bar__icon {
  font-size: 32rpx;
  color: #8B8578;
  margin-right: 12rpx;
}
.search-bar__input {
  flex: 1;
  font-size: 26rpx;
  color: #2C2C2A;
}
.search-bar__clear {
  font-size: 24rpx;
  color: #B5B0A6;
  padding: 4rpx 8rpx;
}

/* === 社区加载状态 === */
.community-loading {
  text-align: center;
  padding: 48rpx 0;
  font-size: 26rpx;
  color: #8B8578;
}

/* === 社区卡片作者和点赞 === */
.post-card__author {
  font-size: 22rpx;
  color: #5B8C85;
  margin-left: 12rpx;
  flex: 1;
}
.post-card__status {
  font-size: 20rpx;
  color: #8B6F47;
  background: rgba(139, 111, 71, 0.08);
  border-radius: 12rpx;
  padding: 4rpx 10rpx;
  margin-left: 10rpx;
}
.post-card__status--approved {
  color: #3B6D11;
  background: rgba(59, 109, 17, 0.08);
}
.post-card__status--rejected,
.post-card__status--deleting {
  color: #A0522D;
  background: rgba(160, 82, 45, 0.08);
}
.post-card__like {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #A0522D;
}
