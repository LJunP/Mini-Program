/* subpackages/detail/content-detail/content-detail.wxss */
.page-bg {
  padding-bottom: 0;
}

/* 封面 */
.hero {
  padding: 64rpx 32rpx 56rpx;
  background-color: #A0522D;
}
.hero--wellness {
  background-color: #A0522D;
}
.hero--incense {
  background-color: #8B6F47;
}
.hero--music {
  background-color: #4A6B7C;
}
.hero--film {
  background-color: #2C2C2A;
}
.hero__tag {
  margin-bottom: 24rpx;
}
.hero__title {
  font-size: 44rpx;
  font-weight: 500;
  color: #FFFFFF;
  line-height: 1.5;
  letter-spacing: 4rpx;
}
.hero__meta {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}
.hero__dot {
  margin: 0 12rpx;
}

/* 正文 */
.paragraph {
  font-size: 28rpx;
  color: #2C2C2A;
  line-height: 2;
  letter-spacing: 1rpx;
  display: block;
  margin-bottom: 24rpx;
}
.paragraph:last-child {
  margin-bottom: 0;
}
.body-image {
  margin: 24rpx 0;
}
.body-image image {
  width: 100%;
  border-radius: 8px;
}
.body-image__caption {
  font-size: 22rpx;
  color: #8B8578;
  text-align: center;
  margin-top: 12rpx;
  display: block;
}
.quote {
  margin: 24rpx 0;
  padding: 24rpx;
  background-color: rgba(160, 82, 45, 0.06);
  border-left: 4rpx solid #A0522D;
  border-radius: 4px;
  font-size: 28rpx;
  color: #5A554C;
  font-style: italic;
  line-height: 1.8;
}

/* 小贴士 */
.tip {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}
.tip:last-child {
  margin-bottom: 0;
}
.tip__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #A0522D;
  margin-top: 14rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.tip__text {
  flex: 1;
  font-size: 26rpx;
  color: #5A554C;
  line-height: 1.7;
}

/* 提醒 */
.warn {
  background-color: rgba(160, 82, 45, 0.06);
  border: 0.5px solid rgba(160, 82, 45, 0.2);
}
.warn__text {
  font-size: 24rpx;
  color: #8B5A2B;
  line-height: 1.7;
  display: block;
}

/* 关联 */
.linked {
  background-color: #FFFFFFFC;
  border: 0.5px solid #EAE5DC;
  border-radius: 12px;
  overflow: hidden;
  margin-bottom: 24rpx;
}
.linked__item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 0.5px solid #EAE5DC;
}
.linked__item:last-child {
  border-bottom: none;
}
.linked__cover {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8px;
  margin-right: 24rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.linked__cover-text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 500;
}
.linked__body {
  flex: 1;
  min-width: 0;
}
.linked__name {
  font-size: 28rpx;
  color: #2C2C2A;
  font-weight: 500;
  display: block;
}
.linked__context {
  font-size: 22rpx;
  color: #8B8578;
  margin-top: 8rpx;
  display: block;
}
.linked__arrow {
  font-size: 32rpx;
  color: #B5B0A6;
  margin-left: 16rpx;
}

/* 底部 */
.bottom-placeholder {
  height: 120rpx;
}
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  padding: 16rpx 24rpx;
  background-color: #FFFFFFFC;
  border-top: 0.5px solid #EAE5DC;
  z-index: 10;
}
.action-bar__collect,
.action-bar__share,
.action-bar__poster {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  border-radius: 40px;
  margin: 0 8rpx;
  letter-spacing: 4rpx;
}
.action-bar__collect {
  background-color: #F3EFE6;
  color: #5A554C;
}
.action-bar__collect--active {
  background-color: #A0522D;
  color: #FFFFFF;
}
.action-bar__poster {
  background-color: #E8E3D8;
  color: #5A554C;
}
.action-bar__share {
  background-color: #A0522D;
  color: #FFFFFF;
  padding: 0;
  border: none;
  line-height: 80rpx;
}
.action-bar__share::after {
  border: none;
}

.loading {
  padding: 200rpx 0;
  text-align: center;
  color: #8B8578;
  font-size: 28rpx;
}

/* ========= 香道计时器入口 ========= */
.incense-timer-entry {
  margin-bottom: 24rpx;
}
.incense-timer-entry__btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx 0;
  background: linear-gradient(135deg, #8B6F47, #A0825A);
  border-radius: 12px;
  font-size: 28rpx;
  color: #FFFFFF;
  letter-spacing: 4rpx;
  box-shadow: 0 4rpx 12rpx rgba(139, 111, 71, 0.3);
}
.incense-timer-entry__icon {
  font-size: 32rpx;
}

/* ========= 香道计时器浮层 ========= */
.incense-timer {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 200;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}
.incense-timer--show {
  opacity: 1;
  pointer-events: auto;
}
.incense-timer__mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
}
.incense-timer__panel {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  background: #FFFFFFFC;
  border-radius: 24px;
  padding: 40rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
}

/* 头部 */
.incense-timer__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}
.incense-timer__title {
  font-size: 32rpx;
  font-weight: 500;
  color: #2C2C2A;
  letter-spacing: 4rpx;
}
.incense-timer__close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #8B8578;
  background: #F3EFE6;
  border-radius: 50%;
}
.incense-timer__header-btns {
  display: flex;
  gap: 12rpx;
}
.incense-timer__minimize {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #8B8578;
  background: #F3EFE6;
  border-radius: 50%;
}

/* 时长选择 */
.incense-timer__options {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 32rpx;
}
.incense-timer__option {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
  font-size: 26rpx;
  background: #F3EFE6;
  color: #8B8578;
  transition: all 0.2s ease;
}
.incense-timer__option--active {
  background: #8B6F47;
  color: #FFFFFF;
  font-weight: 500;
}

/* 计时器主体 */
.incense-timer__body {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}
.incense-timer__smoke {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}
.incense-timer__time {
  font-size: 96rpx;
  font-weight: 200;
  color: #8B6F47;
  font-variant-numeric: tabular-nums;
  letter-spacing: 4rpx;
}
.incense-timer__status {
  font-size: 24rpx;
  color: #8B8578;
  margin-top: 8rpx;
  margin-bottom: 32rpx;
}
.incense-timer__progress-bar {
  width: 100%;
  height: 12rpx;
  background: #F3EFE6;
  border-radius: 6rpx;
  overflow: hidden;
}
.incense-timer__progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #8B6F47, #C9A24D);
  border-radius: 6rpx;
  transition: width 0.5s ease;
}

/* 操作按钮 */
.incense-timer__actions {
  display: flex;
  gap: 16rpx;
}
.incense-timer__btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  font-size: 28rpx;
  letter-spacing: 4rpx;
  transition: all 0.2s ease;
}
.incense-timer__btn--start {
  background: linear-gradient(135deg, #8B6F47, #A0825A);
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(139, 111, 71, 0.3);
}
.incense-timer__btn--pause {
  background: #F3EFE6;
  color: #8B6F47;
}
.incense-timer__btn--reset {
  background: #F3EFE6;
  color: #5A554C;
}
.incense-timer__btn:active {
  transform: scale(0.96);
}

/* ========= 笔记功能 ========= */
.note-section {
  margin-bottom: 24rpx;
}
.note-card {
  background: #FFFFFFFC;
  border: 0.5px solid #EAE5DC;
  border-left: 4rpx solid #A0522D;
  border-radius: 12px;
  padding: 24rpx;
}
.note-card__content {
  display: block;
  font-size: 28rpx;
  color: #2C2C2A;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
}
.note-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 0.5px solid #F4F0E8;
}
.note-card__time {
  font-size: 22rpx;
  color: #B0A99A;
}
.note-card__actions {
  display: flex;
  gap: 16rpx;
}

.audio-license {
  padding: 22rpx 24rpx;
  margin: -4rpx 0 28rpx;
  border: 1rpx solid #E7E1D7;
  border-radius: 16rpx;
  background: #F8F6F2;
}
.audio-license__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.audio-license__title {
  font-size: 25rpx;
  font-weight: 500;
  color: #4A463D;
}
.audio-license__copy {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(74, 107, 124, 0.1);
  font-size: 22rpx;
  color: #4A6B7C;
}
.audio-license__line,
.audio-license__note {
  display: block;
  font-size: 22rpx;
  line-height: 1.7;
  color: #777064;
}
.audio-license__note {
  margin-top: 6rpx;
  color: #9A9285;
}
.content-safety-note {
  display: block;
  padding: 18rpx 22rpx;
  margin: 20rpx 0 4rpx;
  border: 1rpx solid #E7DEC8;
  border-radius: 14rpx;
  background: #FBF7EC;
  font-size: 22rpx;
  line-height: 1.7;
  color: #796B4E;
}
.note-card__btn {
  font-size: 24rpx;
  color: #854F0B;
  padding: 4rpx 16rpx;
  border-radius: 4rpx;
  background: rgba(133, 79, 11, 0.08);
}
.note-card__btn--delete {
  color: #A0522D;
  background: rgba(160, 82, 45, 0.08);
}
.note-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 96rpx;
  border: 1px dashed #D5D0C5;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.5);
}
.note-empty__icon {
  font-size: 28rpx;
  color: #B0A99A;
}
.note-empty__text {
  font-size: 26rpx;
  color: #8B8578;
}

/* 笔记编辑弹层 */
.note-input {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 300;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}
.note-input--show {
  opacity: 1;
  pointer-events: auto;
}
.note-input__mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}
.note-input__panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-radius: 24px 24px 0 0;
  padding: 32rpx;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}
.note-input__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.note-input__title {
  font-size: 32rpx;
  font-weight: 500;
  color: #2C2C2A;
  letter-spacing: 4rpx;
}
.note-input__close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #8B8578;
  background: #F3EFE6;
  border-radius: 50%;
}
.note-input__textarea {
  width: 100%;
  min-height: 240rpx;
  max-height: 400rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: #2C2C2A;
  background: #F8F6F2;
  border-radius: 12px;
  padding: 24rpx;
  box-sizing: border-box;
}
.note-input__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}
.note-input__count {
  font-size: 22rpx;
  color: #B0A99A;
}
.note-input__save {
  padding: 16rpx 48rpx;
  background: #A0522D;
  color: #FFFFFF;
  border-radius: 999rpx;
  font-size: 28rpx;
  letter-spacing: 4rpx;
}
.note-input__save:active {
  transform: scale(0.96);
}

/* ========= 最小化浮动计时器 ========= */
.incense-float {
  position: fixed;
  right: 24rpx;
  bottom: 140rpx;
  z-index: 150;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.15);
  opacity: 0;
  transform: translateY(20rpx);
  pointer-events: none;
  transition: all 0.3s ease;
}
.incense-float--show {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}
.incense-float__icon {
  font-size: 36rpx;
}
.incense-float__info {
  display: flex;
  flex-direction: column;
}
.incense-float__time {
  font-size: 28rpx;
  font-weight: 500;
  color: #8B6F47;
  font-variant-numeric: tabular-nums;
}
.incense-float__status {
  font-size: 20rpx;
  color: #8B8578;
}
.incense-float__progress {
  width: 80rpx;
  height: 6rpx;
  background: #F3EFE6;
  border-radius: 3rpx;
  overflow: hidden;
}
.incense-float__progress-fill {
  height: 100%;
  background: #8B6F47;
  border-radius: 3rpx;
  transition: width 0.5s ease;
}
