<!-- components/incense-timer/incense-timer.wxml -->
<view class="incense-timer">

  <!-- 浮动入口按钮 -->
  <view class="it-fab" bindtap="onOpen" wx:if="{{!showPanel && !isRunning}}">
    <text class="it-fab__icon">🪔</text>
    <text class="it-fab__text">焚香</text>
  </view>

  <!-- 运行中的浮动条 -->
  <view class="it-running" wx:if="{{isRunning && isMinimized}}" bindtap="onToggleMinimize">
    <text class="it-running__icon">🪔</text>
    <text class="it-running__time">{{displayTime}}</text>
    <view class="it-running__progress">
      <view class="it-running__progress-fill" style="width:{{totalSeconds > 0 ? (remainingSeconds / totalSeconds * 100) : 0}}%;"></view>
    </view>
  </view>

  <!-- 展开面板 -->
  <view class="it-panel-mask" wx:if="{{showPanel}}" bindtap="onClose">
    <view class="it-panel" catchtap="">
      <!-- 面板头部 -->
      <view class="it-panel__header">
        <text class="it-panel__title">焚香计时</text>
        <view class="it-panel__close" bindtap="onClose">
          <text>×</text>
        </view>
      </view>

      <!-- 香品名称 -->
      <view class="it-panel__incense" wx:if="{{incenseName}}">
        <text class="it-panel__incense-label">当前香品</text>
        <text class="it-panel__incense-name">{{incenseName}}</text>
      </view>

      <!-- 时长选择 -->
      <view class="it-durations">
        <view
          wx:for="{{durationOptions}}"
          wx:key="value"
          class="it-duration {{selectedDuration === item.value ? 'it-duration--active' : ''}}"
          data-value="{{item.value}}"
          bindtap="onSelectDuration"
        >
          <text>{{item.label}}</text>
        </view>
      </view>

      <!-- 开始按钮 -->
      <view class="it-start-btn" bindtap="onStart">
        <text>开始焚香</text>
      </view>

      <!-- 焚香统计 -->
      <view class="it-stats">
        <view class="it-stats__item">
          <text class="it-stats__num">{{stats.total}}</text>
          <text class="it-stats__label">累计焚香</text>
        </view>
        <view class="it-stats__divider"></view>
        <view class="it-stats__item">
          <text class="it-stats__num">{{stats.totalDuration}}</text>
          <text class="it-stats__label">累计分钟</text>
        </view>
        <view class="it-stats__divider"></view>
        <view class="it-stats__item">
          <text class="it-stats__num">{{stats.thisMonth}}</text>
          <text class="it-stats__label">本月</text>
        </view>
      </view>

      <!-- 历史记录 -->
      <view class="it-history-toggle" bindtap="onToggleHistory">
        <text>{{showHistory ? '收起历史' : '查看历史'}}</text>
        <text class="it-history-toggle__icon">{{showHistory ? '▲' : '▼'}}</text>
      </view>
      <view class="it-history" wx:if="{{showHistory && history.length}}">
        <view class="it-history__item" wx:for="{{history}}" wx:key="id">
          <text class="it-history__name">{{item.incenseName}}</text>
          <text class="it-history__duration">{{item.duration}}分钟</text>
          <text class="it-history__date">{{item.date}}</text>
        </view>
      </view>
      <view class="it-history-empty" wx:if="{{showHistory && !history.length}}">
        <text>暂无焚香记录</text>
      </view>
    </view>
  </view>

  <!-- 运行中展开面板 -->
  <view class="it-running-mask" wx:if="{{isRunning && showPanel}}" bindtap="onToggleMinimize">
    <view class="it-running-panel" catchtap="">
      <view class="it-running-panel__time">{{displayTime}}</view>
      <view class="it-running-panel__progress">
        <view class="it-running-panel__progress-fill" style="width:{{totalSeconds > 0 ? (remainingSeconds / totalSeconds * 100) : 0}}%;"></view>
      </view>
      <view class="it-running-panel__btns">
        <view class="it-running-panel__btn it-running-panel__btn--stop" bindtap="onStop">
          <text>停止</text>
        </view>
        <view class="it-running-panel__btn it-running-panel__btn--hide" bindtap="onToggleMinimize">
          <text>收起</text>
        </view>
      </view>
    </view>
  </view>

</view>
