/* pages/travel/travel.wxss */
.page-header {
  padding: 32rpx 16rpx 24rpx;
}
.page-header__title {
  font-size: 44rpx;
  font-weight: 500;
  color: #2C2C2A;
  letter-spacing: 8rpx;
}
.page-header__sub {
  display: block;
  font-size: 24rpx;
  color: #8B8578;
  margin-top: 8rpx;
  letter-spacing: 4rpx;
}

/* 主题筛选条 */
.theme-bar {
  white-space: nowrap;
  padding: 0 16rpx 8rpx;
}
.theme-bar__inner {
  display: inline-flex;
  gap: 16rpx;
  padding: 4rpx 0;
}
.theme-chip {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  background-color: #F3EFE6;
  border-radius: 32px;
  transition: all 0.2s ease;
}
.theme-chip--active {
  background-color: #5B8C85;
}
.theme-chip__icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}
.theme-chip__name {
  font-size: 24rpx;
  color: #5A554C;
  letter-spacing: 2rpx;
}
.theme-chip--active .theme-chip__name {
  color: #FFFFFF;
}

.travel-list {
  padding-top: 16rpx;
}

/* 高级筛选 */
.filter-bar {
  display: flex;
  align-items: center;
  padding: 12rpx 32rpx;
  gap: 12rpx;
}
.filter-bar__btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  background-color: #F3EFE6;
  font-size: 24rpx;
  color: #5A554C;
  flex-shrink: 0;
}
.filter-bar__btn--active {
  background-color: #5B8C85;
  color: #FFFFFF;
}
.filter-bar__icon {
  font-size: 18rpx;
}
.filter-bar__tags {
  display: flex;
  gap: 8rpx;
  overflow: hidden;
}
.filter-tag {
  font-size: 20rpx;
  color: #5B8C85;
  background-color: rgba(91, 140, 133, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.filter-tag--reset {
  color: #A0522D;
  background-color: rgba(160, 82, 45, 0.1);
}

/* 筛选面板 */
.filter-panel {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
  background-color: #FFFFFFFC;
  border-bottom: 0.5px solid #EAE5DC;
}
.filter-panel--show {
  max-height: 600rpx;
  padding: 16rpx 32rpx;
}
.filter-group {
  margin-bottom: 16rpx;
}
.filter-group__title {
  font-size: 24rpx;
  color: #8B8578;
  margin-bottom: 8rpx;
  display: block;
}
.filter-group__options {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.filter-option {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  background-color: #F3EFE6;
  font-size: 24rpx;
  color: #5A554C;
}
.filter-option--active {
  background-color: #5B8C85;
  color: #FFFFFF;
}

.travel-card {
  background-color: #FFFFFFFC;
  border: 0.5px solid #EAE5DC;
  border-radius: 12px;
  overflow: hidden;
  margin-bottom: 32rpx;
}

.travel-card__cover {
  height: 320rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #5B8C85;
}
.travel-card__img {
  width: 100%;
  height: 100%;
}
.travel-card__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}
.travel-card__dest {
  font-size: 64rpx;
  color: #FFFFFF;
  font-weight: 500;
  letter-spacing: 16rpx;
  opacity: 0.85;
}
.travel-card__duration {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  background-color: rgba(255, 255, 255, 0.85);
  color: #5B8C85;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 4px;
}

.travel-card__body {
  padding: 24rpx;
}
.travel-card__title {
  font-size: 34rpx;
  font-weight: 500;
  color: #2C2C2A;
  display: block;
  line-height: 1.5;
}
.travel-card__meta {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}
.travel-card__region {
  font-size: 24rpx;
  color: #8B8578;
  margin-right: 16rpx;
}
.travel-card__pace {
  font-size: 22rpx;
  color: #5B8C85;
  background-color: rgba(91, 140, 133, 0.1);
  padding: 2rpx 12rpx;
  border-radius: 4px;
}
.travel-card__essay {
  font-size: 26rpx;
  color: #5A554C;
  margin-top: 16rpx;
  line-height: 1.7;
  display: block;
}
.travel-card__domains {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

/* 骨架屏 */
.skeleton-list {
  padding: 0 16rpx;
}
.skeleton-item {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}
.skeleton-item__cover {
  width: 100%;
  height: 300rpx;
}
.skeleton-item__body {
  padding: 24rpx;
}
.skeleton-item__title {
  width: 60%;
  height: 36rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}
.skeleton-item__meta {
  width: 40%;
  height: 24rpx;
  border-radius: 8rpx;
}
.skeleton-pulse {
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: pulse 1.5s ease-in-out infinite;
}
@keyframes pulse {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
