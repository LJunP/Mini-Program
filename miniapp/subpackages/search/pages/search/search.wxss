/* subpackages/search/pages/search/search.wxss */

/* ===================== 搜索框 ===================== */
.search-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx;
  gap: 20rpx;
}
.search-bar__box {
  flex: 1;
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 0.5px solid #EAE5DC;
  border-radius: 12rpx;
  padding: 0 24rpx;
  height: 72rpx;
}
.search-bar__icon {
  font-size: 32rpx;
  color: #8B8578;
  margin-right: 12rpx;
}
.search-bar__input {
  flex: 1;
  font-size: 28rpx;
  color: #2C2C2A;
  height: 72rpx;
}
.search-bar__clear {
  font-size: 28rpx;
  color: #8B8578;
  padding: 8rpx;
}
.search-bar__btn {
  font-size: 28rpx;
  color: #3B6D11;
  font-weight: 500;
  padding: 8rpx 4rpx;
}

/* ===================== 搜索建议 ===================== */
.suggestions {
  background: #FFFFFF;
  margin: 0 32rpx;
  border-radius: 12rpx;
  border: 0.5px solid #EAE5DC;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  overflow: hidden;
}
.suggestions__item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 0.5px solid #F5F3EE;
}
.suggestions__item:last-child {
  border-bottom: none;
}
.suggestions__icon {
  font-size: 26rpx;
  color: #B5B0A8;
  margin-right: 16rpx;
}
.suggestions__text {
  font-size: 28rpx;
  color: #444441;
}

/* ===================== Section Title ===================== */
.page-bg .section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #2C2C2A;
  margin: 0;
}
.page-bg .section-title::before {
  display: none;
}
.page-bg .section-title__action {
  font-size: 24rpx;
  color: #8B8578;
  font-weight: normal;
}

/* ===================== 热门搜索 ===================== */
.hot-keywords {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 0 32rpx;
}
.hot-keywords__item {
  background: #FFFFFF;
  border: 0.5px solid #EAE5DC;
  border-radius: 8rpx;
  padding: 14rpx 28rpx;
  font-size: 26rpx;
  color: #444441;
}

/* ===================== 搜索历史 ===================== */
.search-history {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 32rpx 24rpx;
}
.search-history__item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #FFFFFF;
  border: 0.5px solid #EAE5DC;
  border-radius: 8rpx;
  padding: 12rpx 20rpx 12rpx 24rpx;
  font-size: 26rpx;
  color: #444441;
}
.search-history__delete {
  font-size: 20rpx;
  color: #C5C0B8;
  padding: 4rpx;
  line-height: 1;
}

/* ===================== 结果 Tab 栏 ===================== */
.result-tabs {
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  gap: 40rpx;
  border-bottom: 0.5px solid #EAE5DC;
  margin-bottom: 0;
}
.result-tabs__item {
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #8B8578;
  position: relative;
  flex-shrink: 0;
}
.result-tabs__item--active {
  color: #2C2C2A;
  font-weight: 500;
}
.result-tabs__item--active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 3rpx;
  background: #3B6D11;
  border-radius: 2rpx;
}

/* ===================== 筛选按钮 ===================== */
.result-tabs__filter {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #8B8578;
  flex-shrink: 0;
}
.result-tabs__filter-icon {
  font-size: 20rpx;
  transition: transform 0.3s ease;
}
.result-tabs__filter-icon--active {
  transform: rotate(180deg);
}

/* ===================== 搜索结果统计 ===================== */
.result-count {
  padding: 16rpx 32rpx;
  font-size: 24rpx;
  color: #B5B0A8;
}

/* ===================== 筛选面板 ===================== */
.filter-panel {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
  background: #FFFFFF;
  margin: 0 32rpx;
  border-radius: 12rpx;
  border: 0.5px solid #EAE5DC;
}
.filter-panel--show {
  max-height: 600rpx;
  overflow-y: auto;
  margin-bottom: 16rpx;
}
.filter-section {
  padding: 24rpx;
  border-bottom: 0.5px solid #F5F3EE;
}
.filter-section:last-child {
  border-bottom: none;
}
.filter-section__title {
  display: block;
  font-size: 26rpx;
  color: #8B8578;
  margin-bottom: 16rpx;
}
.filter-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.filter-option {
  background: #F1EFE8;
  border-radius: 8rpx;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  color: #5F5E5A;
  transition: background 0.2s, color 0.2s;
}
.filter-option--active {
  background: #3B6D11;
  color: #FFFFFF;
}

/* ===================== 搜索结果项 ===================== */
.result-item {
  display: flex;
  align-items: center;
  margin: 0 32rpx 16rpx;
  padding: 24rpx;
  background: #FFFFFF;
  border: 0.5px solid #EAE5DC;
  border-radius: 12rpx;
  gap: 24rpx;
}
.result-item__cover {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.result-item__char {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 500;
}
.result-item__body {
  flex: 1;
  min-width: 0;
}
.result-item__title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #2C2C2A;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.result-item__meta {
  display: block;
  font-size: 24rpx;
  color: #8B8578;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.result-item__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}
.tag--sm {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  background: #F1EFE8;
  color: #5F5E5A;
}

/* ===================== 空状态（搜索页内联） ===================== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 32rpx;
}
.empty-state__text {
  font-size: 30rpx;
  color: #8B8578;
  margin-bottom: 12rpx;
}
.empty-state__desc {
  font-size: 26rpx;
  color: #B5B0A8;
}
.empty-state__link {
  display: inline-block;
  font-size: 26rpx;
  color: #3B6D11;
  margin-top: 16rpx;
  padding: 8rpx 24rpx;
  border: 1px solid #3B6D11;
  border-radius: 20rpx;
}

/* ===================== 加载更多 ===================== */
.load-more-domain {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 32rpx;
  margin: 16rpx 32rpx;
  background: #3B6D11;
  border-radius: 24rpx;
  font-size: 28rpx;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}
.load-more-domain:active {
  opacity: 0.8;
}
