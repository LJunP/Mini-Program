<!-- components/audio-player/audio-player.wxml -->
<view class="audio-player" wx:if="{{src && hasAudio}}">
  <view class="audio-player__header">
    <text class="audio-player__title">{{title}}</text>
    <text class="audio-player__duration">{{durationText}}</text>
  </view>
  
  <view class="audio-player__controls">
    <!-- 上一首 -->
    <view class="audio-player__nav-btn" bindtap="onPrev" wx:if="{{playlist.length > 1}}">
      <text>⏮</text>
    </view>
    
    <view class="audio-player__btn" bindtap="onTogglePlay">
      <text class="audio-player__icon">{{isPlaying ? '⏸' : '▶'}}</text>
    </view>
    
    <!-- 下一首 -->
    <view class="audio-player__nav-btn" bindtap="onNext" wx:if="{{playlist.length > 1}}">
      <text>⏭</text>
    </view>
    
    <view class="audio-player__progress" bindtap="onSeek">
      <view class="audio-player__progress-bar">
        <view class="audio-player__progress-fill" style="width: {{progress}}%;"></view>
      </view>
      <view class="audio-player__time">
        <text>{{currentTimeText}}</text>
        <text>{{durationText}}</text>
      </view>
    </view>
  </view>
  
  <view class="audio-player__volume">
    <text class="audio-player__volume-icon">🔊</text>
    <slider 
      class="audio-player__volume-slider"
      min="0" 
      max="100" 
      value="{{volume}}"
      bindchange="onVolumeChange"
      activeColor="#4A6B7C"
      backgroundColor="#EAE5DC"
    />
  </view>
</view>

<!-- 无音频时占位 -->
<view class="audio-player audio-player--empty" wx:elif="{{!src || !hasAudio}}">
  <view class="audio-player__empty-icon">🎵</view>
  <view class="audio-player__empty-text">
    <text class="audio-player__empty-title">音频筹备中</text>
    <text class="audio-player__empty-desc">该曲目的音频正在准备中，敬请期待</text>
  </view>
</view>
