<!-- components/retry-bar/retry-bar.wxml -->
<view wx:if="{{show}}" class="retry-bar retry-bar--show">
  <view class="retry-bar__body">
    <text class="retry-bar__icon">⚠</text>
    <text class="retry-bar__msg">{{message}}</text>
  </view>
  <view class="retry-bar__btn {{loading ? 'retry-bar__btn--loading' : ''}}" bindtap="onRetry">
    <text>{{loading ? '重试中...' : '重试'}}</text>
  </view>
</view>
