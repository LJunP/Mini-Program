<!-- pages/wellness/wellness.wxml -->
<view class="page-bg">
  <view class="page-header">
    <view class="page-header__row">
      <view class="page-header__titles">
        <text class="page-header__title">养生</text>
        <text class="page-header__sub">不玄学 · 不焦虑 · 今天就能做的小事</text>
      </view>
      <view class="page-header__search" bindtap="goSearch">
        <text class="page-header__search-icon">⌕</text>
      </view>
    </view>
  </view>

  <!-- 排序栏 -->
  <view class="sort-bar">
    <view class="sort-bar__tabs">
      <view
        wx:for="{{sortOptions}}"
        wx:key="key"
        class="sort-bar__item {{sort === item.key ? 'sort-bar__item--active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onSortTap"
      >
        <text>{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 分类 tab（含数量 + 图标） -->
  <scroll-view class="tabs-scroll" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view class="tabs">
      <view
        wx:for="{{categories}}"
        wx:key="key"
        class="tabs__item {{currentCategory === item.key ? 'tabs__item--active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onCategoryTap"
      >
        <text class="tabs__item-icon">{{item.icon}}</text>
        <text class="tabs__name">{{item.name}}</text>
        <text class="tabs__count">{{item.count}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 加载骨架屏 -->
  <view wx:if="{{loading && !list.length}}" class="skeleton-list">
    <view wx:for="{{[1,2,3]}}" wx:key="*this" class="skeleton-card">
      <view class="skeleton-card__cover skeleton-pulse"></view>
      <view class="skeleton-card__body">
        <view class="skeleton-card__title skeleton-pulse"></view>
        <view class="skeleton-card__meta skeleton-pulse"></view>
      </view>
    </view>
  </view>

  <!-- 内容列表 -->
  <view class="wellness-list" wx:if="{{!loading && list.length}}">
    <view class="wellness-item" wx:for="{{list}}" wx:key="id">
      <content-card
        domain="wellness"
        contentId="{{item.id}}"
        title="{{item.title}}"
        summary="{{item.body}}"
        coverImage="{{item.coverImage}}"
        extra="{{item.duration}}"
        data="{{item}}"
        bindtap="onWellnessTap"
      />
      <!-- 养生元数据栏 -->
      <view class="wellness-meta">
        <view class="wellness-meta__tags">
          <text class="meta-tag meta-tag--difficulty-{{item.difficulty}}">
            {{item.difficulty === 1 ? '极易' : item.difficulty === 2 ? '容易' : item.difficulty === 3 ? '中等' : '需坚持'}}
          </text>
          <text class="meta-tag meta-tag--duration">
            {{item.durationTag === '5min' ? '5分钟内' : item.durationTag === '15min' ? '15分钟内' : item.durationTag === '30min' ? '30分钟内' : '持续养成'}}
          </text>
        </view>
        <text class="wellness-meta__caution">{{item.caution}}</text>
      </view>
    </view>
  </view>

  <empty-state wx:if="{{!loading && !list.length}}" text="暂无该分类内容" desc="试试其他分类" />
</view>
