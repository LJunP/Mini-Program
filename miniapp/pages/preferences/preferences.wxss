/* pages/preferences/preferences.wxss */

.page-bg {
  min-height: 100vh;
  background-color: #FAF8F3;
  padding: 0 0 120rpx;
}

.intro-section {
  padding: 32rpx 32rpx 24rpx;
  background-color: #FFFFFFFC;
  border-bottom: 0.5px solid #EAE5DC;
}

.intro-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #2C2C2A;
  display: block;
  margin-bottom: 12rpx;
}

.intro-desc {
  font-size: 26rpx;
  color: #8B8578;
  line-height: 1.6;
  display: block;
}

.preferences-list {
  padding: 24rpx;
}

.preference-item {
  background-color: #FFFFFFFC;
  border: 0.5px solid #EAE5DC;
  border-radius: 12px;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
}

.preference-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.preference-info {
  flex: 1;
}

.preference-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #2C2C2A;
  display: block;
  margin-bottom: 8rpx;
}

.preference-desc {
  font-size: 24rpx;
  color: #8B8578;
  line-height: 1.6;
  display: block;
}

.preference-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #3B6D11;
  min-width: 80rpx;
  text-align: right;
}

.preference-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.preference-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  line-height: 1.4;
}

.reset-section {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #FAF8F3;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.reset-btn {
  flex: 1;
  height: 88rpx;
  background-color: #EAE5DC;
  color: #8B8578;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.reset-btn::after {
  border: none;
}

.save-btn {
  flex: 1;
  height: 88rpx;
  background-color: #3B6D11;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.save-btn::after {
  border: none;
}

.tip-section {
  padding: 32rpx;
  margin: 24rpx;
  background-color: #F0F7E6;
  border-radius: 12px;
  border: 0.5px solid #D5E8C5;
}

.tip-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #3B6D11;
  display: block;
  margin-bottom: 16rpx;
}

.tip-content {
  font-size: 24rpx;
  color: #5A554C;
  line-height: 1.8;
  display: block;
}