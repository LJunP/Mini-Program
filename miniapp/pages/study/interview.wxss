/* pages/study/interview.wxss */
.page-header {
  padding: 32rpx 16rpx 24rpx;
}
.page-header__title {
  font-size: 44rpx;
  font-weight: 500;
  color: #2C2C2A;
  letter-spacing: 8rpx;
}
.page-header__sub {
  display: block;
  font-size: 24rpx;
  color: #8B8578;
  margin-top: 8rpx;
  letter-spacing: 2rpx;
}
.filter-title {
  color: #8B8578;
  font-size: 24rpx;
  margin: 20rpx 0 12rpx;
}
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.chip {
  padding: 10rpx 20rpx;
  background-color: #FFFFFFFC;
  border: 0.5px solid #EAE5DC;
  border-radius: 999rpx;
  color: #8B8578;
  font-size: 24rpx;
}
.chip--active {
  background-color: rgba(133, 79, 11, 0.1);
  border-color: rgba(133, 79, 11, 0.24);
  color: #854F0B;
  font-weight: 500;
}
.question-list {
  padding-top: 4rpx;
}
.question-card {
  background-color: #FFFFFFFC;
  border: 0.5px solid #EAE5DC;
  border-radius: 12px;
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.question-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.question-card__type {
  color: #854F0B;
  background-color: rgba(133, 79, 11, 0.1);
  border-radius: 4px;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
}
.question-card__status {
  border-radius: 4px;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
}
.question-card__status--mastered {
  color: #3B6D11;
  background-color: rgba(59, 109, 17, 0.1);
}
.question-card__status--learning {
  color: #4A6B7C;
  background-color: rgba(74, 107, 124, 0.1);
}
.question-card__status--weak {
  color: #A0522D;
  background-color: rgba(160, 82, 45, 0.1);
}
.question-card__meta {
  color: #8B8578;
  font-size: 22rpx;
}
.question-card__title {
  display: block;
  color: #2C2C2A;
  font-size: 34rpx;
  font-weight: 500;
  line-height: 1.5;
}
.question-card__question {
  display: block;
  color: #5A554C;
  font-size: 26rpx;
  line-height: 1.7;
  margin-top: 12rpx;
}
.question-card__points {
  margin-top: 18rpx;
}
.point {
  display: inline-block;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  color: #854F0B;
  background-color: rgba(133, 79, 11, 0.08);
  border-radius: 4px;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

/* 搜索栏样式 */
.search-bar {
  padding: 8rpx 0 16rpx;
}
.search-bar__box {
  position: relative;
  display: flex;
  align-items: center;
  background-color: #FFFFFFFC;
  border: 0.5px solid #EAE5DC;
  border-radius: 8px;
  padding: 16rpx 24rpx;
}
.search-bar__icon {
  margin-right: 16rpx;
}
.search-bar__input {
  flex: 1;
  font-size: 26rpx;
  color: #2C2C2A;
}
.search-bar__clear {
  padding: 8rpx;
  z-index: 10;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 36rpx;
  margin-bottom: 20rpx;
}
.reset-filters-btn {
  font-size: 24rpx;
  color: #854F0B;
  background-color: rgba(133, 79, 11, 0.08);
  border-radius: 4px;
  padding: 6rpx 16rpx;
}

/* 探索妙不可园 */
.explore-card {
  display: flex;
  align-items: center;
  margin-top: 40rpx;
  margin-bottom: 40rpx;
  padding: 32rpx 28rpx;
  background: linear-gradient(135deg, #3B6D11 0%, #5B8C85 100%);
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(59, 109, 17, 0.2);
}
.explore-card__icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.explore-card__char {
  font-size: 32rpx;
  font-weight: 500;
  color: #FFFFFF;
}
.explore-card__body {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}
.explore-card__title {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: #FFFFFF;
  letter-spacing: 4rpx;
}
.explore-card__desc {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}
.explore-card__arrow {
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.6);
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 24rpx 0;
}
.load-more__loading {
  font-size: 24rpx;
  color: #999;
}
.load-more__end {
  font-size: 24rpx;
  color: #ccc;
}