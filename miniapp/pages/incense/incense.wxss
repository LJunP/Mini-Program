/* pages/incense/incense.wxss */
.page-bg {
  min-height: 100vh;
  background: var(--bg-primary, #FAF8F3);
  padding-bottom: 40rpx;
}

.page-header {
  padding: 40rpx 32rpx 24rpx;
}

.page-header__title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-primary, #2C2C2A);
  line-height: 1.2;
}

.page-header__sub {
  display: block;
  font-size: 24rpx;
  color: var(--text-tertiary, #B8B4AC);
  margin-top: 8rpx;
}

/* 分类 tabs */
.tabs {
  display: flex;
  padding: 0 32rpx 24rpx;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.tabs::-webkit-scrollbar {
  display: none;
}

.tabs__item {
  flex-shrink: 0;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  background: var(--bg-card, #FFFFFF);
  font-size: 26rpx;
  color: var(--text-secondary, #6B6860);
  transition: all 0.2s;
}

.tabs__item--active {
  background: var(--color-incense, #8B6F47);
  color: #FFFFFF;
}

/* 内容列表 */
.incense-list {
  padding: 0 32rpx;
}
