<!-- components/content-card/content-card.wxml -->
<view class="cc {{isViewed ? 'cc--viewed' : ''}}" bindtap="onTap">
  <!-- 封面 -->
  <view class="cc__cover" style="background:{{coverGradient}};">
    <image wx:if="{{coverImage}}" src="{{coverImage}}" mode="aspectFill" lazy-load="{{true}}" class="cc__img" />
    <view wx:else class="cc__cover-placeholder">
      <text class="cc__pattern">{{patternText}}</text>
      <text class="cc__cover-text">{{coverText}}</text>
    </view>
    <!-- 已浏览标记 -->
    <view wx:if="{{isViewed}}" class="cc__viewed-badge">
      <text class="cc__viewed-text">已浏览</text>
    </view>
  </view>

  <view class="cc__body">
    <view class="cc__header">
      <domain-tag domain="{{domain}}" size="small" />
      <text wx:if="{{extra}}" class="cc__extra">{{extra}}</text>
    </view>

    <text class="cc__title ellipsis-2">{{title}}</text>

    <text wx:if="{{summary}}" class="cc__summary ellipsis-2">{{summary}}</text>

    <view class="cc__footer">
      <text wx:if="{{author}}" class="cc__author">{{author}}</text>
      <text wx:if="{{duration}}" class="cc__duration">{{duration}}</text>
    </view>
  </view>
</view>
