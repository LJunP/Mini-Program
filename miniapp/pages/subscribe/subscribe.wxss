/* pages/subscribe/subscribe.wxss */

.page-header {
  padding: 32rpx 24rpx;
  padding-top: 48rpx;
}
.page-header__top {
  margin-bottom: 32rpx;
}
.back-btn {
  display: flex;
  align-items: center;
}
.back-btn__icon {
  font-size: 40rpx;
  color: #3B6D11;
  margin-right: 8rpx;
}
.back-btn__text {
  font-size: 28rpx;
  color: #3B6D11;
}
.page-title {
  font-size: 40rpx;
  font-weight: 500;
  color: #2C2C2A;
  display: block;
  margin-bottom: 16rpx;
}
.page-desc {
  font-size: 26rpx;
  color: #8B8578;
  line-height: 1.6;
  display: block;
}

/* 订阅统计 */
.subscribe-stats {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 32rpx 24rpx;
  margin: 0 24rpx 32rpx;
}
.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stats-num {
  font-size: 48rpx;
  font-weight: 500;
  color: #3B6D11;
  margin-bottom: 8rpx;
}
.stats-label {
  font-size: 24rpx;
  color: #8B8578;
}
.stats-divider {
  width: 0.5px;
  height: 60rpx;
  background-color: #EAE5DC;
}

/* 订阅列表 */
.subscribe-list {
  margin: 0 24rpx 32rpx;
}
.subscribe-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 24rpx;
  border-bottom: 0.5px solid #EAE5DC;
}
.subscribe-item:last-child {
  border-bottom: none;
}
.subscribe-item__info {
  flex: 1;
  margin-right: 24rpx;
}
.subscribe-item__header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.subscribe-item__name {
  font-size: 30rpx;
  font-weight: 500;
  color: #2C2C2A;
  margin-right: 16rpx;
}
.subscribe-item__badge {
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  background-color: #EAE5DC;
}
.subscribe-item__badge--active {
  background-color: #F0F7E6;
}
.subscribe-item__badge text {
  font-size: 20rpx;
  color: #8B8578;
}
.subscribe-item__badge--active text {
  color: #3B6D11;
}
.subscribe-item__desc {
  font-size: 24rpx;
  color: #8B8578;
  line-height: 1.6;
  display: block;
}

/* 开关 */
.toggle-switch {
  width: 88rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background-color: #EAE5DC;
  position: relative;
  transition: background-color 0.3s ease;
}
.toggle-switch--active {
  background-color: #3B6D11;
}
.toggle-switch__dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: #FFFFFF;
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  transition: transform 0.3s ease;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}
.toggle-switch--active .toggle-switch__dot {
  transform: translateX(40rpx);
}

/* 操作按钮 */
.action-buttons {
  padding: 0 24rpx;
  margin-bottom: 32rpx;
}
.action-btn {
  padding: 28rpx 0;
  border-radius: 12px;
  text-align: center;
  margin-bottom: 24rpx;
}
.action-btn--primary {
  background-color: #3B6D11;
}
.action-btn--primary text {
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
}
.action-btn--secondary {
  background-color: #FFFFFFFC;
  border: 0.5px solid #EAE5DC;
}
.action-btn--secondary text {
  color: #2C2C2A;
  font-size: 30rpx;
}

/* 权限设置 */
.permission-card {
  margin: 0 24rpx 32rpx;
}
.permission-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 24rpx;
}
.permission-item__info {
  flex: 1;
}
.permission-item__name {
  font-size: 30rpx;
  font-weight: 500;
  color: #2C2C2A;
  display: block;
  margin-bottom: 8rpx;
}
.permission-item__desc {
  font-size: 24rpx;
  color: #8B8578;
  line-height: 1.6;
  display: block;
}
.permission-item__arrow {
  font-size: 32rpx;
  color: #B5B0A6;
  margin-left: 16rpx;
}

/* 说明文字 */
.subscribe-notice {
  padding: 32rpx 24rpx;
  margin: 0 24rpx 48rpx;
}
.notice-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #2C2C2A;
  display: block;
  margin-bottom: 24rpx;
}
.notice-list {
  padding-left: 24rpx;
}
.notice-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}
.notice-item:last-child {
  margin-bottom: 0;
}
.notice-dot {
  font-size: 24rpx;
  color: #8B8578;
  margin-right: 16rpx;
  line-height: 1.6;
}
.notice-text {
  font-size: 24rpx;
  color: #8B8578;
  line-height: 1.6;
}