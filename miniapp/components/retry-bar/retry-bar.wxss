/* components/retry-bar/retry-bar.wxss */
.retry-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  margin: 16rpx;
  background: rgba(160, 82, 45, 0.08);
  border: 0.5px solid rgba(160, 82, 45, 0.2);
  border-radius: 12px;
  opacity: 0;
  height: 0;
  overflow: hidden;
  transition: all 0.3s ease;
}
.retry-bar--show {
  opacity: 1;
  height: auto;
  padding: 20rpx 28rpx;
}
.retry-bar__body {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}
.retry-bar__icon {
  font-size: 28rpx;
  color: #A0522D;
  flex-shrink: 0;
}
.retry-bar__msg {
  font-size: 26rpx;
  color: #5A554C;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.retry-bar__btn {
  font-size: 26rpx;
  color: #3B6D11;
  background: rgba(59, 109, 17, 0.1);
  border: 0.5px solid rgba(59, 109, 17, 0.25);
  border-radius: 8px;
  padding: 10rpx 28rpx;
  font-weight: 500;
  flex-shrink: 0;
  margin-left: 16rpx;
}
.retry-bar__btn:active {
  background: rgba(59, 109, 17, 0.15);
}
.retry-bar__btn--loading {
  color: #8B8578;
  background: #F3EFE6;
  border-color: #EAE5DC;
}
