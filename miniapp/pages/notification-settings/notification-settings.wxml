<!-- pages/notification-settings/notification-settings.wxml -->
<view class="page-bg">
  <view class="settings-section">
    <view class="settings-header">
      <view class="settings-header__row">
        <text class="settings-title">推送通知</text>
        <text class="settings-preview-tag">功能预览</text>
      </view>
      <text class="settings-desc">控制应用内通知的推送 · 以下设置将在后端推送服务上线后生效</text>
    </view>
    
    <view class="settings-item">
      <view class="settings-item__info">
        <text class="settings-item__name">开启推送通知 <text class="settings-item__badge">开发中</text></text>
        <text class="settings-item__desc">接收应用内通知和提醒</text>
      </view>
      <switch 
        checked="{{pushEnabled}}" 
        color="#3B6D11"
        bindchange="onPushToggle"
      />
    </view>
    
    <view class="settings-item" wx:if="{{pushEnabled}}">
      <view class="settings-item__info">
        <text class="settings-item__name">通知声音</text>
        <text class="settings-item__desc">收到通知时播放声音</text>
      </view>
      <switch 
        checked="{{soundEnabled}}" 
        color="#3B6D11"
        bindchange="onSoundToggle"
      />
    </view>
    
    <view class="settings-item" wx:if="{{pushEnabled}}">
      <view class="settings-item__info">
        <text class="settings-item__name">震动提醒</text>
        <text class="settings-item__desc">收到通知时震动</text>
      </view>
      <switch 
        checked="{{vibrationEnabled}}" 
        color="#3B6D11"
        bindchange="onVibrationToggle"
      />
    </view>
  </view>
  
  <view class="settings-section">
    <view class="settings-header">
      <text class="settings-title">订阅消息</text>
      <text class="settings-desc">管理微信订阅消息</text>
    </view>
    
    <view class="settings-item" bindtap="onManageSubscribe">
      <view class="settings-item__info">
        <text class="settings-item__name">订阅消息管理</text>
        <text class="settings-item__desc">管理每日推荐、签到提醒等订阅消息</text>
      </view>
      <view class="settings-item__right">
        <text class="settings-item__count">{{subscribeEnabledCount}}项已开启</text>
        <text class="settings-item__arrow">›</text>
      </view>
    </view>
    
    <view class="settings-item" bindtap="onRequestPermission">
      <view class="settings-item__info">
        <text class="settings-item__name">通知权限设置</text>
        <text class="settings-item__desc">前往系统设置管理通知权限</text>
      </view>
      <text class="settings-item__arrow">›</text>
    </view>
  </view>
  
  <view class="settings-section">
    <view class="settings-header">
      <text class="settings-title">通知频率</text>
      <text class="settings-preview-tag">即将上线</text>
      <text class="settings-desc">控制通知的发送频率</text>
    </view>
    
    <view class="settings-item">
      <view class="settings-item__info">
        <text class="settings-item__name">免打扰时段</text>
        <text class="settings-item__desc">{{dndEnabled ? dndStartTime + ' - ' + dndEndTime : '未开启'}}</text>
      </view>
      <switch 
        checked="{{dndEnabled}}" 
        color="#3B6D11"
        bindchange="onDndToggle"
      />
    </view>
    
    <view class="settings-item" wx:if="{{dndEnabled}}">
      <view class="settings-item__info">
        <text class="settings-item__name">开始时间</text>
      </view>
      <picker mode="time" value="{{dndStartTime}}" bindchange="onDndStartTimeChange">
        <view class="settings-item__picker">
          <text class="settings-item__value">{{dndStartTime}}</text>
          <text class="settings-item__arrow">›</text>
        </view>
      </picker>
    </view>
    
    <view class="settings-item" wx:if="{{dndEnabled}}">
      <view class="settings-item__info">
        <text class="settings-item__name">结束时间</text>
      </view>
      <picker mode="time" value="{{dndEndTime}}" bindchange="onDndEndTimeChange">
        <view class="settings-item__picker">
          <text class="settings-item__value">{{dndEndTime}}</text>
          <text class="settings-item__arrow">›</text>
        </view>
      </picker>
    </view>
    
    <view class="settings-item">
      <view class="settings-item__info">
        <text class="settings-item__name">每日推荐时间</text>
        <text class="settings-item__desc">每天{{recommendTime}}推送精选内容</text>
      </view>
      <picker mode="time" value="{{recommendTime}}" bindchange="onRecommendTimeChange">
        <view class="settings-item__picker">
          <text class="settings-item__value">{{recommendTime}}</text>
          <text class="settings-item__arrow">›</text>
        </view>
      </picker>
    </view>
  </view>
  
  <view class="settings-section">
    <view class="settings-header">
      <text class="settings-title">通知内容</text>
      <text class="settings-preview-tag">即将上线</text>
      <text class="settings-desc">选择您想接收的通知类型</text>
    </view>
    
    <view class="settings-item" wx:for="{{notificationTypes}}" wx:key="key">
      <view class="settings-item__info">
        <text class="settings-item__name">{{item.name}}</text>
        <text class="settings-item__desc">{{item.description}}</text>
      </view>
      <switch 
        checked="{{item.enabled}}" 
        color="#3B6D11"
        data-key="{{item.key}}"
        bindchange="onNotificationTypeToggle"
      />
    </view>
  </view>
  
  <view class="settings-footer">
    <view class="settings-tip">
      <text class="settings-tip__icon">💡</text>
      <view class="settings-tip__body">
        <text class="settings-tip__text">通知设置仅影响本设备，不会同步到其他设备</text>
        <text class="settings-tip__hint">推送通知功能需上线后接入云端服务才能实际生效，当前为功能预览状态</text>
      </view>
    </view>
  </view>
</view>