/* components/review-modal/review-modal.wxss */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal {
  width: 100%;
  max-height: 80vh;
  background-color: #FAF8F3;
  border-radius: 24rpx 24rpx 0 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 0.5px solid #EAE5DC;
}

.modal__title {
  font-size: 32rpx;
  font-weight: 500;
  color: #2C2C2A;
  letter-spacing: 2rpx;
}

.modal__close {
  font-size: 32rpx;
  color: #8B8578;
  padding: 8rpx;
}

.modal__body {
  flex: 1;
  overflow-y: auto;
  padding: 24rpx 32rpx;
}

.modal__section {
  margin-bottom: 32rpx;
}

.modal__label {
  font-size: 26rpx;
  color: #5A554C;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
}

.modal__score {
  font-size: 36rpx;
  font-weight: 500;
  color: #3B6D11;
  margin-left: 16rpx;
}

.modal__rating-desc {
  font-size: 24rpx;
  color: #8B8578;
  margin-left: 8rpx;
}

.modal__slider-labels {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #B0A99A;
  margin-top: 4rpx;
}

.modal__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.modal__tag {
  font-size: 24rpx;
  color: #5A554C;
  background-color: #F3EFE6;
  border: 0.5px solid #EAE5DC;
  border-radius: 24rpx;
  padding: 12rpx 28rpx;
  transition: all 0.2s;
}

.modal__tag--active {
  background-color: #3B6D11;
  color: #FFFFFF;
  border-color: #3B6D11;
}

.modal__textarea {
  width: 100%;
  height: 200rpx;
  font-size: 28rpx;
  color: #2C2C2A;
  background-color: #FFFFFF;
  border: 0.5px solid #EAE5DC;
  border-radius: 12px;
  padding: 20rpx;
  box-sizing: border-box;
  line-height: 1.6;
}

.modal__count {
  font-size: 22rpx;
  color: #B0A99A;
  text-align: right;
  margin-top: 8rpx;
  display: block;
}

.modal__footer {
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-top: 0.5px solid #EAE5DC;
}

.modal__submit {
  width: 100%;
  height: 88rpx;
  background-color: #3B6D11;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal__submit--disabled {
  opacity: 0.6;
}
