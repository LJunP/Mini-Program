/* pages/profile/profile.wxss */

/* 积分等级进度条 */
.points-bar {
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.points-bar__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.points-bar__level {
  font-size: 28rpx;
  font-weight: 600;
}
.points-bar__next {
  font-size: 22rpx;
  color: #8B8578;
}
.points-bar__next--max {
  color: #3B6D11;
}
.points-bar__track {
  height: 10rpx;
  background-color: #F3EFE6;
  border-radius: 5px;
  overflow: hidden;
}
.points-bar__fill {
  height: 100%;
  border-radius: 5px;
  transition: width 0.4s ease;
}

/* 用户卡片等级显示 */
.user-card__level {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
}
.user-card__level-name {
  font-size: 22rpx;
  font-weight: 500;
  background-color: #F0F7E6;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}
.user-card__level-points {
  font-size: 22rpx;
  color: #8B8578;
}

/* 徽章预览 */
.badge-preview {
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.badge-preview__list {
  display: flex;
  gap: 16rpx;
  overflow: hidden;
}
.badge-item {
  flex-shrink: 0;
  width: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 8rpx;
  border-radius: 12rpx;
  background-color: #FAF8F3;
}
.badge-item--locked {
  opacity: 0.45;
}
.badge-item--more {
  background-color: #F0F7E6;
}
.badge-item__icon {
  font-size: 36rpx;
}
.badge-item__name {
  font-size: 20rpx;
  color: #5A554C;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}

/* 通知预览标签 */
.subscribe-card__title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.subscribe-card__preview-tag {
  font-size: 18rpx;
  color: #A0522D;
  background-color: #FFF3E0;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  line-height: 1.4;
}

/* 每日签到 */
.sign-card {
  padding: 32rpx 24rpx;
}
.sign-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.sign-card__info {
  display: flex;
  align-items: baseline;
}
.sign-card__days {
  font-size: 48rpx;
  font-weight: 500;
  color: #3B6D11;
  margin-right: 12rpx;
}
.sign-card__label {
  font-size: 24rpx;
  color: #8B8578;
}
.sign-card__btn {
  padding: 16rpx 40rpx;
  background-color: #3B6D11;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 32rpx;
  letter-spacing: 2rpx;
}
.sign-card__btn--done {
  background-color: #EAE5DC;
  color: #B5B0A6;
}
.sign-calendar {
  display: flex;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 0.5px solid #EAE5DC;
}
.sign-calendar__day {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.sign-calendar__name {
  font-size: 22rpx;
  color: #8B8578;
}
.sign-calendar__dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #EAE5DC;
}
.sign-calendar__day--signed .sign-calendar__dot {
  background-color: #3B6D11;
}
.sign-calendar__day--today .sign-calendar__name {
  color: #3B6D11;
  font-weight: 500;
}
.sign-calendar__day--today .sign-calendar__dot {
  border: 2px solid #3B6D11;
}

/* 用户卡片 */
.user-card {
  display: flex;
  align-items: center;
  background-color: #FFFFFFFC;
  border: 0.5px solid #EAE5DC;
  border-radius: 12px;
  padding: 32rpx 24rpx;
  margin: 16rpx 0 32rpx;
}
.user-card__avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.user-card__avatar-text {
  font-size: 36rpx;
  color: #FFFFFF;
  font-weight: 500;
  letter-spacing: 2rpx;
}
.user-card__info {
  flex: 1;
}
.user-card__name {
  font-size: 36rpx;
  font-weight: 500;
  color: #2C2C2A;
  display: block;
}
.user-card__bio {
  font-size: 24rpx;
  color: #8B8578;
  margin-top: 8rpx;
  display: block;
}

/* 风雅人格 */
.persona {
  padding-bottom: 24rpx;
  border-bottom: 0.5px solid #EAE5DC;
  margin-bottom: 24rpx;
}
.persona__name {
  font-size: 32rpx;
  font-weight: 500;
  color: #3B6D11;
  display: block;
  letter-spacing: 4rpx;
}
.persona__desc {
  font-size: 24rpx;
  color: #5A554C;
  margin-top: 8rpx;
  line-height: 1.6;
  display: block;
}

/* 六雅进度条 */
.affinity__item {
  margin-bottom: 24rpx;
}
.affinity__item:last-child {
  margin-bottom: 0;
}
.affinity__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.affinity__value {
  font-size: 24rpx;
  color: #8B8578;
}
.affinity__bar {
  height: 8rpx;
  background-color: #F3EFE6;
  border-radius: 4px;
  overflow: hidden;
}
.affinity__bar-inner {
  height: 100%;
  border-radius: 4px;
  transition: width 0.3s ease;
}

/* 风雅足迹 */
.footprint {
  display: flex;
  align-items: center;
  padding: 32rpx 24rpx;
}
.footprint__item {
  flex: 1;
  text-align: center;
}
.footprint__num {
  font-size: 40rpx;
  font-weight: 500;
  color: #2C2C2A;
  display: block;
}
.footprint__label {
  font-size: 22rpx;
  color: #8B8578;
  margin-top: 8rpx;
  display: block;
}
.footprint__divider {
  width: 0.5px;
  height: 60rpx;
  background-color: #EAE5DC;
}

/* 学习统计 */
.study-card {
  padding: 28rpx 24rpx;
}
.study-card__grid {
  display: flex;
  align-items: center;
}
.study-card__item {
  flex: 1;
  text-align: center;
}
.study-card__num {
  display: block;
  font-size: 40rpx;
  font-weight: 500;
  color: #2C2C2A;
}
.study-card__num--weak {
  color: #A0522D;
}
.study-card__label {
  display: block;
  font-size: 22rpx;
  color: #8B8578;
  margin-top: 8rpx;
}
.study-card__review {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 0.5px solid #EAE5DC;
  color: #854F0B;
  font-size: 26rpx;
}
.study-card__arrow {
  font-size: 32rpx;
  color: #B5B0A6;
  margin-left: 12rpx;
}

/* 最近浏览 */
.browse-list {
  background-color: #FFFFFFFC;
  border: 0.5px solid #EAE5DC;
  border-radius: 12px;
  overflow: hidden;
  margin-bottom: 32rpx;
}
.browse-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 0.5px solid #EAE5DC;
}
.browse-item:last-child {
  border-bottom: none;
}
.browse-item__name {
  flex: 1;
  font-size: 26rpx;
  color: #2C2C2A;
  margin-left: 16rpx;
}
.browse-item__date {
  font-size: 22rpx;
  color: #B5B0A6;
}

/* 风雅足迹 - 第二行 */
.footprint + .footprint {
  border-top: none;
  border-radius: 0 0 12px 12px;
}

/* 菜单 */
.menu {
  background-color: #FFFFFFFC;
  border: 0.5px solid #EAE5DC;
  border-radius: 12px;
  overflow: hidden;
}
.menu__item {
  display: flex;
  align-items: center;
  padding: 32rpx 24rpx;
  border-bottom: 0.5px solid #EAE5DC;
}
.menu__item:last-child {
  border-bottom: none;
}
.menu__label {
  flex: 1;
  font-size: 28rpx;
  color: #2C2C2A;
}
.menu__value {
  font-size: 24rpx;
  color: #8B8578;
  margin-right: 16rpx;
}
.menu__arrow {
  font-size: 32rpx;
  color: #B5B0A6;
}

/* 消息订阅 */
.subscribe-card {
  padding: 32rpx 24rpx;
  margin-bottom: 32rpx;
}
.subscribe-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.subscribe-card__title {
  font-size: 32rpx;
  font-weight: 500;
  color: #2C2C2A;
}
.subscribe-card__count {
  font-size: 24rpx;
  color: #3B6D11;
  background-color: #F0F7E6;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
}
.subscribe-card__desc {
  margin-bottom: 24rpx;
}
.subscribe-card__desc text {
  font-size: 24rpx;
  color: #8B8578;
  line-height: 1.6;
}
.subscribe-card__list {
  border-top: 0.5px solid #EAE5DC;
  padding-top: 24rpx;
}
.subscribe-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.subscribe-item__info {
  flex: 1;
}
.subscribe-item__name {
  font-size: 28rpx;
  color: #2C2C2A;
  display: block;
  margin-bottom: 8rpx;
}
.subscribe-item__status {
  font-size: 22rpx;
  color: #8B8578;
  display: block;
}
.subscribe-item__arrow {
  font-size: 32rpx;
  color: #B5B0A6;
  margin-left: 16rpx;
}

/* 投稿横幅 */
.contribute-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  margin-bottom: 32rpx;
}
.contribute-banner__left {
  display: flex;
  align-items: center;
}
.contribute-banner__icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #F0F7E6 0%, #E8F0D8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}
.contribute-banner__icon text {
  font-size: 40rpx;
}
.contribute-banner__info {
  display: flex;
  flex-direction: column;
}
.contribute-banner__title {
  font-size: 30rpx;
  font-weight: 500;
  color: #2C2C2A;
}
.contribute-banner__desc {
  font-size: 22rpx;
  color: #8B8578;
  margin-top: 4rpx;
}
.contribute-banner__right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.contribute-banner__count {
  font-size: 32rpx;
  font-weight: 500;
  color: #3B6D11;
}
.contribute-banner__arrow {
  font-size: 36rpx;
  color: #B5B0A6;
}

/* 未登录态样式 */
.user-card--unlogged {
  background: linear-gradient(135deg, #FAF8F5 0%, #F5F3EF 100%);
  border: 1px dashed #D4CFC4;
  cursor: pointer;
  position: relative;
  overflow: hidden;
}
.user-card--unlogged::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 200rpx;
  height: 100%;
  background: linear-gradient(90deg, transparent 0%, rgba(59, 109, 17, 0.03) 100%);
  pointer-events: none;
}
.user-card__avatar--default {
  background: linear-gradient(135deg, #07C160 0%, #05A350 100%) !important;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.25);
}
.user-card__avatar--default .user-card__avatar-text {
  font-size: 40rpx;
  font-weight: 600;
}
.user-card__login-btn {
  background: linear-gradient(135deg, #07C160 0%, #05A350 100%);
  padding: 16rpx 32rpx;
  border-radius: 32rpx;
  margin-left: auto;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
  /* button 默认样式重置 */
  margin: 0 0 0 auto;
  border: none;
  line-height: inherit;
  font-size: inherit;
}
.user-card__login-btn::after {
  border: none;
}
.user-card__login-text {
  font-size: 26rpx;
  color: #FFFFFF;
  font-weight: 500;
}
.user-card__avatar-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
}
.user-card__arrow {
  font-size: 36rpx;
  color: #B5B0A6;
  margin-left: auto;
}
.card--disabled {
  opacity: 0.65;
  pointer-events: none;
}
.sign-calendar-placeholder {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 32rpx 0;
  border-top: 0.5px solid #EAE5DC;
}
.placeholder-text {
  font-size: 24rpx;
  color: #8B8578;
  font-style: italic;
}
.persona--unlogged .persona__name {
  color: #8B8578;
}
.affinity-placeholder {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.affinity-placeholder__item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.affinity-placeholder__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.affinity-placeholder__name {
  font-size: 24rpx;
  color: #8B8578;
}
.affinity-placeholder__value {
  font-size: 24rpx;
  color: #B5B0A6;
}
.affinity-placeholder__bar {
  height: 8rpx;
  background-color: #F3EFE6;
  border-radius: 4px;
  width: 100%;
}
