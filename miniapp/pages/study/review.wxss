/* pages/study/review.wxss */
.page-header {
  padding: 32rpx 16rpx 24rpx;
}
.page-header__title {
  font-size: 44rpx;
  font-weight: 500;
  color: #2C2C2A;
  letter-spacing: 8rpx;
}
.page-header__sub {
  display: block;
  font-size: 24rpx;
  color: #8B8578;
  margin-top: 8rpx;
  letter-spacing: 2rpx;
}

/* Tab 切换 */
.review-tabs {
  display: flex;
  gap: 0;
  padding: 0 16rpx;
  margin-bottom: 8rpx;
  border-bottom: 0.5px solid #EAE5DC;
}
.review-tabs__item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #8B8578;
  position: relative;
  transition: color 0.2s ease;
}
.review-tabs__item--active {
  color: #854F0B;
  font-weight: 500;
}
.review-tabs__item--active::after {
  content: '';
  position: absolute;
  bottom: -1rpx;
  left: 25%;
  right: 25%;
  height: 4rpx;
  background: #854F0B;
  border-radius: 2rpx;
}
.review-tabs__count {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: #F3EFE6;
  color: #8B8578;
}
.review-tabs__count--wrong {
  background: rgba(160, 82, 45, 0.12);
  color: #A0522D;
}

/* 错题统计 */
.wrong-stats {
  display: flex;
  justify-content: space-around;
  padding: 24rpx 16rpx;
  margin: 16rpx;
  background: #FFFFFFFC;
  border: 0.5px solid #EAE5DC;
  border-radius: 12px;
}

/* 今日复习统计 */
.review-stats {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  margin: 16rpx;
  background: #FFFFFFFC;
  border: 0.5px solid #EAE5DC;
  border-radius: 12px;
}
.review-stats__item {
  display: flex;
  flex-direction: column;
}
.review-stats__value {
  font-size: 40rpx;
  font-weight: 500;
  color: #3B6D11;
}
.review-stats__value--muted {
  font-size: 24rpx;
  font-weight: 400;
  color: #8B8578;
}
.review-stats__label {
  font-size: 22rpx;
  color: #8B8578;
  margin-top: 4rpx;
}
.wrong-stats__item {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.wrong-stats__value {
  font-size: 40rpx;
  font-weight: 500;
  color: #2C2C2A;
}
.wrong-stats__value--weak {
  color: #A0522D;
}
.wrong-stats__value--mastered {
  color: #3B6D11;
}
.wrong-stats__label {
  font-size: 22rpx;
  color: #8B8578;
  margin-top: 4rpx;
}

/* 题目列表 */
.question-list {
  padding: 16rpx 16rpx 32rpx;
}

/* 翻转卡片容器 */
.flip-card {
  perspective: 1200rpx;
  margin-bottom: 20rpx;
}
.flip-card__front,
.flip-card__back {
  transition: opacity 0.3s ease;
}
.flip-card__back {
  display: none;
}
.flip-card--flipped .flip-card__front {
  display: none;
}
.flip-card--flipped .flip-card__back {
  display: block;
}

/* 题目卡片 */
.question-card {
  background-color: #FFFFFFFC;
  border: 0.5px solid #EAE5DC;
  border-radius: 12px;
  padding: 28rpx;
}
.question-card--wrong {
  border-left: 4rpx solid #A0522D;
}
.question-card--back {
  border-left: 4rpx solid #3B6D11;
}
.question-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.question-card__type {
  color: #854F0B;
  background-color: rgba(133, 79, 11, 0.1);
  border-radius: 4px;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
}
.question-card__type--mastered {
  color: #3B6D11;
  background-color: rgba(59, 109, 17, 0.1);
}
.question-card__type--answer {
  color: #4A6B7C;
  background-color: rgba(74, 107, 124, 0.1);
}
.question-card__meta {
  color: #8B8578;
  font-size: 22rpx;
}
.question-card__title {
  display: block;
  color: #2C2C2A;
  font-size: 34rpx;
  font-weight: 500;
  line-height: 1.5;
}
.question-card__question {
  display: block;
  color: #5A554C;
  font-size: 26rpx;
  line-height: 1.7;
  margin-top: 12rpx;
}
.question-card__answer {
  display: block;
  color: #3B6D11;
  font-size: 26rpx;
  line-height: 1.8;
  margin-top: 12rpx;
}
.question-card__track {
  display: inline-block;
  margin-top: 12rpx;
  font-size: 20rpx;
  color: #B0A99A;
  padding: 2rpx 12rpx;
  background: #F4F0E8;
  border-radius: 4rpx;
}

/* 记忆曲线信息栏 */
.memory-bar {
  display: flex;
  justify-content: space-around;
  padding: 16rpx 0;
  margin-bottom: 16rpx;
  border-bottom: 0.5px solid #F4F0E8;
}
.memory-bar__item {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.memory-bar__label {
  font-size: 20rpx;
  color: #B0A99A;
  margin-bottom: 4rpx;
}
.memory-bar__value {
  font-size: 26rpx;
  font-weight: 500;
  color: #2C2C2A;
}
.memory-bar__value--mastered {
  color: #3B6D11;
}
.memory-bar__value--weak {
  color: #A0522D;
}
.memory-bar__value--learning {
  color: #854F0B;
}
.memory-bar__value--next {
  color: #4A6B7C;
}
.memory-bar__meta {
  font-size: 20rpx;
  color: #B0A99A;
  margin-left: 12rpx;
}

/* 记忆等级可视化 */
.memory-level {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0;
  margin-bottom: 12rpx;
}
.memory-level__progress {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.memory-level__track {
  flex: 1;
  height: 8rpx;
  background-color: rgba(139, 133, 120, 0.15);
  border-radius: 4rpx;
  overflow: hidden;
}
.memory-level__fill {
  height: 100%;
  background: linear-gradient(90deg, #854F0B 0%, #3B6D11 100%);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}
.memory-level__dots {
  display: flex;
  gap: 6rpx;
}
.memory-level__dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: rgba(139, 133, 120, 0.15);
}
.memory-level__dot--active {
  background-color: #3B6D11;
}
.memory-level__text {
  font-size: 22rpx;
  color: #3B6D11;
  font-weight: 500;
}

/* 操作按钮 */
.question-card__actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 24rpx;
  border-top: 0.5px solid #F4F0E8;
  padding-top: 18rpx;
  flex-wrap: wrap;
}
.action-btn {
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 6px;
  font-weight: 500;
  text-align: center;
}
.action-btn--master {
  color: #3B6D11;
  background-color: rgba(59, 109, 17, 0.08);
  border: 0.5px solid rgba(59, 109, 17, 0.2);
}
.action-btn--wrong {
  color: #A0522D;
  background-color: rgba(160, 82, 45, 0.08);
  border: 0.5px solid rgba(160, 82, 45, 0.2);
}
.action-btn--remove {
  color: #8B8578;
  background-color: #F3EFE6;
  border: 0.5px solid #EAE5DC;
}
.action-btn--flip {
  color: #4A6B7C;
  background-color: rgba(74, 107, 124, 0.08);
  border: 0.5px solid rgba(74, 107, 124, 0.2);
}
