/* components/domain-tag/domain-tag.wxss */
.domain-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  line-height: 1.5;
  border-radius: 6rpx;
  letter-spacing: 2rpx;
}
.domain-tag--small {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
}
.domain-tag--large {
  font-size: 26rpx;
  padding: 6rpx 20rpx;
}
