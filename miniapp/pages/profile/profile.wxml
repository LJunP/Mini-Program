<!-- pages/profile/profile.wxml -->
<view class="page-bg">

  <!-- 用户信息卡 (已登录) -->
  <view class="user-card" wx:if="{{isLoggedIn}}" bindtap="goEditProfile">
    <view class="user-card__avatar" style="background-color:{{avatarBgColor || '#3B6D11'}};">
      <image wx:if="{{user.avatarUrl || user.avatar_url}}" src="{{user.avatarUrl || user.avatar_url}}" mode="aspectFill" class="user-card__avatar-img" />
      <text wx:else class="user-card__avatar-text">{{avatarText}}</text>
    </view>
    <view class="user-card__info">
      <text class="user-card__name">{{user.nickname}}</text>
      <view class="user-card__level" wx:if="{{levelInfo}}">
        <text class="user-card__level-name" style="color:{{levelInfo.level.color}};">{{levelInfo.level.name}}</text>
        <text class="user-card__level-points">{{points}}积分</text>
      </view>
    </view>
    <text class="user-card__arrow">›</text>
  </view>

  <!-- 用户信息卡 (未登录) -->
  <view class="user-card user-card--unlogged" wx:else>
    <view class="user-card__avatar user-card__avatar--default">
      <text class="user-card__avatar-text">微</text>
    </view>
    <view class="user-card__info">
      <text class="user-card__name">点击登录</text>
      <text class="user-card__bio">同步微信昵称与头像</text>
    </view>
    <button class="user-card__login-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
      <text class="user-card__login-text">一键登录</text>
    </button>
  </view>

  <!-- 积分等级进度条 -->
  <view class="points-bar card" wx:if="{{isLoggedIn && levelInfo}}">
    <view class="points-bar__header">
      <text class="points-bar__level" style="color:{{levelInfo.level.color}};">{{levelInfo.level.name}}</text>
      <text class="points-bar__next" wx:if="{{levelInfo.nextLevel}}">距{{levelInfo.nextLevel.name}}还差{{levelInfo.nextLevel.min - points}}分</text>
      <text class="points-bar__next points-bar__next--max" wx:else>已达最高等级</text>
    </view>
    <view class="points-bar__track">
      <view class="points-bar__fill" style="width:{{levelInfo.progress}}%;background-color:{{levelInfo.level.color}};"></view>
    </view>
  </view>

  <!-- 每日签到 -->
  <view class="section-title">每日签到</view>
  <view class="sign-card card {{!isLoggedIn ? 'card--disabled' : ''}}">
    <view class="sign-card__header">
      <view class="sign-card__info">
        <text class="sign-card__days">{{isLoggedIn ? signDays : 0}}</text>
        <text class="sign-card__label">连续签到天数</text>
      </view>
      <view class="sign-card__btn {{signedToday || !isLoggedIn ? 'sign-card__btn--done' : ''}}" bindtap="onSignTap">
        <text>{{!isLoggedIn ? '请先登录' : (signedToday ? '已签到' : '签到')}}</text>
      </view>
    </view>
    <view class="sign-calendar" wx:if="{{isLoggedIn}}">
      <view wx:for="{{signDates}}" wx:key="date" class="sign-calendar__day {{item.signed ? 'sign-calendar__day--signed' : ''}} {{item.isToday ? 'sign-calendar__day--today' : ''}}">
        <text class="sign-calendar__name">{{item.day}}</text>
        <view class="sign-calendar__dot"></view>
      </view>
    </view>
    <view class="sign-calendar-placeholder" wx:else>
      <text class="placeholder-text">登录后开启每日签到，赢取风雅积分</text>
    </view>
  </view>

  <!-- 风雅偏好 -->
  <view class="section-title">风雅偏好</view>
  <view class="card {{!isLoggedIn ? 'card--disabled' : ''}}">
    <view class="persona" wx:if="{{isLoggedIn}}">
      <text class="persona__name">{{persona}}</text>
      <text class="persona__desc">{{personaDesc}}</text>
    </view>
    <view class="persona persona--unlogged" wx:else>
      <text class="persona__name">风雅画像未解锁</text>
      <text class="persona__desc">基于品茶、行旅及日常习惯，测定你的传统文化风雅人格</text>
    </view>

    <!-- 六雅进度条 -->
    <view class="affinity" wx:if="{{isLoggedIn}}">
      <view
        wx:for="{{affinityList}}"
        wx:key="key"
        class="affinity__item"
      >
        <view class="affinity__header">
          <domain-tag domain="{{item.key}}" size="small" />
          <text class="affinity__value">{{item.value}}</text>
        </view>
        <view class="affinity__bar">
          <view class="affinity__bar-inner" style="width:{{item.value}}%;background-color:{{item.color}};"></view>
        </view>
      </view>
    </view>
    <view class="affinity-placeholder" wx:else>
      <view class="affinity-placeholder__item" wx:for="{{[{name:'茶', color:'#3B6D11'}, {name:'游', color:'#5B8C85'}, {name:'养', color:'#A0522D'}, {name:'香', color:'#8B6F47'}, {name:'音', color:'#4A6B7C'}, {name:'影', color:'#2C2C2A'}]}}" wx:key="name">
        <view class="affinity-placeholder__header">
          <text class="affinity-placeholder__name">{{item.name}}</text>
          <text class="affinity-placeholder__value">-</text>
        </view>
        <view class="affinity-placeholder__bar"></view>
      </view>
    </view>
  </view>

  <!-- 风雅足迹 -->
  <view class="section-title">风雅足迹</view>
  <view class="footprint card {{!isLoggedIn ? 'card--disabled' : ''}}">
    <view class="footprint__item">
      <text class="footprint__num">{{isLoggedIn ? footprint.teasTasted : '-'}}</text>
      <text class="footprint__label">品过的茶</text>
    </view>
    <view class="footprint__divider"></view>
    <view class="footprint__item">
      <text class="footprint__num">{{isLoggedIn ? footprint.placesVisited : '-'}}</text>
      <text class="footprint__label">读过的行旅</text>
    </view>
    <view class="footprint__divider"></view>
    <view class="footprint__item">
      <text class="footprint__num">{{isLoggedIn ? footprint.filmsWatched : '-'}}</text>
      <text class="footprint__label">看过的影</text>
    </view>
    <view class="footprint__divider"></view>
    <view class="footprint__item">
      <text class="footprint__num">{{isLoggedIn ? footprint.musicListened : '-'}}</text>
      <text class="footprint__label">听过的曲</text>
    </view>
  </view>
  <view class="footprint card {{!isLoggedIn ? 'card--disabled' : ''}}" style="margin-top:0;border-top:none;border-radius:0 0 12px 12px;">
    <view class="footprint__item">
      <text class="footprint__num">{{isLoggedIn ? footprint.habitsKept : '-'}}</text>
      <text class="footprint__label">坚持的习惯</text>
    </view>
    <view class="footprint__divider"></view>
    <view class="footprint__item">
      <text class="footprint__num">{{isLoggedIn ? footprint.incenseBurned : '-'}}</text>
      <text class="footprint__label">焚过的香</text>
    </view>
    <view class="footprint__divider"></view>
    <view class="footprint__item">
      <text class="footprint__num">{{isLoggedIn ? collectionCount : '-'}}</text>
      <text class="footprint__label">收藏的书签</text>
    </view>
    <view class="footprint__divider"></view>
    <view class="footprint__item">
      <text class="footprint__num">{{isLoggedIn ? earnedBadgeCount : '-'}}</text>
      <text class="footprint__label">解锁徽章</text>
    </view>
  </view>

  <!-- 徽章预览 -->
  <view class="section-title" wx:if="{{isLoggedIn}}">风雅徽章</view>
  <view class="badge-preview card" wx:if="{{isLoggedIn}}" bindtap="goBadges">
    <view class="badge-preview__list">
      <view class="badge-item {{!item.earned ? 'badge-item--locked' : ''}}" wx:for="{{recentBadges}}" wx:key="id">
        <text class="badge-item__icon">{{item.earned ? item.icon : '🔒'}}</text>
        <text class="badge-item__name">{{item.name}}</text>
      </view>
      <view class="badge-item badge-item--more" wx:if="{{earnedBadgeCount > 4 || earnedBadgeCount === 0}}">
        <text class="badge-item__icon">{{earnedBadgeCount}}/{{totalBadgeCount}}</text>
        <text class="badge-item__name">{{earnedBadgeCount > 0 ? '全部' : '待解锁'}}</text>
      </view>
    </view>
  </view>

  <!-- 学习统计 -->
  <view class="section-title">学习统计</view>
  <view class="study-card card {{!isLoggedIn ? 'card--disabled' : ''}}" bindtap="goStudyHome">
    <view class="study-card__grid">
      <view class="study-card__item">
        <text class="study-card__num">{{isLoggedIn ? studyStats.pendingCount : '-'}}</text>
        <text class="study-card__label">待学习</text>
      </view>
      <view class="study-card__item">
        <text class="study-card__num">{{isLoggedIn ? studyStats.learningCount : '-'}}</text>
        <text class="study-card__label">学习中</text>
      </view>
      <view class="study-card__item">
        <text class="study-card__num">{{isLoggedIn ? studyStats.masteredCount : '-'}}</text>
        <text class="study-card__label">已掌握</text>
      </view>
      <view class="study-card__item">
        <text class="study-card__num study-card__num--weak">{{isLoggedIn ? studyStats.weakCount : '-'}}</text>
        <text class="study-card__label">薄弱点</text>
      </view>
    </view>
    <view class="study-card__review" catchtap="goStudyReview">
      <text>{{isLoggedIn ? '今日待复习 ' + studyStats.reviewCount + ' 项' : '登录后开始学习'}}</text>
      <text class="study-card__arrow">›</text>
    </view>
  </view>

  <!-- 我的投稿快捷入口 -->
  <view class="contribute-banner card" bindtap="goContributeList">
    <view class="contribute-banner__left">
      <view class="contribute-banner__icon">
        <text>✍️</text>
      </view>
      <view class="contribute-banner__info">
        <text class="contribute-banner__title">我的投稿</text>
        <text class="contribute-banner__desc">记录风雅感悟，留下生活痕迹</text>
      </view>
    </view>
    <view class="contribute-banner__right">
      <text class="contribute-banner__count" wx:if="{{isLoggedIn}}">{{ugcCount}}</text>
      <text class="contribute-banner__arrow">›</text>
    </view>
  </view>

  <!-- 工具箱（合并入口） -->
  <view class="section-title">工具箱</view>
  <view class="menu">
    <view class="menu__item" bindtap="goStudyHome">
      <text class="menu__label">面试题库</text>
      <text class="menu__value">901题</text>
      <text class="menu__arrow">›</text>
    </view>
    <view class="menu__item" bindtap="goDnfCalculator">
      <text class="menu__label">DNF 礼包计算器</text>
      <text class="menu__value">回血计算</text>
      <text class="menu__arrow">›</text>
    </view>
    <view class="menu__item" bindtap="goGoldPurchase">
      <text class="menu__label">金币采购估算器</text>
      <text class="menu__value">收币→寄售→购买</text>
      <text class="menu__arrow">›</text>
    </view>
  </view>

  <!-- 最近浏览 -->
  <view class="section-title" wx:if="{{isLoggedIn && recentBrowse.length}}">最近浏览</view>
  <view class="browse-list" wx:if="{{isLoggedIn && recentBrowse.length}}">
    <view
      wx:for="{{recentBrowse}}"
      wx:key="refId"
      class="browse-item"
      data-domain="{{item.domain}}"
      data-id="{{item.refId}}"
      bindtap="onBrowseTap"
    >
      <domain-tag domain="{{item.domain}}" size="small" />
      <text class="browse-item__name">{{item.name}}</text>
      <text class="browse-item__date">{{item.date}}</text>
    </view>
  </view>

  <!-- 消息订阅 -->
  <view class="section-title">消息订阅</view>
  <view class="subscribe-card card {{!isLoggedIn ? 'card--disabled' : ''}}" bindtap="showSubscribeSetting">
    <view class="subscribe-card__header">
      <view class="subscribe-card__title-row">
        <text class="subscribe-card__title">订阅通知</text>
        <text class="subscribe-card__preview-tag">功能预览</text>
      </view>
      <text class="subscribe-card__count">{{isLoggedIn ? subscribeEnabledCount : 0}}项已开启</text>
    </view>
    <view class="subscribe-card__desc">
      <text>开启订阅后，可及时获取内容更新、签到提醒等通知</text>
    </view>
    <view class="subscribe-card__list" wx:if="{{isLoggedIn}}">
      <view class="subscribe-item">
        <view class="subscribe-item__info">
          <text class="subscribe-item__name">管理订阅设置</text>
          <text class="subscribe-item__status">{{subscribeEnabledCount > 0 ? '已开启部分订阅' : '未开启任何订阅'}}</text>
        </view>
        <text class="subscribe-item__arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 功能入口 -->
  <view class="section-title">更多</view>
  <view class="menu">
    <view class="menu__item" bindtap="goBookmark">
      <text class="menu__label">我的书签</text>
      <text class="menu__value">{{isLoggedIn ? collectionCount : '-'}}</text>
      <text class="menu__arrow">›</text>
    </view>
    <view class="menu__item" bindtap="goHistory">
      <text class="menu__label">浏览历史</text>
      <text class="menu__arrow">›</text>
    </view>
    <view class="menu__item" bindtap="goSetting">
      <text class="menu__label">设置</text>
      <text class="menu__arrow">›</text>
    </view>
    <view class="menu__item" bindtap="goAbout">
      <text class="menu__label">关于妙不可园</text>
      <text class="menu__arrow">›</text>
    </view>
    <view class="menu__item" bindtap="showPrivacy">
      <text class="menu__label">隐私政策</text>
      <text class="menu__arrow">›</text>
    </view>
    <view class="menu__item" bindtap="showAgreement">
      <text class="menu__label">用户协议</text>
      <text class="menu__arrow">›</text>
    </view>
    <view class="menu__item" bindtap="showFeedback">
      <text class="menu__label">意见反馈</text>
      <text class="menu__arrow">›</text>
    </view>
    <view class="menu__item" bindtap="showHelp">
      <text class="menu__label">使用帮助</text>
      <text class="menu__arrow">›</text>
    </view>
  </view>
</view>
