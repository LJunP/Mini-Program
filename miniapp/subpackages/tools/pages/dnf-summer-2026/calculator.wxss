/* subpackages/tools/pages/dnf-summer-2026/calculator.wxss */
/* DNF 2026夏日礼包回血计算器样式 */

/* ============ 页面容器 ============ */
.calc-page {
  min-height: 100vh;
  background-color: #f5f3ee;
  padding: 24rpx 24rpx 80rpx;
  box-sizing: border-box;
}

/* ============ 注意栏 ============ */
.notice-bar {
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.notice-bar__item {
  font-size: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  line-height: 1.6;
}
.notice-bar__item--warn {
  background: rgba(231, 76, 60, 0.08);
  border: 1rpx solid rgba(231, 76, 60, 0.2);
  color: #c0392b;
  font-weight: 500;
}
.notice-bar__item--info {
  background: rgba(26, 26, 46, 0.05);
  border: 1rpx solid rgba(26, 26, 46, 0.12);
  color: #3a3a4a;
}

/* ============ 顶部信息卡 ============ */
.header-card {
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(26, 26, 46, 0.3);
}
.header-card::after {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -40rpx;
  width: 240rpx;
  height: 240rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.06) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}
.header-card__title {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
  position: relative;
  z-index: 1;
}
.header-card__sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.55);
  margin-top: 8rpx;
  letter-spacing: 2rpx;
  position: relative;
  z-index: 1;
}
.header-card__price {
  display: flex;
  align-items: baseline;
  margin-top: 28rpx;
  position: relative;
  z-index: 1;
}
.header-card__price-num {
  font-size: 52rpx;
  font-weight: 700;
  color: #ffc857;
  line-height: 1;
}
.header-card__price-unit {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-left: 12rpx;
}
.header-card__round {
  position: absolute;
  top: 40rpx;
  right: 32rpx;
  background: rgba(255, 200, 87, 0.15);
  border: 1rpx solid rgba(255, 200, 87, 0.3);
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
  font-size: 22rpx;
  color: #ffc857;
  z-index: 1;
}

/* ============ 通用 Section ============ */
.section {
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.section__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx;
  transition: background 0.2s;
}
.section__header:active {
  background: #f9f7f2;
}
.section__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  letter-spacing: 1rpx;
}
.section__arrow {
  font-size: 24rpx;
  color: #b0b0c0;
  transition: transform 0.3s ease;
  display: inline-block;
}
.section__arrow--open {
  transform: rotate(180deg);
}
.section__body {
  padding: 0 28rpx 28rpx;
}

/* ============ 表单字段 ============ */
.field {
  margin-bottom: 24rpx;
}
.field:last-child {
  margin-bottom: 0;
}
.field--row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.field__label {
  font-size: 28rpx;
  color: #3a3a4a;
  font-weight: 500;
  margin-bottom: 12rpx;
}
.field--row .field__label {
  margin-bottom: 0;
}
.field__input-wrap {
  display: flex;
  align-items: center;
  background: #f5f3ee;
  border-radius: 14rpx;
  padding: 0 20rpx;
  height: 80rpx;
  border: 2rpx solid transparent;
  transition: border-color 0.2s;
}
.field__input-wrap:focus-within {
  border-color: #1a1a2e;
}
.field__input {
  flex: 1;
  font-size: 30rpx;
  color: #1a1a2e;
  font-weight: 500;
  min-width: 0;
}
.field__input--small {
  font-size: 28rpx;
}
.field__unit {
  font-size: 24rpx;
  color: #9a9aaa;
  margin-left: 12rpx;
  flex-shrink: 0;
  white-space: nowrap;
}
.field__hint {
  font-size: 22rpx;
  color: #9a9aaa;
  margin-top: 8rpx;
  line-height: 1.5;
}

/* ============ 模式切换 Tab ============ */
.mode-tabs {
  display: flex;
  gap: 16rpx;
}
.mode-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 12rpx;
  border-radius: 14rpx;
  background: #f5f3ee;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}
.mode-tab--active {
  background: #1a1a2e;
  border-color: #1a1a2e;
}
.mode-tab__name {
  font-size: 28rpx;
  font-weight: 600;
  color: #6a6a7a;
}
.mode-tab--active .mode-tab__name {
  color: #ffc857;
}
.mode-tab__desc {
  font-size: 20rpx;
  color: #9a9aaa;
  margin-top: 6rpx;
}
.mode-tab--active .mode-tab__desc {
  color: rgba(255, 255, 255, 0.6);
}

/* ============ 金币寄售档位 ============ */
.consignment-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.consign-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.consign-row__label {
  font-size: 26rpx;
  color: #3a3a4a;
  font-weight: 500;
  min-width: 180rpx;
  flex-shrink: 0;
}
.consign-row__input {
  display: flex;
  align-items: center;
  flex: 1;
  background: #f5f3ee;
  border-radius: 14rpx;
  padding: 0 20rpx;
  height: 72rpx;
}

/* ============ 寄售档位输入 ============ */
.consign-tiers {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 16rpx;
}
.consign-tier {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.consign-tier__name {
  font-size: 26rpx;
  color: #3a3a4a;
  font-weight: 500;
  flex-shrink: 0;
}
.consign-tier__input {
  display: flex;
  align-items: center;
  background: #f5f3ee;
  border-radius: 14rpx;
  padding: 0 20rpx;
  height: 72rpx;
  min-width: 240rpx;
  flex: 1;
}

/* ============ 道具卡片 ============ */
.item-card {
  background: #faf9f5;
  border: 1rpx solid #ece8de;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  transition: all 0.2s;
}
.item-card:last-child {
  margin-bottom: 0;
}
.item-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.item-card__name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}
.item-card__check {
  flex-shrink: 0;
  transform: scale(0.85);
}
.item-card__name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.item-card__badge {
  display: inline-block;
  font-size: 18rpx;
  color: #fff;
  background: linear-gradient(135deg, #e74c3c, #c0392b);
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
  line-height: 1.5;
}
.item-card__per {
  font-size: 24rpx;
  color: #9a9aaa;
  flex-shrink: 0;
  margin-left: 12rpx;
}
.item-card__source {
  font-size: 22rpx;
  color: #7a7a8a;
  margin-top: 4rpx;
}
.item-card__body {
  padding-top: 16rpx;
  border-top: 1rpx solid #ece8de;
}
.item-card__price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}
.item-card__price-row:last-child {
  margin-bottom: 0;
}
.item-card__price-label {
  font-size: 24rpx;
  color: #7a7a8a;
  flex-shrink: 0;
}
.item-card__price-input {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 10rpx;
  padding: 0 16rpx;
  height: 64rpx;
  min-width: 200rpx;
  border: 1rpx solid #e0ddd5;
}
.item-card__note {
  font-size: 22rpx;
  color: #b0a070;
  margin-top: 12rpx;
  line-height: 1.5;
  background: rgba(176, 160, 112, 0.08);
  padding: 10rpx 16rpx;
  border-radius: 8rpx;
}

/* ============ 操作按钮 ============ */
.action-bar {
  display: flex;
  gap: 20rpx;
  margin: 32rpx 0;
}
.btn {
  flex: 1;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  border: none;
  letter-spacing: 2rpx;
  box-sizing: border-box;
}
.btn::after {
  border: none;
}
.btn--primary {
  background: linear-gradient(135deg, #1a1a2e, #16213e);
  color: #ffc857;
  box-shadow: 0 6rpx 20rpx rgba(26, 26, 46, 0.3);
}
.btn--primary:active {
  transform: scale(0.98);
}
.btn--secondary {
  background: #fff;
  color: #6a6a7a;
  border: 2rpx solid #e0ddd5;
}
.btn--secondary:active {
  background: #f5f3ee;
}

/* ============ 计算结果 ============ */
.result-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 8rpx;
}
.result-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.result-card--main {
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
  padding: 36rpx 28rpx;
}
.result-card__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #3a3a4a;
  margin-bottom: 24rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #1a1a2e;
}
.result-card--main .result-card__title {
  color: #ffc857;
  border-left-color: #ffc857;
}

/* 核心数据网格 */
.result-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.result-grid__item {
  width: calc(50% - 8rpx);
  background: rgba(255, 255, 255, 0.08);
  border-radius: 14rpx;
  padding: 24rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.result-grid__item--highlight {
  background: rgba(255, 200, 87, 0.12);
  border: 1rpx solid rgba(255, 200, 87, 0.25);
}
.result-grid__item--rate {
  width: 100%;
  background: rgba(255, 200, 87, 0.12);
  border: 1rpx solid rgba(255, 200, 87, 0.25);
  flex-direction: row;
  justify-content: center;
  gap: 16rpx;
  padding: 28rpx 20rpx;
}
.result-grid__label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 8rpx;
}
.result-grid__item--rate .result-grid__label {
  margin-bottom: 0;
  font-size: 26rpx;
}
.result-grid__value {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.2;
}
.result-grid__item--rate .result-grid__value {
  font-size: 52rpx;
  color: #ffc857;
}
.result-grid__unit {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-top: 4rpx;
}
.result-grid__item--rate .result-grid__unit {
  font-size: 28rpx;
  color: rgba(255, 200, 87, 0.7);
  margin-top: 0;
}
.result-grid__sub {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.35);
  margin-top: 4rpx;
}

/* ============ 回血流水明细 ============ */
.flow-step {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0ede5;
}
.flow-step:last-child {
  border-bottom: none;
}
.flow-step--total {
  border-top: 2rpx solid #ece8de;
  border-bottom: none;
  margin-top: 8rpx;
  padding-top: 20rpx;
}
.flow-step__label {
  font-size: 26rpx;
  color: #5a5a6a;
}
.flow-step__value {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
}
.flow-step__value--positive {
  color: #2ecc71;
}
.flow-step__value--negative {
  color: #e74c3c;
}
.flow-step--total .flow-step__label {
  font-weight: 600;
  color: #1a1a2e;
}
.flow-step--total .flow-step__value {
  font-size: 32rpx;
}

/* ============ 寄售档位明细表 ============ */
.breakdown-table {
  width: 100%;
}
.breakdown-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0ede5;
}
.breakdown-row:last-child {
  border-bottom: none;
}
.breakdown-row--header {
  border-bottom: 2rpx solid #ece8de;
  padding-bottom: 16rpx;
  margin-bottom: 4rpx;
}
.breakdown-row--header .breakdown-cell {
  font-size: 22rpx;
  color: #9a9aaa;
  font-weight: 600;
}
.breakdown-cell {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #3a3a4a;
}
.breakdown-cell:first-child {
  text-align: left;
  font-weight: 500;
}
.breakdown-cell:last-child {
  text-align: right;
}
.breakdown-cell--neg {
  color: #e74c3c;
}
.breakdown-cell--pos {
  color: #2ecc71;
  font-weight: 600;
}

/* ============ 道具明细 ============ */
.detail-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0ede5;
}
.detail-row:last-child {
  border-bottom: none;
}
.detail-row__info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.detail-row__name {
  font-size: 26rpx;
  color: #1a1a2e;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.detail-row__source {
  font-size: 22rpx;
  color: #9a9aaa;
  margin-top: 4rpx;
}
.detail-row__value {
  font-size: 28rpx;
  font-weight: 600;
  color: #2ecc71;
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* ============ 不可交易道具 ============ */
.untradable-group {
  margin-bottom: 20rpx;
}
.untradable-group:last-child {
  margin-bottom: 0;
}
.untradable-group__title {
  display: block;
  font-size: 24rpx;
  color: #9a9aaa;
  font-weight: 600;
  margin-bottom: 12rpx;
  padding: 6rpx 16rpx;
  background: #f5f3ee;
  border-radius: 8rpx;
  display: inline-block;
}
.untradable-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}
.untradable-item__name {
  font-size: 26rpx;
  color: #5a5a6a;
}
.untradable-item__count {
  font-size: 24rpx;
  color: #9a9aaa;
  font-weight: 500;
}

/* ============ 底部说明 ============ */
.footer-note {
  margin-top: 40rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  align-items: center;
}
.footer-note text {
font-size: 22rpx;
color: #b0b0c0;
line-height: 1.6;
}

/* ============ 探索妙不可园 ============ */
.explore-card {
  display: flex;
  align-items: center;
  margin-top: 40rpx;
  padding: 32rpx 28rpx;
  background: linear-gradient(135deg, #3B6D11 0%, #5B8C85 100%);
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(59, 109, 17, 0.2);
}
.explore-card__icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.explore-card__char {
  font-size: 32rpx;
  font-weight: 500;
  color: #FFFFFF;
}
.explore-card__body {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}
.explore-card__title {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: #FFFFFF;
  letter-spacing: 4rpx;
}
.explore-card__desc {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}
.explore-card__arrow {
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.6);
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* ============ 分享结果按钮 ============ */
.share-result-btn {
  margin-top: 24rpx;
  width: 100%;
  height: 76rpx;
  background: linear-gradient(135deg, #1a1a2e 0%, #2d2d5f 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}
.share-result-btn::after {
  border: none;
}

/* ============ 海报 Canvas ============ */
.dnf-poster-canvas {
  position: fixed;
  left: -9999rpx;
  width: 600px;
  height: 800px;
}
