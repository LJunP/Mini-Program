{
  "pages": [
    "pages/index/index",
    "pages/tea/tea",
    "pages/travel/travel",
    "pages/wellness/wellness",
    "pages/incense/incense",
    "pages/music/music",
    "pages/film/film",
    "pages/study/index",
    "pages/study/tutorials",
    "pages/study/knowledge",
    "pages/study/interview",
    "pages/study/review",
    "pages/bookmark/bookmark",
    "pages/profile/profile",
    "pages/edit-profile/edit-profile",
    "pages/preferences/preferences",
    "pages/history/history",
    "pages/notification-settings/notification-settings",
    "pages/subscribe/subscribe",
    "pages/privacy/privacy",
    "pages/agreement/agreement",
    "pages/contribute/contribute",
    "pages/contribute/list"
  ],
  "subpackages": [
    {
      "root": "subpackages/detail",
      "name": "detail",
      "pages": [
        "tea-detail/tea-detail",
        "travel-detail/travel-detail",
        "content-detail/content-detail",
        "study-detail/study-detail",
        "question-detail/question-detail",
        "compare/compare"
      ]
    },
    {
      "root": "subpackages/search",
      "name": "search",
      "pages": [
        "pages/search/search"
      ]
    },
    {
      "root": "subpackages/tools",
      "name": "tools",
      "pages": [
        "pages/dnf-summer-2026/calculator",
        "pages/gold-purchase/calculator"
      ]
    }
  ],
  "preloadRule": {
    "pages/index/index": {
      "network": "all",
      "packages": ["detail"]
    },
    "pages/tea/tea": {
      "network": "all",
      "packages": ["detail"]
    }
  },
  "window": {
    "navigationBarTitleText": "妙不可园",
    "navigationBarBackgroundColor": "#FAF8F3",
    "navigationBarTextStyle": "black",
    "backgroundColor": "#FAF8F3",
    "backgroundTextStyle": "dark",
    "enablePullDownRefresh": true
  },
  "tabBar": {
    "color": "#8B8578",
    "selectedColor": "#3B6D11",
    "backgroundColor": "#FAF8F3",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "assets/icons/tab-home-inactive.png",
        "selectedIconPath": "assets/icons/tab-home-active.png"
      },
      {
        "pagePath": "pages/bookmark/bookmark",
        "text": "书签",
        "iconPath": "assets/icons/tab-bookmark-inactive.png",
        "selectedIconPath": "assets/icons/tab-bookmark-active.png"
      },
      {
        "pagePath": "pages/profile/profile",
        "text": "我的",
        "iconPath": "assets/icons/tab-profile-inactive.png",
        "selectedIconPath": "assets/icons/tab-profile-active.png"
      }
    ]
  },
  "requiredBackgroundModes": ["audio"],
  "style": "v2",
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents",
  "permission": {
    "scope.writePhotosAlbum": {
      "desc": "用于保存分享海报到相册"
    }
  },
  "__usePrivacyCheck__": true
}
