<!-- components/empty-state/empty-state.wxml -->
<view class="empty-state">
  <view class="empty-state__icon" style="background-color: {{iconBgColor || '#EAE5DC'}}">
    <text class="empty-state__icon-text" style="color: {{iconColor || '#8B8578'}}">{{icon || '📋'}}</text>
  </view>
  <text class="empty-state__title">{{title || '暂无数据'}}</text>
  <text class="empty-state__desc" wx:if="{{description}}">{{description}}</text>
  <button class="empty-state__action" wx:if="{{actionText}}" bindtap="onActionTap" style="background-color: {{actionColor || '#3B6D11'}}">{{actionText}}</button>
</view>