<!-- pages/index/index.wxml -->
<view class="page-bg">

  <!-- 顶部标题区 -->
  <view class="hero">
    <view class="hero__row">
      <view class="hero__titles">
        <view class="hero__title">妙不可园</view>
        <view class="hero__subtitle">好好躺平，认真生活</view>
      </view>
      <view class="hero__search" bindtap="goSearch">
        <text class="hero__search-icon">⌕</text>
      </view>
    </view>
  </view>

  <!-- 六雅宫格（sticky 固定） -->
  <view class="realms-sticky">
    <view class="realms">
      <view
        wx:for="{{realms}}"
        wx:key="key"
        class="realms__item"
        data-key="{{item.key}}"
        bindtap="onRealmTap"
      >
        <view class="realms__icon" style="background-color:{{item.color}};">
          <text class="realms__char">{{item.char}}</text>
          <!-- 收藏数角标 -->
          <view class="realms__badge realms__badge--bookmark" wx:if="{{item.bookmarkCount > 0}}">
            <text class="realms__badge-num">{{item.bookmarkCount}}</text>
          </view>
        </view>
        <text class="realms__name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 网络重试条 -->
  <retry-bar show="{{showRetry}}" message="{{retryMessage}}" loading="{{retryLoading}}" bind:retry="onRetry" />

  <!-- 骨架屏 -->
  <block wx:if="{{loading}}">
    <view class="section-title">每日风雅</view>
    <view class="skeleton-daily">
      <view class="skeleton-block skeleton-cover"></view>
      <view class="skeleton-block skeleton-line skeleton-line--lg"></view>
      <view class="skeleton-block skeleton-line skeleton-line--sm"></view>
      <view class="skeleton-block skeleton-line skeleton-line--md"></view>
    </view>
    <view class="section-title">风雅内容</view>
    <view class="skeleton-feed">
      <view class="skeleton-feed__item" wx:for="{{[1,2,3]}}" wx:key="*this">
        <view class="skeleton-block skeleton-feed__cover"></view>
        <view class="skeleton-feed__text">
          <view class="skeleton-block skeleton-line skeleton-line--lg"></view>
          <view class="skeleton-block skeleton-line skeleton-line--sm"></view>
        </view>
      </view>
    </view>
  </block>

  <!-- 真实内容 -->
  <block wx:else>

    <!-- 紧凑打卡条 -->
    <view class="checkin-bar" catchtap="onCheckinTap">
      <view class="checkin-bar__info">
        <text class="checkin-bar__streak" wx:if="{{checkinStreak > 0}}">🔥 {{checkinStreak}}天连续</text>
        <text class="checkin-bar__streak" wx:else>今日尚未打卡</text>
        <view class="checkin-bar__dots">
          <view wx:for="{{checkinCalendar}}" wx:key="date" class="checkin-bar__dot {{item.checked ? 'checkin-bar__dot--checked' : ''}} {{item.isToday ? 'checkin-bar__dot--today' : ''}}"></view>
        </view>
      </view>
      <view class="checkin-bar__btn {{checkedToday ? 'checkin-bar__btn--done' : ''}}">
        <text>{{checkedToday ? '已打卡' : '打卡'}}</text>
      </view>
    </view>

    <!-- 每日风雅卡片 -->
    <view class="section-title">每日风雅</view>
    <view class="daily-elegance" wx:if="{{dailyElegance}}" bindtap="onDailyEleganceTap">
      <view class="daily-elegance__header">
        <view class="daily-elegance__badge" style="background-color:{{dailyElegance.domainColor}};">
          <text class="daily-elegance__badge-char">{{dailyElegance.domainChar}}</text>
          <text class="daily-elegance__badge-name">{{dailyElegance.domainName}}</text>
        </view>
        <text wx:if="{{dailyEleganceViewed}}" class="daily-elegance__viewed">已阅</text>
      </view>

      <view class="daily-elegance__cover" style="background-color:{{dailyElegance.domainColor}};">
        <image wx:if="{{dailyElegance.data.coverImage}}" src="{{dailyElegance.data.coverImage}}" mode="aspectFill" class="daily-elegance__img" />
        <view wx:else class="daily-elegance__cover-text">{{dailyElegance.domainChar}}</view>
      </view>

      <view class="daily-elegance__body">
        <text class="daily-elegance__title">{{dailyElegance.data.name || dailyElegance.data.title}}</text>
        <text class="daily-elegance__desc">{{dailyElegance.data.description || dailyElegance.data.body || dailyElegance.data.essay}}</text>
      </view>
    </view>

    <!-- 当季推荐 -->
    <view class="seasonal-section" wx:if="{{seasonalList.length > 0}}">
      <view class="seasonal-header">
        <view class="seasonal-header__left">
          <view class="seasonal-header__badge" style="background-color: {{seasonInfo.color}};">
            <text class="seasonal-header__char">{{seasonInfo.name}}</text>
          </view>
          <view class="seasonal-header__info">
            <text class="seasonal-header__title">{{seasonInfo.currentTerm}} · 当季风雅</text>
            <text class="seasonal-header__sub">{{seasonInfo.desc}}</text>
          </view>
        </view>
        <text class="seasonal-header__next">下一节气：{{seasonInfo.nextTerm}}</text>
      </view>
      <scroll-view class="seasonal-scroll" scroll-x="{{true}}" show-scrollbar="{{false}}">
        <view
          wx:for="{{seasonalList}}"
          wx:key="id"
          class="seasonal-card"
          data-domain="{{item.domain}}"
          data-ref-id="{{item.refId}}"
          bindtap="onSeasonalTap"
        >
          <view class="seasonal-card__tag" style="color: {{item.domainColor}}; background-color: {{item.domainColor}}1a;">
            <text>{{item.domainName}}</text>
          </view>
          <text class="seasonal-card__title">{{item.title}}</text>
          <text class="seasonal-card__summary">{{item.summary}}</text>
          <view class="seasonal-card__footer" wx:if="{{item.solarTerm}}">
            <text class="seasonal-card__term">{{item.solarTerm}}</text>
          </view>
        </view>
      </scroll-view>
      <view class="seasonal-more" bindtap="onSeasonalMore">
        <text>查看全部当季风雅 ›</text>
      </view>
    </view>

    <!-- 内容流 -->
    <view class="section-title">
      <text>风雅内容</text>
      <view class="section-title__action" bindtap="onRefreshFeed">
        <text>换一批</text>
      </view>
    </view>
    <block wx:for="{{feed}}" wx:key="index">
      <tea-card
        wx:if="{{item.type === 'tea'}}"
        tea="{{item.data}}"
        bindtap="onTeaTap"
        data-tea="{{item.data}}"
      />
      <content-card
        wx:elif="{{item.type === 'travel'}}"
        domain="travel"
        title="{{item.data.title}}"
        summary="{{item.data.essay}}"
        coverImage="{{item.data.coverImage}}"
        duration="{{item.data.duration}}"
        data="{{item.data}}"
        bindtap="onTravelTap"
      />
      <content-card
        wx:elif="{{item.type === 'wellness'}}"
        domain="wellness"
        title="{{item.data.title}}"
        summary="{{item.data.body}}"
        coverImage="{{item.data.coverImage}}"
        extra="{{item.data.duration}}"
        data="{{item.data}}"
        bindtap="onWellnessTap"
      />
      <content-card
        wx:elif="{{item.type === 'incense'}}"
        domain="incense"
        title="{{item.data.title}}"
        summary="{{item.data.body}}"
        coverImage="{{item.data.coverImage}}"
        extra="{{item.data.origin}}"
        data="{{item.data}}"
        bindtap="onIncenseTap"
      />
      <content-card
        wx:elif="{{item.type === 'music'}}"
        domain="music"
        title="{{item.data.title}}"
        summary="{{item.data.body}}"
        coverImage="{{item.data.coverImage}}"
        extra="{{item.data.instrument}}"
        data="{{item.data}}"
        bindtap="onMusicTap"
      />
      <content-card
        wx:elif="{{item.type === 'film'}}"
        domain="film"
        title="{{item.data.title}}"
        summary="{{item.data.body}}"
        coverImage="{{item.data.coverImage}}"
        extra="{{item.data.director}}"
        data="{{item.data}}"
        bindtap="onFilmTap"
      />
    </block>

  </block>

  <!-- 发现好工具 -->
  <view class="section-title">发现好工具</view>
  <view class="tools-mini">
    <view class="tools-mini__item" bindtap="goStudyHome">
      <view class="tools-mini__icon tools-mini__icon--study">
        <text class="tools-mini__char">学</text>
      </view>
      <view class="tools-mini__body">
        <text class="tools-mini__name">面试题库</text>
        <text class="tools-mini__desc">901题 · 八股文与场景题</text>
      </view>
      <text class="tools-mini__arrow">›</text>
    </view>
    <view class="tools-mini__item" bindtap="goToolbox">
      <view class="tools-mini__icon tools-mini__icon--more">
        <text class="tools-mini__char">⚙</text>
      </view>
      <view class="tools-mini__body">
        <text class="tools-mini__name">更多工具</text>
        <text class="tools-mini__desc">实用计算器与工具箱</text>
      </view>
      <text class="tools-mini__arrow">›</text>
    </view>
  </view>

  <view class="footer-end">— 妙不可园 · 偷得浮生妙不可园 —</view>

  <!-- 浮动快捷导航 -->
  <view class="fab-nav" bindtap="onFabNav">
    <text class="fab-nav__icon">≡</text>
  </view>

  <!-- 快捷导航面板 -->
  <view class="nav-mask" wx:if="{{showNavPanel}}" bindtap="onCloseNav"></view>
  <view class="nav-panel {{showNavPanel ? 'nav-panel--open' : ''}}">
    <view class="nav-panel__header">
      <text class="nav-panel__title">快速导航</text>
      <view class="nav-panel__close" bindtap="onCloseNav">✕</view>
    </view>
    <view class="nav-panel__grid">
      <view wx:for="{{navItems}}" wx:key="key" class="nav-panel__item" data-key="{{item.key}}" bindtap="onNavTap">
        <view class="nav-panel__icon" style="background-color:{{item.color}};">
          <text>{{item.char}}</text>
        </view>
        <text class="nav-panel__name">{{item.name}}</text>
      </view>
    </view>
    <view class="nav-panel__section">
      <view class="nav-panel__item nav-panel__item--tool" bindtap="onNavSearch">
        <view class="nav-panel__icon nav-panel__icon--search">⌕</view>
        <text class="nav-panel__name">搜索</text>
      </view>
      <view class="nav-panel__item nav-panel__item--tool" bindtap="onNavBookmark">
        <view class="nav-panel__icon nav-panel__icon--bookmark">✦</view>
        <text class="nav-panel__name">书签</text>
      </view>
      <view class="nav-panel__item nav-panel__item--tool" bindtap="onNavProfile">
        <view class="nav-panel__icon nav-panel__icon--profile">我</view>
        <text class="nav-panel__name">我的</text>
      </view>
      <view class="nav-panel__item nav-panel__item--tool" bindtap="onNavStudy">
        <view class="nav-panel__icon nav-panel__icon--study">学</view>
        <text class="nav-panel__name">面试题库</text>
      </view>
    </view>
    <view class="nav-panel__section">
      <text class="nav-panel__section-title">实用工具</text>
      <view class="nav-panel__item nav-panel__item--tool" bindtap="onNavDNF">
        <view class="nav-panel__icon nav-panel__icon--dnf">游</view>
        <text class="nav-panel__name">DNF工具</text>
      </view>
    </view>
  </view>
</view>
