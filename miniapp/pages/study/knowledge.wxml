<view class="page-bg">
  <view class="page-header">
    <text class="page-header__title">知识科普</text>
    <text class="page-header__sub">知其然 · 更知其所以然</text>
  </view>

  <view class="tabs">
    <view
      wx:for="{{categories}}"
      wx:key="key"
      class="tabs__item {{currentCategory === item.key ? 'tabs__item--active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onCategoryTap"
    >
      <text>{{item.name}}</text>
    </view>
  </view>

  <view class="study-list" wx:if="{{list.length}}">
    <view class="study-card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="onItemTap">
      <view class="study-card__header">
        <text class="study-card__tag">科普</text>
        <text class="study-card__meta">{{item.duration}} 分钟 · 难度 {{item.difficulty}}</text>
      </view>
      <text class="study-card__title">{{item.title}}</text>
      <text class="study-card__summary ellipsis-2">{{item.summary}}</text>
      <view class="key-points">
        <text class="key-point" wx:for="{{item.keyPoints}}" wx:key="*this">{{item}}</text>
      </view>
    </view>
  </view>

  <empty-state wx:else text="暂无科普内容" desc="后续会继续补充" />
</view>