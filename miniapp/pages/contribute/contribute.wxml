<!-- pages/contribute/contribute.wxml -->
<view class="page-bg contribute-page">

  <!-- 领域选择 -->
  <view class="domain-selector">
    <view class="domain-selector__title">选择领域</view>
    <view class="domain-selector__list">
      <view
        wx:for="{{domainOptions}}"
        wx:key="key"
        class="domain-chip {{domain === item.key ? 'domain-chip--active' : ''}}"
        style="--chip-color: {{item.color}}; --chip-bg: {{item.bgColor}};"
        data-domain="{{item.key}}"
        bindtap="onDomainSelect"
      >
        <text class="domain-chip__icon">{{item.name}}</text>
        <text class="domain-chip__label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 标题输入 -->
  <view class="form-card">
    <input
      class="form-title-input"
      value="{{title}}"
      placeholder="给这篇投稿起个名字…"
      maxlength="30"
      bindinput="onTitleInput"
    />
    <view class="form-content-count form-content-count--title">{{title.length}}/30</view>
  </view>

  <!-- 正文输入 -->
  <view class="form-card">
    <textarea
      class="form-content-input"
      value="{{content}}"
      placeholder="{{currentDomain ? currentDomain.placeholder : '记录你的风雅感悟…'}}"
      maxlength="2000"
      auto-height
      show-confirm-bar="{{false}}"
      adjust-position="{{true}}"
      bindinput="onContentInput"
    />
    <view class="form-content-count">{{contentCount}}/2000</view>
  </view>

  <!-- 评分 -->
  <view class="form-card form-card--row">
    <view class="form-card__label">评分</view>
    <view class="rating-stars">
      <view
        wx:for="{{[1,2,3,4,5]}}"
        wx:key="*this"
        class="rating-star {{rating >= item ? 'rating-star--active' : ''}}"
        data-rating="{{item}}"
        bindtap="onRatingTap"
      >
        <text>{{rating >= item ? '★' : '☆'}}</text>
      </view>
    </view>
  </view>

  <!-- 地点 -->
  <view class="form-card form-card--row">
    <view class="form-card__label">地点</view>
    <input
      class="form-row-input"
      value="{{location}}"
      placeholder="记录发生的地点（选填）"
      maxlength="50"
      bindinput="onLocationInput"
    />
  </view>

  <!-- 标签 -->
  <view class="form-card">
    <view class="form-card__label form-card__label--block">标签</view>
    <view class="tags-area">
      <view
        wx:for="{{tags}}"
        wx:key="*this"
        class="tag-chip"
      >
        <text class="tag-chip__text">{{item}}</text>
        <view class="tag-chip__remove" data-index="{{index}}" bindtap="onRemoveTag">×</view>
      </view>
      <view class="tag-chip tag-chip--add" wx:if="{{!showTagInput && tags.length < 8}}" bindtap="onShowTagInput">
        <text>+ 添加标签</text>
      </view>
      <view class="tag-input-wrap" wx:if="{{showTagInput}}">
        <input
          class="tag-input"
          value="{{tagInputValue}}"
          placeholder="输入标签"
          maxlength="10"
          focus="{{showTagInput}}"
          bindinput="onTagInput"
          bindconfirm="onTagConfirm"
        />
        <view class="tag-input-btns">
          <text class="tag-input-btn tag-input-btn--confirm" bindtap="onTagConfirm">确定</text>
          <text class="tag-input-btn tag-input-btn--cancel" bindtap="onTagCancel">取消</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 关联内容 -->
  <view class="form-card">
    <view class="form-card__label form-card__label--block">关联内容</view>
    <view class="linked-content" wx:if="{{linkedContent}}">
      <view class="linked-content__info">
        <view class="linked-content__domain">{{currentDomain.name}}</view>
        <view class="linked-content__title">{{linkedContent.refTitle}}</view>
      </view>
      <view class="linked-content__remove" bindtap="onRemoveLinkedContent">×</view>
    </view>
    <view class="linked-content-add" wx:else bindtap="onShowContentPicker">
      <text class="linked-content-add__icon">+</text>
      <text class="linked-content-add__text">关联{{currentDomain.label}}内容</text>
    </view>
  </view>

  <!-- 图片 -->
  <view class="form-card">
    <view class="form-card__label form-card__label--block">图片</view>
    <view class="image-grid">
      <view
        wx:for="{{images}}"
        wx:key="*this"
        class="image-grid__item"
      >
        <image
          src="{{item}}"
          mode="aspectFill"
          class="image-grid__img"
          data-url="{{item}}"
          bindtap="onPreviewImage"
        />
        <view class="image-grid__delete" data-index="{{index}}" bindtap="onRemoveImage">×</view>
      </view>
      <view class="image-grid__add" wx:if="{{images.length < 9}}" bindtap="onChooseImage">
        <text class="image-grid__add-icon">+</text>
        <text class="image-grid__add-text">{{images.length}}/9</text>
      </view>
    </view>
  </view>

  <!-- 公开/私密开关 -->
  <view class="form-section">
    <view class="form-label">发布范围</view>
    <view class="visibility-toggle">
      <view class="visibility-option {{isPublic ? 'visibility-option--active' : ''}}" data-public="true" bindtap="onVisibilityChange">
        <text>🌐 公开</text>
        <text class="visibility-option__desc">显示在风雅社区</text>
      </view>
      <view class="visibility-option {{!isPublic ? 'visibility-option--active' : ''}}" data-public="false" bindtap="onVisibilityChange">
        <text>🔒 私密</text>
        <text class="visibility-option__desc">仅自己可见</text>
      </view>
    </view>
  </view>

  <!-- 底部操作 -->
  <view class="contribute-footer">
    <button class="footer-btn footer-btn--draft" bindtap="onSaveDraft">保存草稿</button>
    <button class="footer-btn footer-btn--submit" bindtap="onSubmit" loading="{{submitting}}">
      {{isEdit ? '更新投稿' : '发布投稿'}}
    </button>
  </view>

  <!-- 关联内容选择器 -->
  <view class="content-picker-mask" wx:if="{{showContentPicker}}" bindtap="onHideContentPicker">
    <view class="content-picker" catchtap="">
      <view class="content-picker__header">
        <text class="content-picker__title">选择{{currentDomain.label}}内容</text>
        <view class="content-picker__close" bindtap="onHideContentPicker">×</view>
      </view>
      <view class="content-picker__search">
        <input
          class="content-picker__search-input"
          value="{{contentPickerKeyword}}"
          placeholder="搜索内容名称…"
          bindinput="onContentPickerSearch"
          confirm-type="search"
        />
      </view>
      <scroll-view class="content-picker__list" scroll-y>
        <view
          wx:for="{{contentPickerList}}"
          wx:key="refId"
          class="content-picker__item"
          data-ref-id="{{item.refId}}"
          data-ref-domain="{{item.refDomain}}"
          data-ref-title="{{item.refTitle}}"
          bindtap="onSelectContent"
        >
          <view class="content-picker__item-info">
            <view class="content-picker__item-title">{{item.refTitle}}</view>
            <view class="content-picker__item-sub" wx:if="{{item.refSubtitle}}">{{item.refSubtitle}}</view>
          </view>
          <text class="content-picker__item-arrow">›</text>
        </view>
        <view class="content-picker__empty" wx:if="{{contentPickerList.length === 0}}">
          <text>暂无匹配内容</text>
        </view>
      </scroll-view>
    </view>
  </view>

</view>
