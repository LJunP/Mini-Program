/* pages/study/tutorials.wxss */
.page-header {
  padding: 32rpx 16rpx 24rpx;
}
.page-header__title {
  font-size: 44rpx;
  font-weight: 500;
  color: #2C2C2A;
  letter-spacing: 8rpx;
}
.page-header__sub {
  display: block;
  font-size: 24rpx;
  color: #8B8578;
  margin-top: 8rpx;
  letter-spacing: 2rpx;
}
.tabs {
  display: flex;
  padding: 16rpx 0 24rpx;
  border-bottom: 0.5px solid #EAE5DC;
}
.tabs__item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: #8B8578;
  position: relative;
}
.tabs__item--active {
  color: #3B6D11;
  font-weight: 500;
}
.tabs__item--active::after {
  content: "";
  position: absolute;
  bottom: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 32rpx;
  height: 4rpx;
  background-color: #3B6D11;
  border-radius: 2px;
}
.study-list {
  padding-top: 16rpx;
}
.study-card {
  background-color: #FFFFFFFC;
  border: 0.5px solid #EAE5DC;
  border-radius: 12px;
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.study-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.study-card__tag {
  color: #3B6D11;
  background-color: rgba(59, 109, 17, 0.1);
  border-radius: 4px;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
}
.study-card__meta {
  color: #8B8578;
  font-size: 22rpx;
}
.study-card__title {
  display: block;
  color: #2C2C2A;
  font-size: 34rpx;
  font-weight: 500;
  line-height: 1.5;
}
.study-card__summary {
  display: block;
  color: #5A554C;
  font-size: 26rpx;
  line-height: 1.7;
  margin-top: 12rpx;
}
.study-card__tags {
  margin-top: 18rpx;
}