<!-- pages/film/film.wxml -->
<view class="page-bg">
  <view class="page-header">
    <view class="page-header__row">
      <view class="page-header__titles">
        <text class="page-header__title">看戏</text>
        <text class="page-header__sub">光影之间 · 观照自己的内心</text>
      </view>
      <view class="page-header__search" bindtap="goSearch">
        <text class="page-header__search-icon">⌕</text>
      </view>
    </view>
  </view>

  <!-- 排序栏 -->
  <view class="sort-bar">
    <view class="sort-bar__tabs">
      <view
        wx:for="{{sortOptions}}"
        wx:key="key"
        class="sort-bar__item {{sort === item.key ? 'sort-bar__item--active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onSortTap"
      >
        <text>{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 分类 tab（含数量） -->
  <scroll-view class="tabs" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view
      wx:for="{{categories}}"
      wx:key="key"
      class="tabs__item {{currentCategory === item.key ? 'tabs__item--active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onCategoryTap"
    >
      <text class="tabs__name">{{item.name}}</text>
      <text class="tabs__count">{{item.count}}</text>
    </view>
  </scroll-view>

  <!-- 加载骨架屏 -->
  <view wx:if="{{loading && !list.length}}" class="skeleton-list">
    <view wx:for="{{[1,2,3]}}" wx:key="*this" class="skeleton-card">
      <view class="skeleton-card__cover skeleton-pulse"></view>
      <view class="skeleton-card__body">
        <view class="skeleton-card__title skeleton-pulse"></view>
        <view class="skeleton-card__meta skeleton-pulse"></view>
      </view>
    </view>
  </view>

  <!-- 内容列表 -->
  <view class="film-list" wx:if="{{!loading && list.length}}">
    <view class="film-item" wx:for="{{list}}" wx:key="id">
      <content-card
        domain="film"
        contentId="{{item.id}}"
        title="{{item.title}}"
        summary="{{item.body}}"
        coverImage="{{item.coverImage}}"
        extra="{{item.director}}"
        data="{{item}}"
        bindtap="onFilmTap"
      />
      <!-- 电影状态操作栏 -->
      <view class="film-actions">
        <view class="film-actions__status">
          <view class="film-tag {{item.watchStatus === 'watched' ? 'film-tag--watched' : ''}}" data-id="{{item.id}}" data-status="watched" catchtap="onSetStatus">
            <text>✓ 看过</text>
          </view>
          <view class="film-tag {{item.watchStatus === 'want' ? 'film-tag--want' : ''}}" data-id="{{item.id}}" data-status="want" catchtap="onSetStatus">
            <text>☆ 想看</text>
          </view>
        </view>
        <view class="film-actions__rating" data-id="{{item.id}}" data-title="{{item.title}}" catchtap="onOpenRating">
          <view class="stars">
            <text class="star {{item.userRating >= 1 ? 'star--active' : ''}}">★</text>
            <text class="star {{item.userRating >= 2 ? 'star--active' : ''}}">★</text>
            <text class="star {{item.userRating >= 3 ? 'star--active' : ''}}">★</text>
            <text class="star {{item.userRating >= 4 ? 'star--active' : ''}}">★</text>
            <text class="star {{item.userRating >= 5 ? 'star--active' : ''}}">★</text>
          </view>
          <text class="film-actions__rate-text" wx:if="{{item.userRating}}">{{item.userRating}}分</text>
          <text class="film-actions__rate-text film-actions__rate-text--hint" wx:else>评分</text>
        </view>
      </view>
    </view>
  </view>

  <empty-state wx:if="{{!loading && !list.length}}" text="暂无该分类内容" desc="试试其他分类" />
</view>

<!-- 评分弹窗 -->
<view class="rating-mask" wx:if="{{showRatingPanel}}" bindtap="onCloseRating">
  <view class="rating-panel" catchtap="">
    <view class="rating-panel__header">
      <image wx:if="{{ratingFilmCover}}" class="rating-panel__cover" src="{{ratingFilmCover}}" mode="aspectFill" />
      <view class="rating-panel__header-text">
        <text class="rating-panel__title">给电影评分</text>
        <text class="rating-panel__film-name ellipsis">{{ratingFilmTitle}}</text>
      </view>
    </view>
    <view class="rating-panel__stars">
      <text class="rating-star {{tempRating >= 1 ? 'rating-star--active' : ''}}" data-star="1" bindtap="onStarTap">★</text>
      <text class="rating-star {{tempRating >= 2 ? 'rating-star--active' : ''}}" data-star="2" bindtap="onStarTap">★</text>
      <text class="rating-star {{tempRating >= 3 ? 'rating-star--active' : ''}}" data-star="3" bindtap="onStarTap">★</text>
      <text class="rating-star {{tempRating >= 4 ? 'rating-star--active' : ''}}" data-star="4" bindtap="onStarTap">★</text>
      <text class="rating-star {{tempRating >= 5 ? 'rating-star--active' : ''}}" data-star="5" bindtap="onStarTap">★</text>
    </view>
    <view class="rating-panel__labels">
      <text class="rating-label" wx:if="{{tempRating === 1}}">不太行</text>
      <text class="rating-label" wx:if="{{tempRating === 2}}">一般</text>
      <text class="rating-label" wx:if="{{tempRating === 3}}">还行</text>
      <text class="rating-label" wx:if="{{tempRating === 4}}">很好</text>
      <text class="rating-label" wx:if="{{tempRating === 5}}">神作</text>
    </view>
    <view class="rating-panel__btns">
      <view class="rating-panel__btn rating-panel__btn--cancel" bindtap="onCloseRating">
        <text>取消</text>
      </view>
      <view class="rating-panel__btn rating-panel__btn--confirm" bindtap="onConfirmRating">
        <text>确认</text>
      </view>
    </view>
  </view>
</view>
