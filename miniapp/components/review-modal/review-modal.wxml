<!-- components/review-modal/review-modal.wxml -->
<view class="mask" wx:if="{{visible}}" bindtap="onClose">
  <view class="modal" catchtap="onStopPropagation">
    <!-- 标题 -->
    <view class="modal__header">
      <text class="modal__title">写下你的品鉴</text>
      <view class="modal__close" bindtap="onClose">✕</view>
    </view>

    <view class="modal__body">
      <!-- 评分 -->
      <view class="modal__section">
        <view class="modal__label">
          <text>评分</text>
          <text class="modal__score">{{rating}}</text>
          <text class="modal__rating-desc">（{{ratingDesc}}）</text>
        </view>
        <slider
          min="1"
          max="10"
          step="0.5"
          value="{{rating}}"
          activeColor="#3B6D11"
          backgroundColor="#EAE5DC"
          block-size="20"
          bindchange="onRatingChange"
        />
        <view class="modal__slider-labels">
          <text>1 分</text>
          <text>10 分</text>
        </view>
      </view>

      <!-- 标签快选 -->
      <view class="modal__section">
        <text class="modal__label">口感标签（最多 3 个）</text>
        <view class="modal__tags">
          <view
            wx:for="{{presetTags}}"
            wx:key="*this"
            class="modal__tag {{selectedTags.indexOf(item) >= 0 ? 'modal__tag--active' : ''}}"
            data-tag="{{item}}"
            bindtap="onTagTap"
          >{{item}}</view>
        </view>
      </view>

      <!-- 文字输入 -->
      <view class="modal__section">
        <text class="modal__label">品鉴感受（选填，至少10字或选择标签）</text>
        <textarea
          class="modal__textarea"
          placeholder="分享你的品饮体验…"
          placeholder-style="color:#B0A99A;"
          maxlength="200"
          value="{{body}}"
          bindinput="onBodyInput"
        />
        <text class="modal__count">{{bodyLength}}/200</text>
      </view>
    </view>

    <!-- 提交按钮 -->
    <view class="modal__footer">
      <view class="modal__submit {{submitting ? 'modal__submit--disabled' : ''}}" bindtap="onSubmit">
        <text>{{submitting ? '提交中…' : '发布点评'}}</text>
      </view>
    </view>
  </view>
</view>
