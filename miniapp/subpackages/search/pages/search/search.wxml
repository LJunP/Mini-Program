<!-- subpackages/search/pages/search/search.wxml -->
<view class="page-bg">

  <!-- 搜索框 -->
  <view class="search-bar">
    <view class="search-bar__box">
      <text class="search-bar__icon">⌕</text>
      <input
        class="search-bar__input"
        type="text"
        placeholder="搜索茶品、行旅、养生、香道、音乐、电影..."
        value="{{keyword}}"
        bindinput="onInput"
        bindconfirm="onSearch"
        confirm-type="search"
        focus="{{true}}"
      />
      <text wx:if="{{keyword}}" class="search-bar__clear" bindtap="onClear">✕</text>
    </view>
    <text class="search-bar__btn" bindtap="onSearch">搜索</text>
  </view>

  <!-- 搜索建议下拉 -->
  <view wx:if="{{showSuggestions && suggestions.length > 0}}" class="suggestions">
    <view
      wx:for="{{suggestions}}"
      wx:key="*this"
      class="suggestions__item"
      data-word="{{item}}"
      bindtap="onSuggestionTap"
    >
      <text class="suggestions__icon">⌕</text>
      <text class="suggestions__text">{{item}}</text>
    </view>
  </view>

  <!-- 未搜索：展示热门词和历史记录 -->
  <block wx:if="{{!hasSearched && !showSuggestions}}">
    <!-- 搜索历史 -->
    <block wx:if="{{searchHistory.length > 0}}">
      <view class="section-title">
        <text>搜索历史</text>
        <text class="section-title__action" bindtap="onClearHistory">清空</text>
      </view>
      <view class="search-history">
        <view
          wx:for="{{searchHistory}}"
          wx:key="*this"
          class="search-history__item"
          data-word="{{item}}"
          bindtap="onHistoryTap"
        >
          <text>{{item}}</text>
          <text
            class="search-history__delete"
            data-word="{{item}}"
            catchtap="onDeleteHistory"
          >✕</text>
        </view>
      </view>
    </block>

    <view class="section-title">热门搜索</view>
    <view class="hot-keywords">
      <view
        wx:for="{{hotKeywords}}"
        wx:key="*this"
        class="hot-keywords__item"
        data-word="{{item}}"
        bindtap="onHotTap"
      >
        <text>{{item}}</text>
      </view>
    </view>
  </block>

  <!-- 搜索结果 -->
  <block wx:if="{{hasSearched}}">
    <!-- 结果 tab + 筛选按钮 -->
    <view class="result-tabs">
      <view
        wx:for="{{tabs}}"
        wx:key="key"
        class="result-tabs__item {{activeTab === item.key ? 'result-tabs__item--active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onTabTap"
      >
        <text>{{item.name}}</text>
      </view>
      <view class="result-tabs__filter" bindtap="onToggleFilters">
        <text>筛选</text>
        <text class="result-tabs__filter-icon {{showFilters ? 'result-tabs__filter-icon--active' : ''}}">▼</text>
      </view>
    </view>

    <!-- 搜索结果统计 -->
    <view class="result-count">
      <text>共找到 {{totalCount}} 条结果</text>
    </view>

    <!-- 筛选面板 -->
    <view class="filter-panel {{showFilters ? 'filter-panel--show' : ''}}">
      <!-- 排序方式 -->
      <view class="filter-section">
        <text class="filter-section__title">排序方式</text>
        <view class="filter-options">
          <view
            wx:for="{{sortOptions}}"
            wx:key="key"
            class="filter-option {{filters.sortBy === item.key ? 'filter-option--active' : ''}}"
            data-type="sortBy"
            data-value="{{item.key}}"
            bindtap="onFilterChange"
          >
            <text>{{item.name}}</text>
          </view>
        </view>
      </view>

      <!-- 难度等级（仅养生Tab显示） -->
      <view class="filter-section" wx:if="{{activeTab === 'wellness'}}">
        <text class="filter-section__title">难度等级</text>
        <view class="filter-options">
          <view
            wx:for="{{difficultyOptions}}"
            wx:key="key"
            class="filter-option {{filters.difficulty === item.key ? 'filter-option--active' : ''}}"
            data-type="difficulty"
            data-value="{{item.key}}"
            bindtap="onFilterChange"
          >
            <text>{{item.name}}</text>
          </view>
        </view>
      </view>

      <!-- 茶类筛选（仅茶Tab显示） -->
      <view class="filter-section" wx:if="{{activeTab === 'tea'}}">
        <text class="filter-section__title">茶类</text>
        <view class="filter-options">
          <view
            wx:for="{{teaCategories}}"
            wx:key="key"
            class="filter-option {{filters.teaCategory === item.key ? 'filter-option--active' : ''}}"
            data-type="teaCategory"
            data-value="{{item.key}}"
            bindtap="onFilterChange"
          >
            <text>{{item.name}}</text>
          </view>
        </view>
      </view>

      <!-- 价格筛选（仅香道Tab显示） -->
      <view class="filter-section" wx:if="{{activeTab === 'incense'}}">
        <text class="filter-section__title">价格区间</text>
        <view class="filter-options">
          <view
            wx:for="{{priceOptions}}"
            wx:key="key"
            class="filter-option {{filters.priceRange === item.key ? 'filter-option--active' : ''}}"
            data-type="priceRange"
            data-value="{{item.key}}"
            bindtap="onFilterChange"
          >
            <text>{{item.name}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- ========== 全部结果（混合排序） ========== -->
    <block wx:if="{{activeTab === 'all'}}">
      <view wx:if="{{displayMixedResults.length}}">
        <view
          wx:for="{{displayMixedResults}}"
          wx:key="id"
          class="result-item"
          data-domain="{{item._domain}}"
          data-id="{{item.id}}"
          bindtap="onMixedItemTap"
        >
          <view class="result-item__cover" style="background-color:{{item._color}};">
            <text class="result-item__char">{{item._char}}</text>
          </view>
          <view class="result-item__body">
            <text class="result-item__title">{{item._displayName}}</text>
            <text class="result-item__summary ellipsis-2" wx:if="{{item._summary}}">{{item._summary}}</text>
          </view>
        </view>
        <view wx:if="{{displayMixedResults.length < mixedResults.length}}" class="load-more-domain" bindtap="onLoadMoreMixed">
          <text wx:if="{{loadingMoreMixed}}">加载中...</text>
          <text wx:else>加载更多 ({{mixedResults.length - displayMixedResults.length}})</text>
        </view>
      </view>
      <view
        wx:if="{{totalCount === 0}}"
        class="empty-state"
      >
        <text class="empty-state__text">未找到相关内容</text>
        <text class="empty-state__desc">换个关键词试试</text>
      </view>
    </block>

    <!-- ========== 仅茶品 ========== -->
    <block wx:if="{{activeTab === 'tea'}}">
      <view wx:for="{{displayResults.tea}}" wx:key="id" class="result-item" data-id="{{item.id}}" bindtap="onTeaTap">
        <view class="result-item__cover" style="background-color:#3B6D11;">
          <text class="result-item__char">茶</text>
        </view>
        <view class="result-item__body">
          <text class="result-item__title">{{item.name}}</text>
          <text class="result-item__meta">{{item.origin}} · {{item.grade}}</text>
          <view class="result-item__tags">
            <text wx:for="{{item.styleTags}}" wx:key="*this" wx:for-item="tag" class="tag tag--sm">{{tag}}</text>
          </view>
        </view>
      </view>
      <view wx:if="{{displayResults.tea.length < results.tea.length}}" class="load-more-domain" data-domain="tea" bindtap="onLoadMoreDomain">
        <text wx:if="{{loadingMoreDomain === 'tea'}}">加载中...</text>
        <text wx:else>加载更多 ({{results.tea.length - displayResults.tea.length}})</text>
      </view>
      <view wx:if="{{results.tea.length === 0}}" class="empty-state">
        <text class="empty-state__text">未找到相关茶品</text>
        <text class="empty-state__desc">换个关键词试试</text>
        <text class="empty-state__link" data-tab="all" bindtap="onTabTap">试试搜索全部 ›</text>
      </view>
    </block>

    <!-- ========== 仅行旅 ========== -->
    <block wx:if="{{activeTab === 'travel'}}">
      <view wx:for="{{displayResults.travel}}" wx:key="id" class="result-item" data-id="{{item.id}}" bindtap="onTravelTap">
        <view class="result-item__cover" style="background-color:#5B8C85;">
          <text class="result-item__char">游</text>
        </view>
        <view class="result-item__body">
          <text class="result-item__title">{{item.title}}</text>
          <text class="result-item__meta">{{item.destination.region}} · {{item.duration}}</text>
        </view>
      </view>
      <view wx:if="{{displayResults.travel.length < results.travel.length}}" class="load-more-domain" data-domain="travel" bindtap="onLoadMoreDomain">
        <text wx:if="{{loadingMoreDomain === 'travel'}}">加载中...</text>
        <text wx:else>加载更多 ({{results.travel.length - displayResults.travel.length}})</text>
      </view>
      <view wx:if="{{results.travel.length === 0}}" class="empty-state">
        <text class="empty-state__text">未找到相关行旅</text>
        <text class="empty-state__desc">换个关键词试试</text>
        <text class="empty-state__link" data-tab="all" bindtap="onTabTap">试试搜索全部 ›</text>
      </view>
    </block>

    <!-- ========== 仅养生 ========== -->
    <block wx:if="{{activeTab === 'wellness'}}">
      <view wx:for="{{displayResults.wellness}}" wx:key="id" class="result-item" data-id="{{item.id}}" bindtap="onWellnessTap">
        <view class="result-item__cover" style="background-color:#A0522D;">
          <text class="result-item__char">养</text>
        </view>
        <view class="result-item__body">
          <text class="result-item__title">{{item.title}}</text>
          <text class="result-item__meta">{{item.duration}} · 难度{{item.difficulty}}/5</text>
        </view>
      </view>
      <view wx:if="{{displayResults.wellness.length < results.wellness.length}}" class="load-more-domain" data-domain="wellness" bindtap="onLoadMoreDomain">
        <text wx:if="{{loadingMoreDomain === 'wellness'}}">加载中...</text>
        <text wx:else>加载更多 ({{results.wellness.length - displayResults.wellness.length}})</text>
      </view>
      <view wx:if="{{results.wellness.length === 0}}" class="empty-state">
        <text class="empty-state__text">未找到相关养生内容</text>
        <text class="empty-state__desc">换个关键词试试</text>
        <text class="empty-state__link" data-tab="all" bindtap="onTabTap">试试搜索全部 ›</text>
      </view>
    </block>

    <!-- ========== 仅香道 ========== -->
    <block wx:if="{{activeTab === 'incense'}}">
      <view wx:for="{{displayResults.incense}}" wx:key="id" class="result-item" data-id="{{item.id}}" bindtap="onIncenseTap">
        <view class="result-item__cover" style="background-color:#8B6F47;">
          <text class="result-item__char">香</text>
        </view>
        <view class="result-item__body">
          <text class="result-item__title">{{item.title}}</text>
          <text class="result-item__meta">{{item.origin}} · {{item.price}}</text>
        </view>
      </view>
      <view wx:if="{{displayResults.incense.length < results.incense.length}}" class="load-more-domain" data-domain="incense" bindtap="onLoadMoreDomain">
        <text wx:if="{{loadingMoreDomain === 'incense'}}">加载中...</text>
        <text wx:else>加载更多 ({{results.incense.length - displayResults.incense.length}})</text>
      </view>
      <view wx:if="{{results.incense.length === 0}}" class="empty-state">
        <text class="empty-state__text">未找到相关香道内容</text>
        <text class="empty-state__desc">换个关键词试试</text>
        <text class="empty-state__link" data-tab="all" bindtap="onTabTap">试试搜索全部 ›</text>
      </view>
    </block>

    <!-- ========== 仅音乐 ========== -->
    <block wx:if="{{activeTab === 'music'}}">
      <view wx:for="{{displayResults.music}}" wx:key="id" class="result-item" data-id="{{item.id}}" bindtap="onMusicTap">
        <view class="result-item__cover" style="background-color:#4A6B7C;">
          <text class="result-item__char">音</text>
        </view>
        <view class="result-item__body">
          <text class="result-item__title">{{item.title}}</text>
          <text class="result-item__meta">{{item.instrument}} · {{item.dynasty}}</text>
        </view>
      </view>
      <view wx:if="{{displayResults.music.length < results.music.length}}" class="load-more-domain" data-domain="music" bindtap="onLoadMoreDomain">
        <text wx:if="{{loadingMoreDomain === 'music'}}">加载中...</text>
        <text wx:else>加载更多 ({{results.music.length - displayResults.music.length}})</text>
      </view>
      <view wx:if="{{results.music.length === 0}}" class="empty-state">
        <text class="empty-state__text">未找到相关音乐内容</text>
        <text class="empty-state__desc">换个关键词试试</text>
        <text class="empty-state__link" data-tab="all" bindtap="onTabTap">试试搜索全部 ›</text>
      </view>
    </block>

    <!-- ========== 仅电影 ========== -->
    <block wx:if="{{activeTab === 'film'}}">
      <view wx:for="{{displayResults.film}}" wx:key="id" class="result-item" data-id="{{item.id}}" bindtap="onFilmTap">
        <view class="result-item__cover" style="background-color:#2C2C2A;">
          <text class="result-item__char">影</text>
        </view>
        <view class="result-item__body">
          <text class="result-item__title">{{item.title}}</text>
          <text class="result-item__meta">{{item.director}} · {{item.year}}</text>
        </view>
      </view>
      <view wx:if="{{displayResults.film.length < results.film.length}}" class="load-more-domain" data-domain="film" bindtap="onLoadMoreDomain">
        <text wx:if="{{loadingMoreDomain === 'film'}}">加载中...</text>
        <text wx:else>加载更多 ({{results.film.length - displayResults.film.length}})</text>
      </view>
      <view wx:if="{{results.film.length === 0}}" class="empty-state">
        <text class="empty-state__text">未找到相关电影内容</text>
        <text class="empty-state__desc">换个关键词试试</text>
        <text class="empty-state__link" data-tab="all" bindtap="onTabTap">试试搜索全部 ›</text>
      </view>
    </block>
  </block>
</view>
