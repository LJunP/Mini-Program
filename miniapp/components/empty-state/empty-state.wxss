/* components/empty-state/empty-state.wxss */

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 32rpx;
}

.empty-state__icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.empty-state__icon-text {
  font-size: 64rpx;
}

.empty-state__title {
  font-size: 32rpx;
  font-weight: 500;
  color: #2C2C2A;
  margin-bottom: 16rpx;
  text-align: center;
}

.empty-state__desc {
  font-size: 26rpx;
  color: #8B8578;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 32rpx;
  max-width: 500rpx;
}

.empty-state__action {
  height: 80rpx;
  padding: 0 48rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #FFFFFF;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.empty-state__action::after {
  border: none;
}