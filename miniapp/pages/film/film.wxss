/* pages/film/film.wxss */
.page-bg {
  min-height: 100vh;
  background: var(--bg-primary, #FAF8F3);
  padding-bottom: 40rpx;
}

.page-header {
  padding: 40rpx 32rpx 24rpx;
}

.page-header__title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-primary, #2C2C2A);
  line-height: 1.2;
}

.page-header__sub {
  display: block;
  font-size: 24rpx;
  color: var(--text-tertiary, #B8B4AC);
  margin-top: 8rpx;
}

/* 分类 tabs */
.tabs {
  display: flex;
  padding: 0 32rpx 24rpx;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.tabs::-webkit-scrollbar {
  display: none;
}

.tabs__item {
  flex-shrink: 0;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  background: var(--bg-card, #FFFFFF);
  font-size: 26rpx;
  color: var(--text-secondary, #6B6860);
  transition: all 0.2s;
}

.tabs__item--active {
  background: var(--color-film, #2C2C2A);
  color: #FFFFFF;
}

/* 内容列表 */
.film-list {
  padding: 0 32rpx;
}

/* 电影状态操作栏 */
.film-item {
  margin-bottom: 24rpx;
}
.film-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background-color: #FFFFFFFC;
  border: 0.5px solid #EAE5DC;
  border-top: none;
  border-radius: 0 0 12px 12px;
  margin-top: -12rpx;
}
.film-actions__status {
  display: flex;
  gap: 12rpx;
}
.film-tag {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  background-color: #F3EFE6;
  font-size: 22rpx;
  color: #8B8578;
}
.film-tag--watched {
  background-color: #E8F0D8;
  color: #3B6D11;
}
.film-tag--want {
  background-color: #FFF3E0;
  color: #A0522D;
}
.film-actions__rating {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.stars {
  display: flex;
  gap: 4rpx;
}
.star {
  font-size: 28rpx;
  color: #D4CFC4;
}
.star--active {
  color: #F5A623;
}
.film-actions__rate-text {
  font-size: 22rpx;
  color: #F5A623;
  font-weight: 500;
}
.film-actions__rate-text--hint {
  color: #B5B0A6;
  font-weight: 400;
}

/* 评分弹窗 */
.rating-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}
.rating-panel {
  width: 600rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx;
}
.rating-panel__header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 32rpx;
}
.rating-panel__cover {
  width: 96rpx;
  height: 128rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}
.rating-panel__header-text {
  flex: 1;
  min-width: 0;
}
.rating-panel__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2C2C2A;
  display: block;
}
.rating-panel__film-name {
  font-size: 24rpx;
  color: #8B8578;
  margin-top: 8rpx;
  display: block;
}
.rating-panel__stars {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.rating-star {
  font-size: 64rpx;
  color: #D4CFC4;
  transition: color 0.2s;
}
.rating-star--active {
  color: #F5A623;
}
.rating-panel__labels {
  text-align: center;
  height: 36rpx;
  margin-bottom: 32rpx;
}
.rating-label {
  font-size: 28rpx;
  color: #F5A623;
  font-weight: 500;
}
.rating-panel__btns {
  display: flex;
  gap: 24rpx;
}
.rating-panel__btn {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
}
.rating-panel__btn--cancel {
  background-color: #F3EFE6;
  color: #8B8578;
}
.rating-panel__btn--confirm {
  background-color: #2C2C2A;
  color: #FFFFFF;
}
