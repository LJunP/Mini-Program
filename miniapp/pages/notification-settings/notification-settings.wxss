/* pages/notification-settings/notification-settings.wxss */

.page-bg {
  min-height: 100vh;
  background-color: #FAF8F3;
  padding: 0 0 120rpx;
}

.settings-section {
  background-color: #FFFFFFFC;
  border: 0.5px solid #EAE5DC;
  border-radius: 12px;
  margin: 24rpx;
  overflow: hidden;
}

.settings-header {
  padding: 32rpx 24rpx 24rpx;
  border-bottom: 0.5px solid #EAE5DC;
}

.settings-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2C2C2A;
  display: block;
  margin-bottom: 8rpx;
}

.settings-desc {
  font-size: 24rpx;
  color: #8B8578;
  display: block;
}

.settings-item {
  display: flex;
  align-items: center;
  padding: 32rpx 24rpx;
  border-bottom: 0.5px solid #EAE5DC;
}

.settings-item:last-child {
  border-bottom: none;
}

.settings-item__info {
  flex: 1;
}

.settings-item__name {
  font-size: 28rpx;
  color: #2C2C2A;
  display: block;
  margin-bottom: 8rpx;
}

.settings-item__desc {
  font-size: 24rpx;
  color: #8B8578;
  display: block;
}

.settings-item__right {
  display: flex;
  align-items: center;
}

.settings-item__count {
  font-size: 24rpx;
  color: #3B6D11;
  background-color: #F0F7E6;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  margin-right: 16rpx;
}

.settings-item__arrow {
  font-size: 32rpx;
  color: #B5B0A6;
}

.settings-item__picker {
  display: flex;
  align-items: center;
}

.settings-item__value {
  font-size: 28rpx;
  color: #2C2C2A;
  margin-right: 16rpx;
}

.settings-footer {
  padding: 24rpx 32rpx;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #FAF8F3;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.settings-tip {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  background-color: #F0F7E6;
  border-radius: 12px;
  border: 0.5px solid #D5E8C5;
}

.settings-tip__icon {
  font-size: 28rpx;
  margin-right: 16rpx;
  margin-top: 4rpx;
}

.settings-tip__text {
  font-size: 24rpx;
  color: #5A554C;
  line-height: 1.6;
  flex: 1;
  display: block;
}

.settings-tip__body {
  flex: 1;
}

.settings-tip__hint {
  font-size: 22rpx;
  color: #8B8578;
  line-height: 1.5;
  margin-top: 4rpx;
  display: block;
}

.settings-header__row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.settings-preview-tag {
  font-size: 20rpx;
  color: #4A6B7C;
  background-color: rgba(74, 107, 124, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 4px;
}

.settings-item__badge {
  display: inline-block;
  font-size: 18rpx;
  color: #A0522D;
  background-color: rgba(160, 82, 45, 0.1);
  padding: 2rpx 10rpx;
  border-radius: 4px;
  margin-left: 8rpx;
  vertical-align: middle;
}