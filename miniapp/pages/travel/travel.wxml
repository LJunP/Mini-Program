<!-- pages/travel/travel.wxml -->
<view class="page-bg">
  <view class="page-header">
    <view class="page-header__row">
      <view class="page-header__titles">
        <text class="page-header__title">行旅</text>
        <text class="page-header__sub">把五雅装进旅程 · 慢节奏人文行</text>
      </view>
      <view class="page-header__search" bindtap="goSearch">
        <text class="page-header__search-icon">⌕</text>
      </view>
    </view>
  </view>

  <!-- 主题筛选条 -->
  <scroll-view class="theme-bar" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view class="theme-bar__inner">
      <view
        wx:for="{{themes}}"
        wx:key="id"
        class="theme-chip {{activeTheme === item.id ? 'theme-chip--active' : ''}}"
        data-theme="{{item.id}}"
        bindtap="onThemeTap"
      >
        <text class="theme-chip__icon">{{item.icon}}</text>
        <text class="theme-chip__name">{{item.name}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 高级筛选入口 -->
  <view class="filter-bar">
    <view class="filter-bar__btn {{showFilters ? 'filter-bar__btn--active' : ''}}" bindtap="onToggleFilters">
      <text>筛选{{(activeRegion !== 'all') + (activeSeason !== 'all') + (activeDuration !== 'all') > 0 ? '(' + ((activeRegion !== 'all') + (activeSeason !== 'all') + (activeDuration !== 'all')) + ')' : ''}}</text>
      <text class="filter-bar__icon">{{showFilters ? '▲' : '▼'}}</text>
    </view>
    <view class="filter-bar__tags">
      <text class="filter-tag" wx:if="{{activeRegion !== 'all'}}">{{regions[activeRegionIndex].name}}</text>
      <text class="filter-tag" wx:if="{{activeSeason !== 'all'}}">{{activeSeason}}</text>
      <text class="filter-tag" wx:if="{{activeDuration !== 'all'}}">{{activeDuration}}</text>
      <text class="filter-tag filter-tag--reset" wx:if="{{activeRegion !== 'all' || activeSeason !== 'all' || activeDuration !== 'all'}}" bindtap="onResetFilters">重置</text>
    </view>
  </view>

  <!-- 高级筛选面板 -->
  <view class="filter-panel {{showFilters ? 'filter-panel--show' : ''}}">
    <view class="filter-group">
      <text class="filter-group__title">地区</text>
      <view class="filter-group__options">
        <view
          wx:for="{{regions}}"
          wx:key="key"
          class="filter-option {{activeRegion === item.key ? 'filter-option--active' : ''}}"
          data-key="{{item.key}}"
          bindtap="onRegionTap"
        >
          <text>{{item.name}}</text>
        </view>
      </view>
    </view>
    <view class="filter-group">
      <text class="filter-group__title">季节</text>
      <view class="filter-group__options">
        <view
          wx:for="{{seasons}}"
          wx:key="key"
          class="filter-option {{activeSeason === item.key ? 'filter-option--active' : ''}}"
          data-key="{{item.key}}"
          bindtap="onSeasonTap"
        >
          <text>{{item.name}}</text>
        </view>
      </view>
    </view>
    <view class="filter-group">
      <text class="filter-group__title">天数</text>
      <view class="filter-group__options">
        <view
          wx:for="{{durations}}"
          wx:key="key"
          class="filter-option {{activeDuration === item.key ? 'filter-option--active' : ''}}"
          data-key="{{item.key}}"
          bindtap="onDurationTap"
        >
          <text>{{item.name}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载骨架屏 -->
  <view wx:if="{{loading}}" class="skeleton-list">
    <view wx:for="{{[1,2,3]}}" wx:key="*this" class="skeleton-item">
      <view class="skeleton-item__cover skeleton-pulse"></view>
      <view class="skeleton-item__body">
        <view class="skeleton-item__title skeleton-pulse"></view>
        <view class="skeleton-item__meta skeleton-pulse"></view>
      </view>
    </view>
  </view>

  <!-- 行旅专题列表 -->
  <view class="travel-list" wx:if="{{!loading && filteredList.length}}">
    <view
      wx:for="{{filteredList}}"
      wx:key="id"
      class="travel-card"
      data-id="{{item.id}}"
      bindtap="onTravelTap"
    >
      <!-- 封面 -->
      <view class="travel-card__cover" style="background-color:{{coverColor}};">
        <image wx:if="{{item.coverImage}}" src="{{item.coverImage}}" mode="aspectFill" lazy-load="{{true}}" class="travel-card__img" />
        <view wx:else class="travel-card__placeholder">
          <text class="travel-card__dest">{{item.destination.name}}</text>
        </view>
        <view class="travel-card__duration">{{item.duration}}</view>
      </view>

      <!-- 内容 -->
      <view class="travel-card__body">
        <text class="travel-card__title">{{item.title}}</text>
        <view class="travel-card__meta">
          <text class="travel-card__region">{{item.destination.region}}</text>
          <text class="travel-card__pace">慢行</text>
        </view>
        <text class="travel-card__essay ellipsis-2">{{item.essay}}</text>

        <!-- 串联板块标签 -->
        <view class="travel-card__domains">
          <domain-tag
            wx:for="{{item.involvedDomains}}"
            wx:key="*this"
            wx:for-item="d"
            domain="{{d}}"
            size="small"
          />
        </view>
      </view>
    </view>
  </view>

  <empty-state wx:if="{{!loading && !filteredList.length}}" text="该筛选条件下暂无行旅内容" desc="试试调整筛选条件" />
</view>
