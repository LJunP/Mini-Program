/* components/audio-player/audio-player.wxss */
.audio-player {
  background-color: #FFFFFFFC;
  border: 0.5px solid #EAE5DC;
  border-radius: 12px;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.audio-player__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.audio-player__title {
  font-size: 28rpx;
  font-weight: 500;
  color: #2C2C2A;
}

.audio-player__duration {
  font-size: 24rpx;
  color: #8B8578;
}

.audio-player__controls {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.audio-player__btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #4A6B7C;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.audio-player__icon {
  font-size: 32rpx;
  color: #FFFFFF;
}

.audio-player__nav-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: #8B8578;
}

.audio-player__progress {
  flex: 1;
}

.audio-player__progress-bar {
  height: 8rpx;
  background-color: #EAE5DC;
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.audio-player__progress-fill {
  height: 100%;
  background-color: #4A6B7C;
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.audio-player__time {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #8B8578;
}

.audio-player__volume {
  display: flex;
  align-items: center;
}

.audio-player__volume-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
}

.audio-player__volume-slider {
  flex: 1;
  margin: 0;
}

/* 无音频占位样式 */
.audio-player--empty {
  display: flex;
  align-items: center;
  padding: 32rpx 24rpx;
}

.audio-player__empty-icon {
  font-size: 48rpx;
  margin-right: 24rpx;
  opacity: 0.5;
}

.audio-player__empty-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.audio-player__empty-title {
  font-size: 28rpx;
  color: #8B8578;
  font-weight: 500;
}

.audio-player__empty-desc {
  font-size: 22rpx;
  color: #B5B0A6;
}
