/* subpackages/detail/tea-detail/tea-detail.wxss */
.page-bg {
  padding-bottom: 0;
}

/* 主图 */
.hero {
  padding: 64rpx 32rpx 48rpx;
  text-align: center;
  background-color: #7B9E5C;
}
.hero__name {
  font-size: 56rpx;
  font-weight: 500;
  color: #FFFFFF;
  letter-spacing: 8rpx;
}
.hero__meta {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}
.hero__dot {
  margin: 0 12rpx;
}
.hero__rating {
  margin-top: 24rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
}
.hero__score {
  font-size: 40rpx;
  color: #FFFFFF;
  font-weight: 500;
  margin-right: 12rpx;
}
.hero__rating-count {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 简介卡 */
.section-title-inline {
  font-size: 28rpx;
  font-weight: 500;
  color: #2C2C2A;
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
}
.intro {
  font-size: 28rpx;
  color: #5A554C;
  line-height: 1.8;
  display: block;
}
.intro__tags {
  margin-top: 16rpx;
}

/* 雷达图卡 */
.radar-card {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.radar-card__legend {
  font-size: 22rpx;
  color: #8B8578;
  margin-top: 16rpx;
}

/* 冲泡指南 */
.brew {
  padding: 24rpx;
}
.brew__row {
  display: flex;
  justify-content: space-between;
}
.brew__item {
  flex: 1;
  text-align: center;
}
.brew__label {
  font-size: 22rpx;
  color: #8B8578;
  display: block;
}
.brew__value {
  font-size: 32rpx;
  color: #3B6D11;
  font-weight: 500;
  margin-top: 8rpx;
  display: block;
}
.brew__tip {
  margin-top: 24rpx;
  padding-top: 16rpx;
  border-top: 0.5px solid #EAE5DC;
  text-align: center;
  font-size: 22rpx;
  color: #8B8578;
}

/* 适饮场景 */
.scenes {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.scenes__item {
  background-color: #FFFFFFFC;
  border: 0.5px solid #EAE5DC;
  border-radius: 20px;
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  color: #5A554C;
}

/* 点评 */
.reviews {
  margin-bottom: 24rpx;
}
.review-card {
  background-color: #FFFFFFFC;
  border: 0.5px solid #EAE5DC;
  border-radius: 12px;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.review-card:last-child {
  margin-bottom: 0;
}
.review-card__header {
  display: flex;
  align-items: center;
}
.review-card__avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: #3B6D11;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.review-card__info {
  flex: 1;
  min-width: 0;
}
.review-card__user {
  font-size: 26rpx;
  color: #2C2C2A;
  font-weight: 500;
  display: block;
}
.review-card__date {
  font-size: 22rpx;
  color: #8B8578;
  display: block;
  margin-top: 4rpx;
}
.review-card__rating {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 16rpx;
}

.review-card__stars {
  font-size: 20rpx;
  color: #FFD700;
  letter-spacing: 2rpx;
}

.review-card__rating-num {
  font-size: 28rpx;
  font-weight: 500;
  color: #3B6D11;
  margin-top: 4rpx;
}
.review-card__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 16rpx 0 12rpx;
}
.review-card__tag {
  font-size: 22rpx;
  color: #3B6D11;
  background-color: #F0F5EB;
  border-radius: 20rpx;
  padding: 6rpx 20rpx;
}
.review-card__body {
  font-size: 26rpx;
  color: #5A554C;
  line-height: 1.7;
  display: block;
}

/* 关联内容 */
.related {
  background-color: #FFFFFFFC;
  border: 0.5px solid #EAE5DC;
  border-radius: 12px;
  overflow: hidden;
  margin-bottom: 24rpx;
}
.related__item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 0.5px solid #EAE5DC;
}
.related__item:last-child {
  border-bottom: none;
}
.related__cover {
  width: 96rpx;
  height: 96rpx;
  border-radius: 8px;
  margin-right: 24rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.related__cover-text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 500;
}
.related__body {
  flex: 1;
  min-width: 0;
}
.related__title {
  font-size: 28rpx;
  color: #2C2C2A;
  line-height: 1.5;
  display: block;
}
.related__context {
  font-size: 22rpx;
  color: #8B8578;
  margin-top: 8rpx;
  display: block;
}

/* 底部操作栏 */
.bottom-placeholder {
  height: 120rpx;
}
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  padding: 16rpx 24rpx;
  background-color: #FFFFFFFC;
  border-top: 0.5px solid #EAE5DC;
  z-index: 10;
}
.action-bar__review,
.action-bar__poster,
.action-bar__collect,
.action-bar__share {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  border-radius: 40px;
  margin: 0 4rpx;
  letter-spacing: 2rpx;
}
.action-bar__review {
  background-color: #F0F5EB;
  color: #3B6D11;
}
.action-bar__poster {
  background-color: #F3EFE6;
  color: #8B6F47;
}
.action-bar__collect {
  background-color: #F3EFE6;
  color: #5A554C;
}
.action-bar__collect--active {
  background-color: #3B6D11;
  color: #FFFFFF;
}
.action-bar__share {
  background-color: #3B6D11;
  color: #FFFFFF;
  /* reset button default */
  padding: 0;
  border: none;
  line-height: 80rpx;
}
.action-bar__share::after {
  border: none;
}

.loading {
  padding: 200rpx 0;
  text-align: center;
  color: #8B8578;
  font-size: 28rpx;
}

/* 简介统计 */
.intro__stats {
  display: flex;
  gap: 32rpx;
  margin-top: 24rpx;
  padding-top: 16rpx;
  border-top: 0.5px solid #EAE5DC;
}
.intro__stat {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.intro__stat-icon {
  font-size: 28rpx;
  color: #8B8578;
}
.intro__stat-icon--liked {
  color: #E74C3C;
}
.intro__stat-text {
  font-size: 24rpx;
  color: #8B8578;
}

/* 点评操作 */
.review-card__actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 0.5px solid #EAE5DC;
  gap: 24rpx;
}
.review-card__action {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #8B8578;
  padding: 8rpx 16rpx;
}

.review-card__action-icon {
  font-size: 24rpx;
}

.review-card__action-icon--liked {
  color: #E74C3C;
}

.review-card__action-text {
  font-size: 22rpx;
}

/* 回复列表 */
.review-card__replies {
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 0.5px solid #EAE5DC;
}

.reply-item {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  margin-bottom: 12rpx;
  font-size: 24rpx;
}

.reply-item:last-child {
  margin-bottom: 0;
}

.reply-item__user {
  color: #3B6D11;
  font-weight: 500;
  margin-right: 8rpx;
}

.reply-item__content {
  color: #5A554C;
  flex: 1;
}

.reply-item__date {
  color: #B0A99A;
  font-size: 20rpx;
  margin-left: 16rpx;
}

/* 相关推荐 */
.recommended {
  background-color: #FFFFFFFC;
  border: 0.5px solid #EAE5DC;
  border-radius: 12px;
  overflow: hidden;
  margin-bottom: 24rpx;
}
.recommended__item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 0.5px solid #EAE5DC;
}
.recommended__item:last-child {
  border-bottom: none;
}
.recommended__cover {
  width: 96rpx;
  height: 96rpx;
  border-radius: 8px;
  margin-right: 24rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.recommended__cover-text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 500;
}
.recommended__body {
  flex: 1;
  min-width: 0;
}
.recommended__name {
  font-size: 28rpx;
  color: #2C2C2A;
  font-weight: 500;
  display: block;
}
.recommended__meta {
  font-size: 22rpx;
  color: #8B8578;
  margin-top: 8rpx;
  display: block;
}
.recommended__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}
.tag--sm {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  background: #F1EFE8;
  color: #5F5E5A;
}

/* 评论输入框 */
.comment-input {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}
.comment-input--show {
  transform: translateY(0);
}
.comment-input__mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}
.comment-input__body {
  position: relative;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #FFFFFF;
  border-top: 0.5px solid #EAE5DC;
}
.comment-input__input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: #F1EFE8;
  border-radius: 36rpx;
  font-size: 28rpx;
}
.comment-input__btn {
  margin-left: 16rpx;
  padding: 12rpx 24rpx;
  background: #3B6D11;
  color: #FFFFFF;
  border-radius: 36rpx;
  font-size: 28rpx;
}

/* 点评统计 */
.review-stats {
  background-color: #FFFFFFFC;
  border: 0.5px solid #EAE5DC;
  border-radius: 12px;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.review-stats__overview {
  display: flex;
  gap: 32rpx;
}

.review-stats__average {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 120rpx;
}

.review-stats__average-num {
  font-size: 48rpx;
  font-weight: 500;
  color: #3B6D11;
}

.review-stats__average-label {
  font-size: 22rpx;
  color: #8B8578;
  margin-top: 8rpx;
}

.review-stats__distribution {
  flex: 1;
}

.review-stats__bar {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.review-stats__bar:last-child {
  margin-bottom: 0;
}

.review-stats__star {
  font-size: 22rpx;
  color: #5A554C;
  width: 60rpx;
  text-align: right;
  margin-right: 12rpx;
}

.review-stats__bar-bg {
  flex: 1;
  height: 16rpx;
  background-color: #F3EFE6;
  border-radius: 8rpx;
  overflow: hidden;
}

.review-stats__bar-fill {
  height: 100%;
  background-color: #3B6D11;
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.review-stats__bar-count {
  font-size: 22rpx;
  color: #8B8578;
  width: 60rpx;
  text-align: left;
  margin-left: 12rpx;
}

.review-stats__count {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 0.5px solid #EAE5DC;
  font-size: 24rpx;
  color: #8B8578;
  text-align: center;
}

/* ========= 冲泡计时按钮 ========= */
.brew__start-btn {
  margin-top: 20rpx;
  padding: 20rpx 0;
  text-align: center;
  background: linear-gradient(135deg, #3B6D11, #5A8F2E);
  border-radius: 12px;
  font-size: 28rpx;
  color: #FFFFFF;
  letter-spacing: 4rpx;
  box-shadow: 0 4rpx 12rpx rgba(59, 109, 17, 0.3);
}

/* ========= 冲泡计时器浮层 ========= */
.brew-timer {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 200;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}
.brew-timer--show {
  opacity: 1;
  pointer-events: auto;
}
.brew-timer__mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
}
.brew-timer__panel {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  background: #FFFFFFFC;
  border-radius: 24px;
  padding: 40rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
}

/* 头部 */
.brew-timer__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}
.brew-timer__tea-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #2C2C2A;
  letter-spacing: 4rpx;
}
.brew-timer__close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #8B8578;
  background: #F3EFE6;
  border-radius: 50%;
}

/* 泡数指示器 */
.brew-timer__steeps {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.brew-timer__steep-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  background: #F3EFE6;
  color: #B0A99A;
  transition: all 0.3s ease;
}
.brew-timer__steep-dot--done {
  background: #3B6D11;
  color: #FFFFFF;
}
.brew-timer__steep-dot--active {
  background: #E8F0DC;
  color: #3B6D11;
  font-weight: 500;
  box-shadow: 0 0 0 4rpx rgba(59, 109, 17, 0.2);
}
.brew-timer__steep-label {
  text-align: center;
  font-size: 24rpx;
  color: #8B8578;
  margin-bottom: 40rpx;
}

/* 计时器主体 */
.brew-timer__circle {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}
.brew-timer__time-display {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}
.brew-timer__time {
  font-size: 96rpx;
  font-weight: 200;
  color: #3B6D11;
  font-variant-numeric: tabular-nums;
  letter-spacing: 4rpx;
}
.brew-timer__status {
  font-size: 24rpx;
  color: #8B8578;
  margin-top: 8rpx;
}
.brew-timer__progress-bar {
  width: 100%;
  height: 12rpx;
  background: #F3EFE6;
  border-radius: 6rpx;
  overflow: hidden;
}
.brew-timer__progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #3B6D11, #7B9E5C);
  border-radius: 6rpx;
  transition: width 0.5s ease;
}

/* 冲泡信息 */
.brew-timer__info {
  display: flex;
  justify-content: space-around;
  padding: 24rpx 0;
  border-top: 0.5px solid #EAE5DC;
  border-bottom: 0.5px solid #EAE5DC;
  margin-bottom: 32rpx;
}
.brew-timer__info-item {
  text-align: center;
}
.brew-timer__info-label {
  font-size: 22rpx;
  color: #8B8578;
  display: block;
}
.brew-timer__info-value {
  font-size: 28rpx;
  color: #5A554C;
  font-weight: 500;
  margin-top: 8rpx;
  display: block;
}

/* 操作按钮 */
.brew-timer__actions {
  display: flex;
  gap: 16rpx;
}
.brew-timer__btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  font-size: 28rpx;
  letter-spacing: 4rpx;
  transition: all 0.2s ease;
}
.brew-timer__btn--start {
  background: linear-gradient(135deg, #3B6D11, #5A8F2E);
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(59, 109, 17, 0.3);
}
.brew-timer__btn--pause {
  background: #F0F5EB;
  color: #3B6D11;
}
.brew-timer__btn--next {
  background: linear-gradient(135deg, #3B6D11, #5A8F2E);
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(59, 109, 17, 0.3);
}
.brew-timer__btn--reset {
  background: #F3EFE6;
  color: #5A554C;
}
.brew-timer__btn:active {
  transform: scale(0.96);
}

/* 冲泡计时器最小化浮动按钮 */
.brew-minimized {
  position: fixed;
  bottom: 120rpx;
  right: 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: linear-gradient(135deg, #3B6D11, #5A8F2E);
  border-radius: 999rpx;
  box-shadow: 0 8rpx 24rpx rgba(59, 109, 17, 0.35);
  z-index: 100;
  opacity: 0;
  transform: translateY(40rpx);
  pointer-events: none;
  transition: all 0.3s ease;
}
.brew-minimized--show {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}
.brew-minimized__icon {
  font-size: 32rpx;
  color: #FFFFFF;
}
.brew-minimized__info {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.brew-minimized__label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.2;
}
.brew-minimized__time {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
  line-height: 1.2;
}

/* ========= 笔记功能 ========= */
.note-section {
  margin-bottom: 24rpx;
}
.note-card {
  background: #FFFFFFFC;
  border: 0.5px solid #EAE5DC;
  border-left: 4rpx solid #3B6D11;
  border-radius: 12px;
  padding: 24rpx;
}
.note-card__content {
  display: block;
  font-size: 28rpx;
  color: #2C2C2A;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
}
.note-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 0.5px solid #F4F0E8;
}
.note-card__time {
  font-size: 22rpx;
  color: #B0A99A;
}
.note-card__actions {
  display: flex;
  gap: 16rpx;
}
.note-card__btn {
  font-size: 24rpx;
  color: #3B6D11;
  padding: 4rpx 16rpx;
  border-radius: 4rpx;
  background: rgba(59, 109, 17, 0.08);
}
.note-card__btn--delete {
  color: #A0522D;
  background: rgba(160, 82, 45, 0.08);
}
.note-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 96rpx;
  border: 1px dashed #D5D0C5;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.5);
}
.note-empty__icon {
  font-size: 28rpx;
  color: #B0A99A;
}
.note-empty__text {
  font-size: 26rpx;
  color: #8B8578;
}

/* 笔记编辑弹层 */
.note-input {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 300;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}
.note-input--show {
  opacity: 1;
  pointer-events: auto;
}
.note-input__mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}
.note-input__panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-radius: 24px 24px 0 0;
  padding: 32rpx;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}
.note-input__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.note-input__title {
  font-size: 32rpx;
  font-weight: 500;
  color: #2C2C2A;
  letter-spacing: 4rpx;
}
.note-input__close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #8B8578;
  background: #F3EFE6;
  border-radius: 50%;
}
.note-input__textarea {
  width: 100%;
  min-height: 240rpx;
  max-height: 400rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: #2C2C2A;
  background: #F8F6F2;
  border-radius: 12px;
  padding: 24rpx;
  box-sizing: border-box;
}
.note-input__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}
.note-input__count {
  font-size: 22rpx;
  color: #B0A99A;
}
.note-input__save {
  padding: 16rpx 48rpx;
  background: #3B6D11;
  color: #FFFFFF;
  border-radius: 999rpx;
  font-size: 28rpx;
  letter-spacing: 4rpx;
}
.note-input__save:active {
  transform: scale(0.96);
}
