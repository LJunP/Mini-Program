/* pages/tea/tea.wxss */
.page-header {
  padding: 32rpx 16rpx 24rpx;
}
.page-header__title {
  font-size: 44rpx;
  font-weight: 500;
  color: #2C2C2A;
  letter-spacing: 8rpx;
}
.page-header__sub {
  display: block;
  font-size: 24rpx;
  color: #8B8578;
  margin-top: 8rpx;
  letter-spacing: 4rpx;
}
.page-header__row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}
.page-header__search {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #FFFFFFFC;
  border: 0.5px solid #EAE5DC;
  border-radius: 50%;
  margin-left: 24rpx;
  flex-shrink: 0;
  margin-top: 8rpx;
}
.page-header__search-icon {
  font-size: 36rpx;
  color: #8B8578;
}

/* 内嵌搜索框 */
.search-bar {
  display: flex;
  align-items: center;
  margin: 16rpx 0 24rpx;
  gap: 16rpx;
}
.search-bar__input {
  flex: 1;
  height: 72rpx;
  background-color: #FFFFFFFC;
  border: 0.5px solid #EAE5DC;
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
  color: #2C2C2A;
}
.search-bar__cancel {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #3B6D11;
  flex-shrink: 0;
}

/* 搜索结果 */
.search-results {
  background-color: #FFFFFFFC;
  border: 0.5px solid #EAE5DC;
  border-radius: 12px;
  overflow: hidden;
  margin-bottom: 24rpx;
}
.search-results__item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 0.5px solid #EAE5DC;
}
.search-results__item:last-child {
  border-bottom: none;
}
.search-results__name {
  font-size: 28rpx;
  color: #2C2C2A;
  font-weight: 500;
}
.search-results__meta {
  font-size: 22rpx;
  color: #8B8578;
}
.search-results__empty {
  padding: 48rpx 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #8B8578;
}

/* 排序栏 */
.sort-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.sort-bar__tabs {
  display: flex;
  gap: 24rpx;
}
.sort-bar__item {
  font-size: 24rpx;
  color: #8B8578;
  padding: 8rpx 0;
  position: relative;
}
.sort-bar__item--active {
  color: #3B6D11;
  font-weight: 500;
}
.sort-bar__compare {
  font-size: 24rpx;
  color: #8B8578;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  background: #F3EFE6;
}
.sort-bar__compare--active {
  color: #FFFFFF;
  background: #3B6D11;
}
.sort-bar__item--active::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 24rpx;
  height: 3rpx;
  background-color: #3B6D11;
  border-radius: 2rpx;
}

/* 横向 tab */
.tabs {
  white-space: nowrap;
  padding: 16rpx 0 24rpx;
  border-bottom: 0.5px solid #EAE5DC;
}
.tabs__item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 32rpx;
  margin-right: 8rpx;
  position: relative;
}
.tabs__name {
  font-size: 28rpx;
  color: #8B8578;
  letter-spacing: 4rpx;
}
.tabs__count {
  font-size: 20rpx;
  color: #B5B0A6;
  margin-top: 4rpx;
}
.tabs__item--active .tabs__name {
  color: #3B6D11;
  font-weight: 500;
}
.tabs__item--active .tabs__count {
  color: #3B6D11;
}
.tabs__item--active::after {
  content: "";
  position: absolute;
  bottom: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 32rpx;
  height: 4rpx;
  background-color: #3B6D11;
  border-radius: 2px;
}

.tea-list {
  padding-top: 16rpx;
  padding-bottom: 120rpx; /* 为对比浮层留空间 */
}

/* 对比模式选中态 */
.tea-card--selected {
  border: 2px solid #3B6D11 !important;
  box-shadow: 0 0 0 4rpx rgba(59, 109, 17, 0.15);
}

/* 对比浮层 */
.compare-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background-color: #FFFFFFFC;
  border-top: 0.5px solid #EAE5DC;
  z-index: 10;
}
.compare-bar__info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.compare-bar__text {
  font-size: 28rpx;
  color: #3B6D11;
  font-weight: 500;
}
.compare-bar__hint {
  font-size: 22rpx;
  color: #8B8578;
}
.compare-bar__actions {
  display: flex;
  gap: 16rpx;
}
.compare-bar__cancel {
  padding: 12rpx 32rpx;
  background-color: #F3EFE6;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #5A554C;
}
.compare-bar__start {
  padding: 12rpx 32rpx;
  background-color: #E0DACE;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #B5B0A6;
  transition: all 0.2s ease;
}
.compare-bar__start--active {
  background: linear-gradient(135deg, #3B6D11, #5A8F2E);
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(59, 109, 17, 0.3);
}

/* 加载更多 */
.load-more {
  padding: 32rpx 0 48rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}
.load-more__loading {
  display: flex;
  gap: 12rpx;
}
.load-more__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #B5B0A6;
  animation: dot-bounce 1.2s ease-in-out infinite;
}
.load-more__dot:nth-child(2) { animation-delay: 0.2s; }
.load-more__dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes dot-bounce {
  0%, 80%, 100% { opacity: 0.3; }
  40% { opacity: 1; }
}
.load-more__end {
  font-size: 24rpx;
  color: #B5B0A6;
  letter-spacing: 4rpx;
}
