<view class="page-bg" wx:if="{{detail}}">
  <view class="hero">
    <view class="hero__tag">{{detail.type}}</view>
    <view class="hero__title">{{detail.title}}</view>
    <view class="hero__meta">
      <text>{{detail.track}}</text>
      <text class="hero__dot">·</text>
      <text>{{detail.topic}}</text>
      <text class="hero__dot">·</text>
      <text>难度 {{detail.difficulty}}</text>
      <text class="hero__dot">·</text>
      <text>高频 {{detail.frequency}}</text>
    </view>
    <view class="hero__progress" wx:if="{{progress}}">
      当前状态：{{progress.status}}
      <text wx:if="{{progress.reviewCount}}"> · 复习 {{progress.reviewCount}} 次</text>
      <text wx:if="{{progress.wrongCount}}"> · 错题 {{progress.wrongCount}} 次</text>
    </view>
  </view>

  <view class="section-title">学习状态</view>
  <view class="card progress-card">
    <view class="status-actions">
      <view
        wx:for="{{statusOptions}}"
        wx:key="key"
        class="status-action {{progress.status === item.key ? 'status-action--active' : ''}}"
        data-status="{{item.key}}"
        bindtap="onStatusTap"
      >{{item.label}}</view>
    </view>
    <view class="wrong-action" bindtap="onWrongTap">标记错题 / 加入薄弱点</view>
  </view>

  <view class="section-title">题目</view>
  <view class="card question-card">
    <text class="question-text">{{detail.question}}</text>
  </view>

  <view class="answer-toggle" bindtap="onToggleAnswer">
    <text>{{showAnswer ? '收起答案' : '查看答案'}}</text>
  </view>

  <block wx:if="{{showAnswer}}">
    <view class="section-title">一句话答案</view>
    <view class="card">
      <text class="short-answer">{{detail.answer.short}}</text>
    </view>

    <block wx:if="{{detail.answer.thinkingProcess}}">
      <view class="section-title">思考联想与推导过程</view>
      <view class="card thinking-process-card">
        <text class="thinking-process">{{detail.answer.thinkingProcess}}</text>
      </view>
    </block>

    <view class="section-title">结构化要点</view>
    <view class="card">
      <view class="answer-step" wx:for="{{detail.answer.structured}}" wx:key="*this">
        <view class="answer-step__index">{{index + 1}}</view>
        <text class="answer-step__text">{{item}}</text>
      </view>
    </view>

    <view class="section-title">深入解释</view>
    <view class="card">
      <text class="deep-dive">{{detail.answer.deepDive}}</text>
    </view>

    <!-- 复制答案按钮 -->
    <view class="copy-btn" bindtap="onCopyAnswer">
      <text>📋 复制完整答案</text>
    </view>
  </block>

  <view class="section-title">得分关键点</view>
  <view class="card">
    <text class="key-point" wx:for="{{detail.keyPoints}}" wx:key="*this">{{item}}</text>
  </view>

  <view class="section-title" wx:if="{{detail.traps && detail.traps.length}}">易错点</view>
  <view class="card traps" wx:if="{{detail.traps && detail.traps.length}}">
    <view class="trap" wx:for="{{detail.traps}}" wx:key="*this">
      <view class="trap__dot"></view>
      <text class="trap__text">{{item}}</text>
    </view>
  </view>

  <view class="bottom-placeholder"></view>

  <!-- TTS 朗读状态条 -->
  <view class="reading-bar" wx:if="{{isReading}}">
    <view class="reading-bar__pulse {{isTTSLoading ? 'reading-bar__pulse--loading' : ''}}"></view>
    <text class="reading-bar__text">{{isTTSLoading ? '正在合成语音…' : '正在朗读：' + currentSection}}</text>
    <view class="reading-bar__stop" bindtap="onToggleRead">停止</view>
  </view>

  <view class="action-bar safe-bottom">
    <view class="action-bar__collect {{isCollected ? 'action-bar__collect--active' : ''}}" bindtap="onToggleCollect">
      <text>{{isCollected ? '已收藏' : '收藏'}}</text>
    </view>
    <view class="action-bar__copy" bindtap="onCopyQuestion">
      <text>复制</text>
    </view>
    <view wx:if="{{ttsAvailable}}" class="action-bar__read {{isReading ? 'action-bar__read--active' : ''}}" bindtap="onToggleRead">
      <text>{{isReading ? '停止' : '朗读'}}</text>
    </view>
    <view class="action-bar__poster" bindtap="onGeneratePoster">
      <text>海报</text>
    </view>
    <button class="action-bar__share" open-type="share">分享</button>
  </view>

  <!-- 隐藏的海报 Canvas -->
  <canvas type="2d" id="posterCanvas" class="poster-canvas"></canvas>
</view>

<view wx:else class="loading">载入中...</view>