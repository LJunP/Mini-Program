<!-- pages/history/history.wxml -->
<view class="page-bg">
  <view class="history-header">
    <view class="history-stats">
      <text class="history-stats__count">{{totalCount}}</text>
      <text class="history-stats__label">条浏览记录</text>
    </view>
    <view class="history-actions">
      <button class="history-action-btn" bindtap="onClearAll" disabled="{{totalCount === 0}}">清空所有</button>
    </view>
  </view>
  
  <view class="history-list" wx:if="{{historyList.length}}">
    <view 
      wx:for="{{historyList}}" 
      wx:key="key" 
      class="history-item"
    >
      <view class="history-item__content" data-domain="{{item.domain}}" data-id="{{item.refId}}" bindtap="onItemTap">
        <view class="history-item__info">
          <view class="history-item__header">
            <domain-tag domain="{{item.domain}}" size="small" />
            <text class="history-item__name">{{item.name}}</text>
          </view>
          <text class="history-item__date">{{item.date}}</text>
        </view>
        <view class="history-item__action" data-index="{{index}}" data-key="{{item.key}}" catchtap="onDeleteItem">
          <text class="history-item__delete">×</text>
        </view>
      </view>
    </view>
  </view>
  
  <view class="history-empty" wx:else>
    <empty-state 
      icon="📚"
      title="暂无浏览记录"
      description="您还没有浏览过任何内容，快去探索吧"
      actionText="去首页看看"
      bind:action="onGoHome"
    />
  </view>
  
  <view class="history-footer" wx:if="{{historyList.length}}">
    <view class="history-tip">
      <text class="history-tip__icon">💡</text>
      <text class="history-tip__text">仅显示最近100条记录，更早的记录会被自动清理</text>
    </view>
  </view>
</view>