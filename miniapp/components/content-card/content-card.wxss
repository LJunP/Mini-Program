/* components/content-card/content-card.wxss */
.cc {
  background-color: #FFFFFFFC;
  border: 0.5px solid #EAE5DC;
  border-radius: 12px;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-sizing: border-box;
  transition: opacity 0.2s ease;
}
.cc--viewed {
  opacity: 0.85;
}

.cc__cover {
  width: 100%;
  height: 280rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}
.cc__img {
  width: 100%;
  height: 100%;
}
.cc__cover-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.cc__pattern {
  font-size: 72rpx;
  color: rgba(255, 255, 255, 0.12);
  font-weight: 300;
  line-height: 1;
  margin-bottom: 8rpx;
}
.cc__cover-text {
  font-size: 36rpx;
  color: #FFFFFF;
  font-weight: 500;
  letter-spacing: 8rpx;
  opacity: 0.7;
}
.cc__viewed-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: rgba(0, 0, 0, 0.45);
  border-radius: 8px;
  padding: 4rpx 16rpx;
}
.cc__viewed-badge text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.85);
}

.cc__body {
  padding: 24rpx;
}
.cc__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.cc__extra {
  font-size: 22rpx;
  color: #8B8578;
}
.cc__title {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: #2C2C2A;
  line-height: 1.5;
  margin-bottom: 12rpx;
}
.cc__summary {
  display: block;
  font-size: 26rpx;
  color: #8B8578;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.cc__footer {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #B5B0A6;
}
