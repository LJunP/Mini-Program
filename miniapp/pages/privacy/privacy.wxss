/* pages/privacy/privacy.wxss */
.page-bg {
  min-height: 100vh;
  background-color: #FAF8F3;
  padding: 20rpx;
}

.container {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 40rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #2C2C2A;
  text-align: center;
  margin-bottom: 20rpx;
}

.update-date {
  font-size: 24rpx;
  color: #8B8578;
  text-align: center;
  margin-bottom: 40rpx;
}

.section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #3B6D11;
  margin-bottom: 20rpx;
}

.section-content {
  font-size: 28rpx;
  color: #2C2C2A;
  line-height: 1.8;
}

.item {
  margin-bottom: 16rpx;
  padding-left: 20rpx;
}

.contact {
  margin-top: 16rpx;
  padding-left: 20rpx;
  color: #3B6D11;
}