<view class="page-bg">
  <view class="page-header">
    <text class="page-header__title">教程</text>
    <text class="page-header__sub">从上手到精通 · 实战经验库</text>
  </view>

  <view class="tabs">
    <view
      wx:for="{{categories}}"
      wx:key="key"
      class="tabs__item {{currentCategory === item.key ? 'tabs__item--active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onCategoryTap"
    >
      <text>{{item.name}}</text>
    </view>
  </view>

  <view class="study-list" wx:if="{{list.length}}">
    <view class="study-card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="onItemTap">
      <view class="study-card__header">
        <text class="study-card__tag">教程</text>
        <text class="study-card__meta">{{item.duration}} 分钟 · 难度 {{item.difficulty}}</text>
      </view>
      <text class="study-card__title">{{item.title}}</text>
      <text class="study-card__summary ellipsis-2">{{item.summary}}</text>
      <view class="study-card__tags">
        <text class="tag" wx:for="{{item.tags}}" wx:key="*this">{{item}}</text>
      </view>
    </view>
  </view>

  <empty-state wx:else text="暂无教程" desc="后续会继续补充" />
</view>