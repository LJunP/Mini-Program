<!-- pages/contribute/list.wxml -->
<view class="page-bg list-page">

  <!-- 顶部 Tab：我的 / 社区 -->
  <view class="top-tabs">
    <view class="top-tab {{activeTab === 'my' ? 'top-tab--active' : ''}}" data-tab="my" bindtap="onTabTap">
      <text>我的投稿</text>
    </view>
    <view class="top-tab {{activeTab === 'community' ? 'top-tab--active' : ''}}" data-tab="community" bindtap="onTabTap">
      <text>风雅社区</text>
    </view>
  </view>

  <!-- 统计概览（仅「我的」显示） -->
  <view class="stats-bar" wx:if="{{activeTab === 'my'}}">
    <view class="stats-bar__item">
      <text class="stats-bar__num">{{stats.total}}</text>
      <text class="stats-bar__label">总投稿</text>
    </view>
    <view class="stats-bar__divider"></view>
    <view class="stats-bar__item">
      <text class="stats-bar__num">{{stats.byDomain.tea || 0}}</text>
      <text class="stats-bar__label">茶评</text>
    </view>
    <view class="stats-bar__divider"></view>
    <view class="stats-bar__item">
      <text class="stats-bar__num">{{stats.byDomain.travel || 0}}</text>
      <text class="stats-bar__label">游记</text>
    </view>
    <view class="stats-bar__divider"></view>
    <view class="stats-bar__item">
      <text class="stats-bar__num">{{stats.byDomain.wellness || 0}}</text>
      <text class="stats-bar__label">养生</text>
    </view>
  </view>

  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-bar__input-wrap">
      <text class="search-bar__icon">⌕</text>
      <input class="search-bar__input" placeholder="搜索投稿..." value="{{searchKeyword}}" bindinput="onSearchInput" />
      <view class="search-bar__clear" wx:if="{{searchKeyword}}" bindtap="onSearchClear">✕</view>
    </view>
  </view>

  <!-- 领域筛选 -->
  <scroll-view class="filter-bar" scroll-x="{{true}}" show-scrollbar="{{false}}">
    <view
      wx:for="{{domainOptions}}"
      wx:key="key"
      class="filter-chip {{activeDomain === item.key ? 'filter-chip--active' : ''}}"
      data-domain="{{item.key}}"
      bindtap="onFilterTap"
    >
      <text>{{item.name}}</text>
      <text class="filter-chip__count" wx:if="{{item.key === 'all'}}">{{stats.total}}</text>
      <text class="filter-chip__count" wx:else>{{stats.byDomain[item.key] || 0}}</text>
    </view>
  </scroll-view>

  <!-- 投稿列表 -->
  <view class="post-list" wx:if="{{filteredPosts.length > 0}}">
    <view
      wx:for="{{filteredPosts}}"
      wx:key="id"
      class="post-card"
      data-id="{{item.id}}"
      bindtap="onPostTap"
    >
      <!-- 图片预览 -->
      <view class="post-card__images" wx:if="{{item.images.length > 0}}">
        <image
          src="{{item.images[0]}}"
          mode="aspectFill"
          class="post-card__cover"
        />
        <view class="post-card__image-count" wx:if="{{item.images.length > 1}}">
          <text>{{item.images.length}}图</text>
        </view>
      </view>

      <!-- 内容区 -->
      <view class="post-card__body">
        <view class="post-card__header">
          <domain-tag domain="{{item.domain}}" size="small" />
          <text class="post-card__status post-card__status--{{item.status}}" wx:if="{{activeTab === 'my' && item.statusText}}">{{item.statusText}}</text>
          <text class="post-card__author" wx:if="{{item.isMock || (activeTab === 'community' && !item.isMine)}}">@{{item.authorName}}</text>
          <text class="post-card__date">{{item.dateText}}</text>
        </view>

        <text class="post-card__title">{{item.title}}</text>
        <text class="post-card__content" wx:if="{{item.content}}">{{item.contentPreview}}</text>

        <!-- 评分 -->
        <view class="post-card__rating" wx:if="{{item.rating > 0}}">
          <text class="post-card__stars">{{item.starsText}}</text>
        </view>

        <!-- 标签 -->
        <view class="post-card__tags" wx:if="{{item.tags.length > 0}}">
          <text
            wx:for="{{item.tags}}"
            wx:for-item="tag"
            wx:key="*this"
            class="post-card__tag"
          >{{tag}}</text>
        </view>

        <!-- 地点 -->
        <view class="post-card__location" wx:if="{{item.location}}">
          <text class="post-card__location-icon">📍</text>
          <text class="post-card__location-text">{{item.location}}</text>
        </view>

        <!-- 关联内容 -->
        <view class="post-card__linked" wx:if="{{item.linkedContent}}">
          <text class="post-card__linked-icon">🔗</text>
          <text class="post-card__linked-text">{{item.linkedContent.title || item.linkedContent.refTitle}}</text>
        </view>

        <!-- 点赞数（社区） -->
        <view class="post-card__like" wx:if="{{activeTab === 'community' && item.likeCount > 0}}">
          <text>❤ {{item.likeCount}}</text>
        </view>
      </view>

        <!-- 操作区（仅自己的投稿） -->
      <view class="post-card__actions" wx:if="{{!item.isMock && activeTab === 'my'}}">
        <view class="post-card__action" data-id="{{item.id}}" catchtap="onEditPost">
          <text>编辑</text>
        </view>
        <view class="post-card__action-divider"></view>
        <view class="post-card__action post-card__action--delete" data-id="{{item.id}}" data-index="{{index}}" catchtap="onDeletePost">
          <text>删除</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-wrap" wx:if="{{isEmpty && !communityLoading}}">
    <empty-state
      icon="✍️"
      iconBgColor="rgba(59, 109, 17, 0.08)"
      iconColor="#3B6D11"
      title="{{activeTab === 'my' ? '还没有投稿' : '社区暂无内容'}}"
      description="{{activeTab === 'my' ? '记录你的风雅感悟，留下生活的痕迹' : '成为第一个分享风雅感悟的人'}}"
      actionText="{{activeTab === 'my' ? '写第一篇投稿' : ''}}"
      actionColor="#3B6D11"
      bind:action="onCreatePost"
    />
  </view>

  <!-- 底部新建按钮 -->
  <view class="fab-btn" wx:if="{{!isEmpty}}" bindtap="onCreatePost">
    <text class="fab-btn__icon">+</text>
  </view>

</view>
