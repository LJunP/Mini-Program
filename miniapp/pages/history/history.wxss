/* pages/history/history.wxss */

.page-bg {
  min-height: 100vh;
  background-color: #FAF8F3;
  padding: 0 0 120rpx;
}

.history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 24rpx;
  background-color: #FFFFFFFC;
  border-bottom: 0.5px solid #EAE5DC;
}

.history-stats {
  display: flex;
  align-items: baseline;
}

.history-stats__count {
  font-size: 48rpx;
  font-weight: 500;
  color: #3B6D11;
  margin-right: 12rpx;
}

.history-stats__label {
  font-size: 28rpx;
  color: #8B8578;
}

.history-actions {
  display: flex;
  gap: 16rpx;
}

.history-action-btn {
  padding: 16rpx 24rpx;
  background-color: #EAE5DC;
  color: #8B8578;
  font-size: 26rpx;
  border-radius: 24rpx;
  border: none;
  line-height: 1.4;
}

.history-action-btn::after {
  border: none;
}

.history-action-btn[disabled] {
  opacity: 0.5;
}

.history-list {
  padding: 24rpx;
}

.history-item {
  background-color: #FFFFFFFC;
  border: 0.5px solid #EAE5DC;
  border-radius: 12px;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.history-item__content {
  display: flex;
  align-items: center;
  padding: 24rpx;
}

.history-item__info {
  flex: 1;
}

.history-item__header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.history-item__name {
  flex: 1;
  font-size: 28rpx;
  color: #2C2C2A;
  margin-left: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-item__date {
  font-size: 24rpx;
  color: #B5B0A6;
}

.history-item__action {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
}

.history-item__delete {
  font-size: 36rpx;
  color: #B5B0A6;
  line-height: 1;
}

.history-empty {
  padding: 80rpx 32rpx;
}

.history-footer {
  padding: 24rpx 32rpx;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #FAF8F3;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.history-tip {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  background-color: #F0F7E6;
  border-radius: 12px;
  border: 0.5px solid #D5E8C5;
}

.history-tip__icon {
  font-size: 28rpx;
  margin-right: 16rpx;
  margin-top: 4rpx;
}

.history-tip__text {
  font-size: 24rpx;
  color: #5A554C;
  line-height: 1.6;
  flex: 1;
}