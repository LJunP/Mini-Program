<!-- subpackages/tools/pages/dnf-summer-2026/calculator.wxml -->
<view class="calc-page">
  <view class="notice-bar">
    <view class="notice-bar__item notice-bar__item--warn">⚠ 甜蜜果饮券如果选择自抽则0回血（自抽与卖券互斥）</view>
    <view class="notice-bar__item notice-bar__item--info">ℹ 每个产物的价格有波动不稳定，需要用户自己填写</view>
  </view>

  <view class="header-card">
    <view class="header-card__title">{{packageName}}</view>
    <view class="header-card__sub">精打细算 · 回血为王 · DNF 2026夏日礼包真实回血口径计算器</view>
    <view class="header-card__price">
      <text class="header-card__price-num">{{normalPrice}}</text>
      <text class="header-card__price-unit">点券/普通礼包</text>
    </view>
    <view class="header-card__round">{{multiBuySetsPerRound}}套/轮</view>
  </view>

  <view class="section">
    <view class="section__header" data-section="basic" bindtap="toggleSection">
      <text class="section__title">购买数量与优惠券</text>
      <text class="section__arrow {{expandedSections.basic ? 'section__arrow--open' : ''}}">▼</text>
    </view>
    <block wx:if="{{expandedSections.basic}}">
      <view class="section__body">
        <view class="field__hint field__hint--warn">9折券可用于首套（需拥有≥1张）；7折券是买一套后才送的，不可用于首套。</view>
        <view class="field">
          <view class="field__label">礼包数量</view>
          <view class="field__input-wrap">
            <input class="field__input" type="number" value="{{normalPackageCount}}" bindinput="onNormalPackageCountChange" placeholder="0" />
            <text class="field__unit">套</text>
          </view>
          <view class="field__hint">礼包价格：{{normalPrice}}点券/套；固定可交易产物按礼包数量计算。</view>
        </view>
        <view class="field">
          <view class="field__label">7折券数量</view>
          <view class="field__input-wrap">
            <input class="field__input" type="number" value="{{sevenFoldCount}}" bindinput="onSevenFoldCountChange" placeholder="0" />
            <text class="field__unit">张</text>
          </view>
          <view class="field__hint">买1套时不能使用7折券；买2套及以上才可用于后续礼包。</view>
        </view>
        <view class="field">
          <view class="field__label">9折券数量</view>
          <view class="field__input-wrap">
            <input class="field__input" type="number" value="{{nineFoldCount}}" bindinput="onNineFoldCountChange" placeholder="0" />
            <text class="field__unit">张</text>
          </view>
          <view class="field__hint">9折券可用于首套（如果拥有）。</view>
        </view>
      </view>
    </block>
  </view>

  <view class="section">
    <view class="section__header" data-section="fees" bindtap="toggleSection">
      <text class="section__title">拍卖行与寄售手续费</text>
      <text class="section__arrow {{expandedSections.fees ? 'section__arrow--open' : ''}}">▼</text>
    </view>
    <block wx:if="{{expandedSections.fees}}">
      <view class="section__body">
        <view class="field field--row">
          <view class="field__label">拥有拍卖行优惠券</view>
          <switch checked="{{hasAuctionCoupon}}" bindchange="onAuctionCouponToggle" color="#1a1a2e" />
        </view>
        <view class="field__hint field__hint--warn">无券：物品拍卖实收95%，金币寄售实收95%；有券：物品拍卖实收97%，金币寄售实收99%（手续费3%+1%）。</view>
        <view class="field">
          <view class="field__label">无券物品实收率</view>
          <view class="field__input-wrap">
            <input class="field__input" type="digit" value="{{itemReceiveRateWithoutCoupon}}" data-key="itemReceiveRateWithoutCoupon" bindinput="onReceiveRateChange" placeholder="95" />
            <text class="field__unit">%</text>
          </view>
        </view>
        <view class="field">
          <view class="field__label">有券物品实收率</view>
          <view class="field__input-wrap">
            <input class="field__input" type="digit" value="{{itemReceiveRateWithCoupon}}" data-key="itemReceiveRateWithCoupon" bindinput="onReceiveRateChange" placeholder="97" />
            <text class="field__unit">%</text>
          </view>
        </view>
        <view class="field">
          <view class="field__label">无券金币寄售实收率</view>
          <view class="field__input-wrap">
            <input class="field__input" type="digit" value="{{goldReceiveRateWithoutCoupon}}" data-key="goldReceiveRateWithoutCoupon" bindinput="onReceiveRateChange" placeholder="95" />
            <text class="field__unit">%</text>
          </view>
        </view>
        <view class="field">
          <view class="field__label">有券金币寄售实收率</view>
          <view class="field__input-wrap">
            <input class="field__input" type="digit" value="{{goldReceiveRateWithCoupon}}" data-key="goldReceiveRateWithCoupon" bindinput="onReceiveRateChange" placeholder="99" />
            <text class="field__unit">%</text>
          </view>
        </view>
      </view>
    </block>
  </view>

  <view class="section">
    <view class="section__header" data-section="fixed" bindtap="toggleSection">
      <text class="section__title">普通礼包固定可交易产物</text>
      <text class="section__arrow {{expandedSections.fixed ? 'section__arrow--open' : ''}}">▼</text>
    </view>
    <block wx:if="{{expandedSections.fixed}}">
      <view class="section__body">
        <view class="field__hint">MD确认：单套普通礼包含1个收集箱宝珠、2张甜蜜果饮券。价格纯手动输入。</view>
        <view class="item-card" wx:for="{{fixedTradableItems}}" wx:key="id" data-index="{{index}}">
          <view class="item-card__header">
            <view class="item-card__name-row">
              <switch checked="{{item.selected}}" data-index="{{index}}" bindchange="onFixedItemToggle" color="#1a1a2e" />
              <text class="item-card__name">{{item.name}}</text>
            </view>
            <text class="item-card__per">×{{item.perNormalPackage}}/普通礼包</text>
          </view>
          <view class="item-card__body" wx:if="{{item.selected}}">
            <view class="item-card__price-row">
              <text class="item-card__price-label">市场价</text>
              <view class="item-card__price-input">
                <input class="field__input field__input--small" type="digit" value="{{item.price}}" data-index="{{index}}" bindinput="onFixedItemPriceChange" placeholder="0" />
                <text class="field__unit">万金币</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </block>
  </view>

  <view class="section">
    <view class="section__header" data-section="multibuy" bindtap="toggleSection">
      <text class="section__title">多买多送抽奖回血</text>
      <text class="section__arrow {{expandedSections.multibuy ? 'section__arrow--open' : ''}}">▼</text>
    </view>
    <block wx:if="{{expandedSections.multibuy}}">
      <view class="section__body">
        <view class="mode-tabs">
          <view class="mode-tab {{multiBuyMode === 'round' ? 'mode-tab--active' : ''}}" data-mode="round" bindtap="onMultiBuyModeChange">
            <text class="mode-tab__name">满8套整轮</text>
            <text class="mode-tab__desc">按一轮全奖池</text>
          </view>
          <view class="mode-tab {{multiBuyMode === 'manual' ? 'mode-tab--active' : ''}}" data-mode="manual" bindtap="onMultiBuyModeChange">
            <text class="mode-tab__name">手动结果</text>
            <text class="mode-tab__desc">按实际获得</text>
          </view>
        </view>
        <view class="field__hint field__hint--warn">整轮模式只按普通礼包每8套一轮计算，不足8套不自动计入一轮奖励。</view>
        <view class="item-card" wx:for="{{multiBuyMode === 'round' ? multiBuyRoundItems : multiBuyManualItems}}" wx:key="id" data-index="{{index}}">
          <view class="item-card__header">
            <view class="item-card__name-row">
              <switch checked="{{item.selected}}" data-group="{{multiBuyMode === 'round' ? 'multiBuyRoundItems' : 'multiBuyManualItems'}}" data-index="{{index}}" bindchange="onManualItemToggle" color="#1a1a2e" />
              <text class="item-card__name">{{item.name}}</text>
            </view>
            <text class="item-card__per" wx:if="{{multiBuyMode === 'round'}}">×{{item.roundQuantity}}/轮</text>
          </view>
          <view class="item-card__body" wx:if="{{item.selected}}">
            <view class="item-card__price-row" wx:if="{{multiBuyMode === 'manual'}}">
              <text class="item-card__price-label">数量</text>
              <view class="item-card__price-input">
                <input class="field__input field__input--small" type="digit" value="{{item.quantity}}" data-group="multiBuyManualItems" data-index="{{index}}" bindinput="onManualItemQuantityChange" placeholder="0" />
              </view>
            </view>
            <view class="item-card__price-row">
              <text class="item-card__price-label">市场价</text>
              <view class="item-card__price-input">
                <input class="field__input field__input--small" type="digit" value="{{item.price}}" data-group="{{multiBuyMode === 'round' ? 'multiBuyRoundItems' : 'multiBuyManualItems'}}" data-index="{{index}}" bindinput="onManualItemPriceChange" placeholder="0" />
                <text class="field__unit">万金币</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </block>
  </view>

  <view class="section">
    <view class="section__header" data-section="coin" bindtap="toggleSection">
      <text class="section__title">硬币商店（全账号绑定）</text>
      <text class="section__arrow {{expandedSections.coin ? 'section__arrow--open' : ''}}">▼</text>
    </view>
    <block wx:if="{{expandedSections.coin}}">
      <view class="section__body">
        <view class="field__hint field__hint--warn">文档第10节确认：礼包硬币商店所有道具均为账号绑定，无可交易道具，不产生回血。以下为参考列表。</view>
        <view class="item-card" wx:for="{{coinExchangeItems}}" wx:key="id">
          <view class="item-card__header">
            <view class="item-card__name-row">
              <text class="item-card__name">{{item.name}}</text>
            </view>
            <text class="item-card__per">需{{item.coinCost}}硬币</text>
          </view>
        </view>
      </view>
    </block>
  </view>

  <view class="section">
    <view class="section__header" data-section="sweet" bindtap="toggleSection">
      <text class="section__title">甜蜜果饮券自抽参考（概率获得）</text>
      <text class="section__arrow {{expandedSections.sweet ? 'section__arrow--open' : ''}}">▼</text>
    </view>
    <block wx:if="{{expandedSections.sweet}}">
      <view class="section__body">
        <view class="field__hint field__hint--warn">文档第7.2节：使用甜蜜果饮赏味券抽奖可概率获得以下可交易道具（与卖券互斥）。不计入回血，如自抽获得可手动填入下方“其他手动可交易项”。</view>
        <view class="item-card" wx:for="{{sweetTicketLotteryItems}}" wx:key="id">
          <view class="item-card__header">
            <view class="item-card__name-row">
              <text class="item-card__name">{{item.name}}</text>
            </view>
            <text class="item-card__per">概率 {{item.probability}}</text>
          </view>
        </view>
      </view>
    </block>
  </view>

  <view class="section">
    <view class="section__header" data-section="extra" bindtap="toggleSection">
      <text class="section__title">其他手动可交易项</text>
      <text class="section__arrow {{expandedSections.extra ? 'section__arrow--open' : ''}}">▼</text>
    </view>
    <block wx:if="{{expandedSections.extra}}">
      <view class="section__body">
        <view class="field__hint">用于填写派对邀请函兑换、甜蜜点数兑换产物，或自抽获得的可交易道具。前两项为确定可获得，后三项为自定义空白栏。</view>
        <view class="item-card" wx:for="{{extraManualItems}}" wx:key="id" data-index="{{index}}">
          <view class="item-card__header">
            <view class="item-card__name-row">
              <switch checked="{{item.selected}}" data-group="extraManualItems" data-index="{{index}}" bindchange="onManualItemToggle" color="#1a1a2e" />
              <text class="item-card__name">{{item.name}}</text>
            </view>
            <text class="item-card__source" wx:if="{{item.source}}">{{item.source}}</text>
          </view>
          <view class="item-card__body" wx:if="{{item.selected}}">
            <view class="item-card__price-row">
              <text class="item-card__price-label">数量</text>
              <view class="item-card__price-input">
                <input class="field__input field__input--small" type="digit" value="{{item.quantity}}" data-group="extraManualItems" data-index="{{index}}" bindinput="onManualItemQuantityChange" placeholder="0" />
              </view>
            </view>
            <view class="item-card__price-row">
              <text class="item-card__price-label">市场价</text>
              <view class="item-card__price-input">
                <input class="field__input field__input--small" type="digit" value="{{item.price}}" data-group="extraManualItems" data-index="{{index}}" bindinput="onManualItemPriceChange" placeholder="0" />
                <text class="field__unit">万金币</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </block>
  </view>

  <view class="section">
    <view class="section__header" data-section="consignment" bindtap="toggleSection">
      <text class="section__title">金币寄售换算</text>
      <text class="section__arrow {{expandedSections.consignment ? 'section__arrow--open' : ''}}">▼</text>
    </view>
    <block wx:if="{{expandedSections.consignment}}">
      <view class="section__body">
        <view class="field__hint">每个档位的代币券价格随市场波动，请根据游戏内寄售行实时行情填写。系统按档位从大到小贪心拆分金币。</view>
        <view class="field">
          <view class="field__label">已有金币</view>
          <view class="field__input-wrap">
            <input class="field__input" type="digit" value="{{ownGold}}" bindinput="onOwnGoldChange" placeholder="0" />
            <text class="field__unit">万金币</text>
          </view>
        </view>
        <view class="consign-tiers">
          <view class="consign-tier" wx:for="{{consignmentTiers}}" wx:key="name" data-index="{{index}}">
            <text class="consign-tier__name">{{item.name}}（{{item.amountWan}}万）</text>
            <view class="consign-tier__input">
              <input class="field__input field__input--small" type="digit" value="{{item.token}}" data-index="{{index}}" bindinput="onConsignmentTierTokenChange" placeholder="0" />
              <text class="field__unit">代币券/档</text>
            </view>
          </view>
        </view>
      </view>
    </block>
  </view>

  <view class="action-bar">
    <button class="btn btn--primary" bindtap="calculate">计算回血</button>
    <button class="btn btn--secondary" bindtap="resetCalc">重置</button>
  </view>

  <block wx:if="{{showResult && result}}">
    <view class="result-section">
      <view class="result-card result-card--main">
        <view class="result-card__title">回血计算结果</view>
        <view class="result-grid">
          <view class="result-grid__item"><text class="result-grid__label">总花费</text><text class="result-grid__value">{{result.totalCost}}</text><text class="result-grid__unit">点券</text></view>
          <view class="result-grid__item result-grid__item--highlight"><text class="result-grid__label">回血代币券</text><text class="result-grid__value">{{result.recoveryToken}}</text><text class="result-grid__unit">代币券</text></view>
          <view class="result-grid__item"><text class="result-grid__label">实际花费</text><text class="result-grid__value">{{result.actualCost}}</text><text class="result-grid__unit">点券</text></view>
          <view class="result-grid__item result-grid__item--rate"><text class="result-grid__label">回血率</text><text class="result-grid__value">{{result.recoveryRate}}</text><text class="result-grid__unit">%</text></view>
        </view>
        <button class="share-result-btn" bindtap="onShareResult">分享回血结果</button>
      </view>

      <view class="result-card"><view class="result-card__title">花费明细</view><view class="detail-row" wx:for="{{result.costDetails}}" wx:key="label"><view class="detail-row__info"><text class="detail-row__name">{{item.label}}</text><text class="detail-row__source">×{{item.count}} × {{item.unitPrice}}点券</text></view><text class="detail-row__value">{{item.total}} 点券</text></view></view>

      <view class="result-card">
        <view class="result-card__title">回血流水</view>
        <view class="flow-step"><text class="flow-step__label">固定产物</text><text class="flow-step__value">{{result.fixedGold}} 万金币</text></view>
        <view class="flow-step"><text class="flow-step__label">多买多送</text><text class="flow-step__value">{{result.multiBuyGold}} 万金币</text></view>
        <view class="flow-step"><text class="flow-step__label">硬币商店</text><text class="flow-step__value">{{result.coinGold}} 万金币</text></view>
        <view class="flow-step"><text class="flow-step__label">其他手动项</text><text class="flow-step__value">{{result.extraGold}} 万金币</text></view>
        <view class="flow-step flow-step--total"><text class="flow-step__label">拍卖行上架前</text><text class="flow-step__value">{{result.recoveryGoldBeforeFee}} 万金币</text></view>
        <view class="flow-step"><text class="flow-step__label">物品寄售实收率（{{result.itemReceiveRate}}%）</text><text class="flow-step__value flow-step__value--negative">-{{result.itemFeeGold}} 万金币</text></view>
        <view class="flow-step"><text class="flow-step__label">物品寄售后金币</text><text class="flow-step__value">{{result.recoveryGoldAfterItemFee}} 万金币</text></view>
        <view class="flow-step"><text class="flow-step__label">已有金币</text><text class="flow-step__value">{{result.ownGold}} 万金币</text></view>
        <view class="flow-step flow-step--total"><text class="flow-step__label">参与寄售金币</text><text class="flow-step__value">{{result.totalGoldToSell}} 万金币</text></view>
        <view class="flow-step"><text class="flow-step__label">金币寄售实收率（{{result.goldReceiveRate}}%）</text><text class="flow-step__value flow-step__value--negative">-{{result.goldConsignmentFee}} 代币券</text></view>
        <view class="flow-step flow-step--total"><text class="flow-step__label">获得代币券</text><text class="flow-step__value flow-step__value--positive">{{result.recoveryToken}} 代币券</text></view>
      </view>

      <view class="result-card" wx:if="{{result.itemDetails.length > 0}}"><view class="result-card__title">道具回血明细</view><view class="detail-row" wx:for="{{result.itemDetails}}" wx:key="name"><view class="detail-row__info"><text class="detail-row__name">{{item.name}}</text><text class="detail-row__source">{{item.source}} · ×{{item.quantity}} × {{item.unitPrice}}万</text></view><text class="detail-row__value">{{item.totalGold}} 万</text></view></view>

      <view class="result-card" wx:if="{{result.consignmentBreakdown.length > 0}}"><view class="result-card__title">寄售档位明细</view><view class="breakdown-table"><view class="breakdown-row breakdown-row--header"><text class="breakdown-cell">档位</text><text class="breakdown-cell">数量</text><text class="breakdown-cell">代币/档</text><text class="breakdown-cell">手续费</text><text class="breakdown-cell">实得</text></view><view class="breakdown-row" wx:for="{{result.consignmentBreakdown}}" wx:key="tierName"><text class="breakdown-cell">{{item.tierName}}</text><text class="breakdown-cell">×{{item.count}}</text><text class="breakdown-cell">{{item.tokenPerUnit}}</text><text class="breakdown-cell breakdown-cell--neg">{{item.fee}}</text><text class="breakdown-cell breakdown-cell--pos">{{item.netToken}}</text></view></view><view class="field__hint">剩余不足100万档位金币：{{result.remainingGoldWan}} 万</view></view>

      <view class="result-card"><view class="result-card__title">账号绑定 / 无法交易产物参考</view><view class="untradable-group" wx:if="{{result.normalPackageItems.length > 0}}"><text class="untradable-group__title">礼包内容</text><view class="untradable-item" wx:for="{{result.normalPackageItems}}" wx:key="name"><text class="untradable-item__name">{{item.name}}（{{item.tradeType}}）</text><text class="untradable-item__count">×{{item.count}}</text></view></view></view>
    </view>
  </block>

  <view class="footer-note">
    <text>※ 道具价格纯手动输入，不拉取默认行情。</text>
    <text>※ 不可交易道具只展示，不计入回血。</text>
  </view>

  <!-- 探索妙不可园 -->
  <view class="explore-card" bindtap="goHome">
    <view class="explore-card__icon">
      <text class="explore-card__char">园</text>
    </view>
    <view class="explore-card__body">
      <text class="explore-card__title">妙不可园</text>
      <text class="explore-card__desc">偷得浮生半日闲，来品一杯茶，焚一炉香</text>
    </view>
    <text class="explore-card__arrow">›</text>
  </view>

  <!-- 隐藏的海报 Canvas -->
  <canvas type="2d" id="dnfPosterCanvas" class="dnf-poster-canvas"></canvas>
</view>